# https://editorconfig.org

# Tip: to find files violating the rules set out here, run `docker run --rm --volume=$PWD:/check mstruebing/editorconfig-checker`

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.yaml]
indent_size = 2


[*.yml]
indent_size = 2

# Byte-pinned or CRLF-native, as in .gitattributes: editors leave their bytes alone.
[{themes/apsconecta/core/mapa/*,sites/*.csv,provisioning/data/*.csv}]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
