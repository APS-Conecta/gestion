# Derived DEV-ONLY image: the official Nextcloud image + Xdebug for step-debugging (AD-10).
# Never used by the base compose.yaml / in production — built on demand via compose.dev.yaml
# (`make up-dev`). Adds nothing but Xdebug; entrypoint/CMD are inherited from the base image.
FROM nextcloud:34-apache

# Xdebug 3 via PECL (base is php:8.5-apache; ships pecl + docker-php-ext-enable, no xdebug).
RUN pecl install xdebug \
    && docker-php-ext-enable xdebug

# zz- prefix so this ini loads last and wins. Config lives in dev/xdebug.ini (single source).
COPY dev/xdebug.ini /usr/local/etc/php/conf.d/zz-xdebug.ini
