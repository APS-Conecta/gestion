[codespell]
# The wizard's operator language is es-CL (patch 060's bytes, committed since the hard fork) —
# these are correct Spanish words that codespell's English typo dictionary flags
# (momento→memento, comando→commando, ...). Listed here so the codespell validator stays
# green over the tree: upstream's own codespell workflow on push and PR, and
# scripts/validate.sh on the release chain's tag arm. Skip this file itself: it necessarily
# contains the flagged words as list entries.
skip = .codespellrc
ignore-words-list = accesible,administrativo,argumentos,auxiliar,avance,calle,caracteres,comando,comandos,componentes,copie,direccion,doble,dout,falso,fase,fases,funcional,hace,imposible,ine,inicial,instale,momento,noe,oficial,oriente,pares,posible,previos,proxys,reding,requiere,responde,ser,serie,termine,unparseable,utiliza,valide,varios,visibles
