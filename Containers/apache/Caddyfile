{
    admin off

    auto_https disable_redirects

    # APS (R22): start.sh writes the install's address here when it serves the installer's
    # certificate. A client reaching the suite by IP sends no SNI, and Caddy then picks a
    # certificate by the local address, which inside Docker is the container's: none matches.
    # default_sni placeholder

    storage file_system {
        root /mnt/data/caddy
    }

    servers {
        # trusted_proxies placeholder
    }

    # Plain http on purpose, so limit it to h1 to avoid caddy warning that HTTP/2 and HTTP/3 were
    # skipped. Excluding the `http` logger would also hide acme messages.
    servers :23973 {
        protocols h1
        # A scoped block overrides the address-less one above, so repeat trusted_proxies here.
        # trusted_proxies placeholder
    }

    # apache-port servers placeholder

    log {
        level {$CADDY_LOG_LEVEL}
        # Below ERROR, caddy prints 'admin endpoint disabled' on every start, which is expected
        # since we set `admin off` above.
        exclude admin
    }
}

# APS (R22): the routes live in a snippet so the internal plain-http address and the site are
# separate blocks — a site serving a file certificate cannot share a block with an http address.
(aps_routes) {
    header {
        Strict-Transport-Security max-age=31536000;

        -Server
        -X-Powered-By
        -Via
    }

    encode

    # Notify Push
    route /push/* {
        uri strip_prefix /push
        reverse_proxy {$NOTIFY_PUSH_HOST}:7867
    }

    # EuroOffice
    route /eurooffice/* {
        uri strip_prefix /eurooffice
        reverse_proxy {$EUROOFFICE_HOST}:80 {
            header_up X-Forwarded-Prefix /eurooffice
            header_up X-Forwarded-Proto https
        }
    }

    # Talk
    route /standalone-signaling/* {
        uri strip_prefix /standalone-signaling
        reverse_proxy {$TALK_HOST}:8081
    }

    # HaRP (ExApps)
    route /exapps/* {
        reverse_proxy {$HARP_HOST}:8780
    }

    # Nextcloud
    route {
        reverse_proxy 127.0.0.1:8000 {
            @failed status 500
            handle_response @failed {
                @upload {
                    method PUT MOVE
                    path /remote.php/dav/files/* /remote.php/dav/uploads/* /remote.php/webdav/*
                }
                handle @upload {
                    copy_response_headers {
                        exclude Content-Length Content-Encoding Content-Type ETag
                    }
                    header Content-Type "application/xml; charset=utf-8"
                    respond `<?xml version="1.0" encoding="utf-8"?><d:error xmlns:d="DAV:" xmlns:s="http://sabredav.org/ns"><s:message>No se pudo confirmar la carga. Revise Archivos antes de repetirla. Si el problema continúa, contacte a la administración.</s:message></d:error>` 500
                }
                handle {
                    copy_response_headers
                    copy_response
                }
            }
        }
    }
    redir /.well-known/carddav /remote.php/dav/ 301
    redir /.well-known/caldav /remote.php/dav/ 301
}

http://{$APACHE_HOST}.nextcloud-aio:23973 { # For internal suite callbacks, see containers.json
    import aps_routes
}

https://{$ADDITIONAL_TRUSTED_DOMAIN}:443,
{$PROTOCOL}://{$NC_DOMAIN}:{$APACHE_PORT} {
    import aps_routes

    # TLS options: start.sh writes the installer's certificate here when /aps-tls holds one (an
    # install by IP, R22), else upstream's ACME issuer (shortlived, no HTTP challenge: port 80 is
    # the mastercontainer's)
    # tls placeholder
}
