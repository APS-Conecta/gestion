+/* Keep the staged body within the engine budget and never scan a truncated file. */
+static int write_scan_body(av_req_data_t *data, char *buf, int len, int iseof)
+{
+     ci_off_t stored = av_body_data_size(&data->body);
+     if (data->scan_incomplete)
+         return len;
+     if (MAX_OBJECT_SIZE > 0 && len > 0 &&
+         (stored > MAX_OBJECT_SIZE || (ci_off_t)len > MAX_OBJECT_SIZE - stored)) {
+         data->scan_incomplete = 1;
+         ci_debug_printf(1, "Scan body exceeds the configured limit; refusing scan\n");
+         return len;
+     }
+     return av_body_data_write(&data->body, buf, len, iseof);
+}
