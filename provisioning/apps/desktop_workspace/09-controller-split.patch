+<?php
+namespace OCA\DesktopWorkspace\Service;
+
+use OC\DB\Exceptions\DbalException;
+use OCA\DesktopWorkspace\SettingsKeys;
+use OCP\IConfig;
+use OCP\IDBConnection;
+
+/**
+ * Taskbar/desktop app pins: validation, storage, and the one-shot legacy
+ * browser-state migration claim (L4-09 — extracted from SettingsController,
+ * behavior-preserving).
+ */
+class PinService {
+    public function __construct(
+        private IConfig $config,
+        private IDBConnection $db,
+    ) {
+    }
+
+    /** @param mixed $values decoded JSON candidate */
+    public function cleanPinList(mixed $values): ?array {
+        if (!is_array($values) || !array_is_list($values)) {
+            return null;
+        }
+        $clean = [];
+        foreach ($values as $value) {
+            if (!is_string($value) || $value === '' || strlen($value) > 255 || preg_match('/^[A-Za-z0-9_-]+$/', $value) !== 1) {
+                return null;
+            }
+            $clean[] = $value;
+        }
+        return array_slice(array_values(array_unique($clean)), 0, 100);
+    }
+
+    /** @return array{taskbar:string[],desktop:string[]} */
+    public function storedAppPins(string $uid): array {
+        $decoded = json_decode($this->config->getUserValue($uid, SettingsKeys::APP_ID, SettingsKeys::APP_PINS_KEY, ''), true);
+        $fallback = is_array($decoded) ? $decoded : [];
+        $taskbar = json_decode($this->config->getUserValue($uid, SettingsKeys::APP_ID, SettingsKeys::TASKBAR_PINS_KEY, 'null'), true);
+        $desktop = json_decode($this->config->getUserValue($uid, SettingsKeys::APP_ID, SettingsKeys::DESKTOP_PINS_KEY, 'null'), true);
+        return [
+            'taskbar' => $this->cleanPinList($taskbar) ?? $this->cleanPinList($fallback['taskbar'] ?? []) ?? [],
+            'desktop' => $this->cleanPinList($desktop) ?? $this->cleanPinList($fallback['desktop'] ?? []) ?? [],
+        ];
+    }
+
+    /**
+     * Validate and persist one pin list. Returns the cleaned list, or null when the
+     * payload is invalid (caller answers 400).
+     *
+     * @param mixed $pins decoded JSON candidate
+     */
+    public function savePins(string $uid, string $location, mixed $pins): ?array {
+        if (!in_array($location, ['taskbar', 'desktop'], true)) {
+            return null;
+        }
+        $clean = $this->cleanPinList($pins);
+        if ($clean === null || json_last_error() !== JSON_ERROR_NONE) {
+            return null;
+        }
+        $key = $location === 'taskbar' ? SettingsKeys::TASKBAR_PINS_KEY : SettingsKeys::DESKTOP_PINS_KEY;
+        $this->config->setUserValue($uid, SettingsKeys::APP_ID, $key, json_encode($clean));
+        return $clean;
+    }
+
+    /**
+     * The one-shot migration claim: insert a preferences row keyed
+     * BROWSER_STATE_MIGRATION_KEY; a duplicate key means another session claimed it
+     * first. A stale claim (>300s pending) is expired by the caller before asking.
+     */
+    public function claimBrowserStateMigration(string $uid): bool {
+        $query = $this->db->getQueryBuilder();
+        $query->insert('preferences')->values([
+            'userid' => $query->createNamedParameter($uid),
+            'appid' => $query->createNamedParameter(SettingsKeys::APP_ID),
+            'configkey' => $query->createNamedParameter(SettingsKeys::BROWSER_STATE_MIGRATION_KEY),
+            'configvalue' => $query->createNamedParameter('pending:' . time()),
+        ]);
+        try {
+            $query->executeStatement();
+            return true;
+        } catch (DbalException $e) {
+            if ((int)$e->getCode() === 1062) {
+                return false;
+            }
+            throw $e;
+        }
+    }
+}
