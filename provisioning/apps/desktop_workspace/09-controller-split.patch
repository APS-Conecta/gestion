+<?php
+namespace OCA\DesktopWorkspace\Service;
+
+use OCP\Files\Folder;
+use OCP\Files\IRootFolder;
+use OCP\Files\NotFoundException;
+
+/**
+ * The desktop-folder policy (L4-09 — extracted from SettingsController's personal
+ * writer, behavior-preserving): which user folder may serve as the desktop icons
+ * layer. Incoming shares are never valid; external-storage mounts are; group/team
+ * folders are not; the folder must be the user's own.
+ */
+class FolderPolicy {
+    public function __construct(
+        private IRootFolder $rootFolder,
+    ) {
+    }
+
+    /**
+     * @return array{ok:true,path:string}|array{ok:false,error:string,status:int}
+     *         error is the legacy machine word (not_a_folder, shared_not_allowed,
+     *         group_folder_not_allowed, not_owned, not_found); status the HTTP code.
+     */
+    public function validateDesktopFolder(string $uid, string $rawPath): array {
+        $path = trim($rawPath);
+        if ($path === '') {
+            return ['ok' => false, 'error' => 'empty', 'status' => 200];
+        }
+        try {
+            $userFolder = $this->rootFolder->getUserFolder($uid);
+            $node = $path === '/' ? $userFolder : $userFolder->get($path);
+            if (!($node instanceof Folder)) {
+                return ['ok' => false, 'error' => 'not_a_folder', 'status' => 400];
+            }
+            // Incoming shares remain invalid. External-storage mounts are valid Desktop
+            // folders, but Group folders/Team folders are not.
+            $storage = $node->getStorage();
+            if ($storage->instanceOfStorage('OCA\\Files_Sharing\\SharedStorage')) {
+                return ['ok' => false, 'error' => 'shared_not_allowed', 'status' => 400];
+            }
+            $mountType = strtolower((string)$node->getMountPoint()->getMountType());
+            $storageId = strtolower((string)$storage->getId());
+            if (str_contains($mountType, 'group') || str_contains($mountType, 'team')
+                || $storage->instanceOfStorage('OCA\\GroupFolders\\Mount\\GroupFolderStorage')
+                || str_starts_with($storageId, 'groupfolders::')) {
+                return ['ok' => false, 'error' => 'group_folder_not_allowed', 'status' => 400];
+            }
+            $owner = $node->getOwner();
+            if ($owner !== null && $owner->getUID() !== $uid) {
+                return ['ok' => false, 'error' => 'not_owned', 'status' => 400];
+            }
+            $clean = '/' . ltrim($userFolder->getRelativePath($node->getPath()) ?? '', '/');
+            return ['ok' => true, 'path' => $clean];
+        } catch (NotFoundException $e) {
+            return ['ok' => false, 'error' => 'not_found', 'status' => 404];
+        }
+    }
+}
