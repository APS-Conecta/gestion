        "TZ=%TIMEZONE%"
      ],
      "restart": "unless-stopped",
      "read_only": true,
      "cap_drop": [
        "NET_RAW"
      ]
    },
    {
      "container_name": "aps-conecta-redis",
      "image_tag": "%AIO_CHANNEL%",
      "display_name": "Redis",
      "image": "ghcr.io/aps-conecta/aio-redis",
