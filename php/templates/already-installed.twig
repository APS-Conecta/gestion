{% extends "layout.twig" %}

{% block body %}
    <div class="login">
        <svg class="nextcloud-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 142 100" width="142" height="100">
            <use href="img/nextcloud-logo.svg#logo"></use>
            <use href="img/nextcloud-logo.svg#Nextcloud"></use>
            <text x="10" y="50" fill="var(--color-nextcloud-logo)" class="fallback-text">Logotipo de APS Conecta Gestión</text>
        </svg>
        <h2>APS Conecta Gestión ya está instalado</h2>
        <p>La frase de contraseña se muestra solo una vez, en la primera visita a esta página.</p>
        <p>Si no vio una frase de contraseña en esta página durante la primera instalación, debería reinstalar toda la instancia, ya que la frase de contraseña podría haber sido robada.</p>
        <p>Vea <a target="_blank" href="https://github.com/nextcloud/all-in-one#how-to-properly-reset-the-instance">esta documentación</a> al respecto.</p>
        <a href="." class="button">Abrir APS Conecta Gestión</a>
    </div>
{% endblock %}
