{% extends "layout.twig" %}

{% block body %}
    <div class="login">
        <svg class="nextcloud-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 142 100" width="142" height="100">
            <use href="img/logo.svg#logo"></use>
            <use href="img/logo.svg#wordmark"></use>
            <text x="10" y="50" fill="var(--color-nextcloud-logo)" class="fallback-text">Logotipo de APS Conecta Gestión</text>
        </svg>
        <h1>Configuración de APS Conecta Gestión AIO</h1>
        <p>Instala y mantiene APS Conecta Gestión en este servidor: archivos, oficina y las aplicaciones APS, con respaldo diario y actualizaciones en conjunto.</p>
        <p>⚠️ <strong>Anote la frase de contraseña para acceder a la interfaz de AIO y no la pierda.</strong></p>
        <strong>Frase de contraseña</strong><br/><span id="initial-password" class="monospace">{{ password }}</span><br>
        <a href="." class="button" target="_blank">Abrir el inicio de sesión de APS Conecta Gestión AIO ↗</a>
    </div>
{% endblock %}
