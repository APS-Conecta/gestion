<html lang="es-CL">
    <head>
        <title>APS Conecta Gestión</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <link rel="stylesheet" href="style.css?v14">
        <link rel="stylesheet" href="logs.css?v1">
        <link rel="icon" href="aps/favicon.ico">
        <script src="apply-theme.js?v1"></script>
        <script src="log-load.js?v1"></script>
    </head>
    <body data-container-id="{{ id }}">
        <div id="floating-box">
            <div class="loader"></div>
            <div id="autoloading-box">
                <div>
                    La carga automática de nuevos registros está
                    <span id="autoloading-status">activada</span>.
                </div>
                <button id="autoloading-control">Desactivar</button>
            </div>
        </div>
        <pre>{{ logContent }}</pre>
    </body>
</html>
