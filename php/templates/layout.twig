<!DOCTYPE html>
<html lang="es-CL">
    <head>
        <title>APS Conecta Gestión</title>
        <link rel="stylesheet" href="style.css?v14" media="all" />
        <link rel="icon" href="aps/favicon.svg" type="image/svg+xml">
        <script type="text/javascript" src="forms.js?v2"></script>
        <script type="text/javascript" src="toggle-dark-mode.js?v2"></script>
        <script type="text/javascript" src="click-handlers.js?v3"></script>
    </head>

    <body>
        <div class="wrapper">
            {% block body %}{% endblock %}
        </div>
        <a class="source-link" href="https://github.com/APS-Conecta/gestion" target="_blank">Código fuente (AGPL-3.0)</a>
        <div id="overlay">
            <div class="loader"></div>
            <iframe name="overlay-log" id="overlay-log"></iframe>
        </div>
        <button id="theme-toggle">
            <span id="theme-icon"></span>
        </button>
    </body>
</html>
