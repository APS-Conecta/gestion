{% extends "layout.twig" %}

{% block body %}
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    </head>
    <header>
        <svg class="logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 142 71" width="62" height="50">
            <use href="img/nextcloud-logo.svg#logo"></use>
        </svg>
        <form method="POST" action="api/auth/logout">
            <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
            <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
            <input type="submit" value="Cerrar sesión" />
        </form>
    </header>

    <div class="container">
        <main>
            {% set aio_version = include('includes/aio-version.twig') %}
            <h1>APS Conecta Gestión (AIO v{{ aio_version|trim }})</h1>

            {# Add 2nd tab warning #}
            <script type="text/javascript" src="second-tab-warning.js"></script>

            {# timezone-prefill #}
            <script type="text/javascript" src="timezone.js?v1"></script>

            {# js for optional containers and additional containers forms #}
            <script type="text/javascript" src="containers-form-submit.js?v9"></script>

            {% set hasBackupLocation = borg_backup_host_location or borg_remote_repo %}
            {% set backupModeName = {'backup': 'copia de seguridad', 'check': 'comprobación', 'check-repair': 'reparación', 'list': 'actualización de la lista', 'restore': 'restauración', 'test': 'prueba'}[borg_backup_mode] ?? borg_backup_mode %}
            {% set isAnyRunning = false %}
            {% set isAnyRestarting = false %}
            {% set isWatchtowerRunning = false %}
            {% set isDomaincheckRunning = false %}
            {% set isBackupOrRestoreRunning = false %}
            {% set isApacheStarting = false %}
            {# Setting newMajorVersion to '' will hide corresponding options/elements, can be set to an integer like 26 in order to show corresponding elements. If set, also increase installLatestMajor in https://github.com/nextcloud/all-in-one/blob/main/php/src/Controller/DockerController.php #}
            {% set newMajorVersionString = '' %}
            {% set oldMajorVersionString = '26 Spring' %}

            {% if is_backup_container_running == true %}
                {% if borg_backup_mode == 'backup' or borg_backup_mode == 'restore' %}
                    {% set isBackupOrRestoreRunning = true %}
                {% endif %}
            {% endif %}

            {% for container in containers %}
                {% if container.hideFromList != true and container.GetRunningState().value == 'running' %}
                    {% set isAnyRunning = true %}
                {% endif %}
                {% if container.hideFromList != true and container.GetRestartingState().value == 'restarting' %}
                    {% set isAnyRestarting = true %}
                {% endif %}
                {% if container.identifier == 'nextcloud-aio-watchtower' and container.GetRunningState().value == 'running' %}
                    {% set isWatchtowerRunning = true %}
                {% endif %}
                {% if container.identifier == 'nextcloud-aio-domaincheck' and container.GetRunningState().value == 'running' %}
                    {% set isDomaincheckRunning = true %}
                {% endif %}
                {% if container.identifier == 'nextcloud-aio-apache' and container.GetStartingState().value == 'starting' %}
                    {% set isApacheStarting = true %}
                {% endif %}
            {% endfor %}

            {% if is_daily_backup_running == true %}
                <p><span class="status running"></span> Copia de seguridad diaria en ejecución. (<a href="log?id=nextcloud-aio-mastercontainer" target="_blank">Registros del mastercontainer</a>) (<a href="log?id=nextcloud-aio-borgbackup" target="_blank">Registros del contenedor de copias de seguridad</a>)</p>
                {% if automatic_updates == true %}
                    <p>Si la copia de seguridad es exitosa, se actualizarán sus contenedores, el mastercontainer y, los sábados, las aplicaciones de APS Conecta Gestión.</p>
                    {% if is_mastercontainer_update_available == true %}
                        <p>Cuando el mastercontainer se actualice, se reiniciará y no estará disponible por un momento. (<a href="log?id=nextcloud-aio-watchtower" target="_blank">Registros</a>)</p>
                    {% endif %}
                {% endif %}
                {% if has_update_available == false %}
                    <p>Todo el proceso no debería tardar más de unos minutos.</p>
                {% elseif automatic_updates == true %}
                    <p>Todo el proceso puede tardar un rato, ya que se actualizarán sus contenedores.</p>
                {% endif %}
                <p><a href="" class="button reload">Recargar ↻</a></p>
                <p>Si la copia de seguridad diaria queda atascada, puede destrabarla ejecutando <strong>sudo docker exec nextcloud-aio-mastercontainer rm /mnt/docker-aio-config/data/daily_backup_running</strong> y luego recargando esta interfaz.</p>
            {% elseif isWatchtowerRunning == true %}
                <p><span class="status running"></span> Actualización del mastercontainer en curso. Cuando termine, el mastercontainer se reiniciará y no estará disponible por un momento. Espere a que finalice. (<a href="log?id=nextcloud-aio-watchtower" target="_blank">Registros</a>)</p>
                <p><a href="" class="button reload">Recargar ↻</a></p>
            {% else %}
                {% if is_backup_container_running == false and domain == "" %}
                    {% if isDomaincheckRunning == false %}
                        <h2>El contenedor domaincheck no está en ejecución</h2>
                        <p>Esto no es lo esperado. Lo más probable es que el puerto {{ apache_port }} ya esté en uso en su servidor. Revise los registros del mastercontainer y del contenedor domaincheck para obtener más pistas. Debería poder resolverlo ajustando APACHE_PORT según la <strong><a target="_blank" href="https://github.com/nextcloud/all-in-one/blob/main/reverse-proxy.md">documentación del proxy inverso</a></strong>. Consejo: revise con detalle el comando docker run modificado de AIO.</p>
                    {% elseif is_mastercontainer_update_available == true %}
                        <h2>Actualización del mastercontainer</h2>
                        <p>⚠️ Hay una actualización del mastercontainer disponible. Haga clic en el botón de abajo para actualizarlo. Después podrá continuar con la configuración.</p>
                        <form method="POST" action="api/docker/watchtower" target="overlay-log">
                            <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                            <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                            <input type="submit" value="Actualizar el mastercontainer" />
                        </form>
                    {% else %}
                        {% if not hasBackupLocation %}
                            <p>Instala y mantiene APS Conecta Gestión en este servidor: archivos, oficina y las aplicaciones APS, con respaldo diario y actualizaciones en conjunto.</p>
                            <p>Puede crear una instancia nueva de AIO o restaurar una instancia anterior de AIO desde una copia de seguridad. Vea las dos secciones siguientes.</p>
                            {{ include('includes/aio-config.twig') }}
                            <h2>Instancia nueva de AIO</h2>
                            {% if apache_port == '443' %}
                                <p>AIO está actualmente en «modo normal», lo que significa que gestiona él mismo el proxy TLS. Esto también significa que no puede instalarse detrás de un servidor web o un proxy inverso (como Apache, Nginx, Caddy, Cloudflare Tunnel, entre otros). Si desea ejecutar AIO detrás de un servidor web o un proxy inverso, vea la <strong><a target="_blank" href="https://github.com/nextcloud/all-in-one/blob/main/reverse-proxy.md">documentación del proxy inverso</a></strong>. Consejo: revise con detalle el comando docker run modificado de AIO.</p>
                            {% else %}
                                <p>AIO está actualmente en «modo proxy inverso», lo que significa que puede instalarse detrás de un servidor web o un proxy inverso (como Apache, Nginx, Caddy, Cloudflare Tunnel, entre otros) y no gestiona él mismo el proxy TLS.</p>
                            {% endif %}
                            <p>Escriba el dominio que se utilizará para APS Conecta Gestión y envíelo.</p>
                            {% if skip_domain_validation == true %}
                                <p><strong>Tenga en cuenta:</strong> la validación del dominio está desactivada, por lo que aquí se aceptará cualquier dominio. Asegúrese de no cometer un error de tipeo, ya que no podrá cambiarlo después.</p>
                            {% endif %}
                            <form method="POST" action="api/configuration" class="xhr">
                                <input type="text" id="domain" name="domain" value="{{ domain }}" placeholder="gestion.su-establecimiento.cl"/>
                                <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                {% if skip_domain_validation == true %}
                                    <input type="hidden" name="skip_domain_validation" value="{{skip_domain_validation}}">
                                {% endif %}
                                <input type="submit" value="Enviar dominio" />
                            </form>

                            <details>
                                <summary>¿No tiene un dominio? Obtenga uno gratuito de deSEC</summary>
                                <p><a target="_blank" href="https://desec.io">deSEC</a> ofrece subdominios DNS dinámicos gratuitos bajo <strong>dedyn.io</strong>. AIO puede registrar por usted una cuenta y un subdominio automáticamente. Haga clic en el botón de abajo para comenzar; el registro se abre en una ventana pequeña, para que pueda ajustar los datos y completar la verificación del correo sin perder esta página. Al terminar, esta página se recarga con su nuevo dominio configurado. (Para que su instancia sea accesible públicamente, además debe asegurarse de que el puerto 443 esté abierto en el firewall de su servidor y, si corresponde, de que su router lo reenvíe a su servidor. Más abajo encontrará detalles sobre el reenvío de puertos).</p>
                                {% if desec_awaiting_verification or desec_account_registered %}
                                    <p>⚠️ Ya hay un registro de deSEC en curso para <strong>{{ desec_email }}</strong>, pero aún no termina. Haga clic en el botón de abajo para continuarlo.</p>
                                    <button type="button" class="button" data-desec-open>Continuar el registro en deSEC</button>
                                {% else %}
                                    <button type="button" class="button" data-desec-open>Registrar un dominio gratuito con deSEC</button>
                                {% endif %}
                            </details>
                            <div id="desec-modal" class="modal" role="dialog" aria-modal="true" aria-label="Registrar un dominio gratuito de deSEC" hidden>
                                <div class="modal-content">
                                    <button type="button" class="modal-close" data-desec-close aria-label="Cerrar">&times;</button>
                                    <iframe id="desec-frame" title="Registrar un dominio gratuito de deSEC"></iframe>
                                </div>
                            </div>
                            <script type="text/javascript" src="desec-modal.js"></script>

                            {% if skip_domain_validation == false %}
                                <p>Asegúrese de que este servidor sea accesible en el puerto 443 (que el puerto 443/tcp esté abierto o reenviado en su firewall o router, y también el 443/udp si desea activar http3) y de que haya configurado correctamente el DNS del dominio que ingrese (establezca el registro A en su dirección IPv4 pública y, si necesita IPv6, el registro AAAA en su dirección IPv6 pública; un registro CNAME también es posible). Si su dominio no es aceptado, verá sugerencias sobre el problema en la esquina superior derecha.</p>
                                <details>
                                    <summary>Haga clic aquí para ver más sugerencias</summary>
                                    <p>Si aún no tiene un dominio, la opción más sencilla es registrar el <strong>dominio gratuito de deSEC</strong> de esta página. También puede obtener un dominio gratuito de duckdns.org u otros, o usar <a target="_blank" href="https://github.com/nextcloud/all-in-one/discussions/6817">Tailscale</a>.</p>
                                    <p>Si tiene una dirección IP pública dinámica, puede usar, por ejemplo, <a target="_blank" href="https://ddclient.net/">DDclient</a> con un proveedor de dominios compatible para actualizar el DNS.</p>
                                    <p>Si solo desea instalar AIO de forma local, sin exponerlo a internet, o si no puede hacerlo, siga <a target="_blank" href="https://github.com/nextcloud/all-in-one/blob/main/local-instance.md">esta documentación</a>.</p>
                                    <p>Si usa Cloudflare Proxy para su dominio, desactive temporalmente la función Proxy, ya que podría bloquear los intentos de validación del dominio.</p>
                                    {% if apache_port != '443' %}
                                        <p>Si su dominio no es aceptado, vea <a target="_blank" href="https://github.com/nextcloud/all-in-one/blob/main/reverse-proxy.md#how-to-debug">estos pasos</a> para diagnosticar el problema.</p>
                                    {% endif %}
                                    <p><strong>Sugerencia:</strong> si la validación del dominio falla, pero está completamente seguro de que configuró todo correctamente, puede omitir la validación del dominio siguiendo <a target="_blank" href="https://github.com/nextcloud/all-in-one#how-to-skip-the-domain-validation">esta documentación</a>.</p>
                                </details>
                            {% endif %}

                            <h2>Restaurar una instancia anterior de AIO desde una copia de seguridad</h2>
                            <p>Como alternativa, puede restaurar una instancia anterior de AIO desde una copia de seguridad.</p>
                        {% endif %}

                        {% if is_instance_restore_attempt == false %}
                            {% if hasBackupLocation %}
                                {% if borg_backup_mode in ['test', 'check'] %}
                                    {% if backup_exit_code > 0 %}
                                        <p><span class="status error"></span> ¡Falló la última {{ backupModeName }}! (<a href="log?id=nextcloud-aio-borgbackup" target="_blank">Registros</a>)</p>
                                        {% if borg_backup_mode == 'test' %}
                                            <p>Ajuste la ruta o la contraseña de cifrado para que funcione.</p>
                                        {% elseif borg_backup_mode == 'check' %}
                                            <p>El archivo de la copia de seguridad parece estar dañado. Intente usar otro archivo de copia de seguridad intacto o intente repararlo siguiendo <a target="_blank" href="https://borgbackup.readthedocs.io/en/stable/faq.html#i-get-an-integrityerror-or-similar-what-now"><strong>esta documentación</strong></a></p>
                                            <details>
                                                <summary>Mostrar la opción de reparación</summary>
                                                <p>A continuación está la opción para reparar la integridad de su copia de seguridad. <strong>Tenga en cuenta:</strong> úsela solo después de haber leído la documentación anterior. (Ejecutará por usted el comando 'borg check --repair').</p>
                                                <form method="POST" action="api/docker/backup-check-repair" target="overlay-log">
                                                    <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                                    <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                                    <input type="submit" value="Comprobar y reparar la integridad de la copia de seguridad" data-confirm='¿Comprobar y reparar la integridad de la copia de seguridad? ¿Está seguro de que desea comprobar y reparar la integridad de la copia de seguridad? Esto solo debería hacerse después de leer la documentación mencionada.'/>
                                                </form>
                                            </details>
                                        {% endif %}
                                    {% elseif backup_exit_code == 0 %}
                                        <p><span class="status success"></span> ¡La última {{ backupModeName }} fue exitosa! (<a href="log?id=nextcloud-aio-borgbackup" target="_blank">Registros</a>)</p>
                                        {% if borg_backup_mode == 'test' %}
                                            <p>Si lo desea, compruebe a continuación la integridad del archivo de la copia de seguridad antes de iniciar la restauración, para asegurarse de que funcione. Sin embargo, esto puede tardar mucho según el tamaño del archivo y no es obligatorio.</p>
                                            <form method="POST" action="api/docker/backup-check" target="overlay-log">
                                                <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                                <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                                <input type="submit" value="Comprobar la integridad de la copia de seguridad"/>
                                            </form>
                                        {% endif %}
                                        <p>Elija la copia de seguridad que desea restaurar y haga clic en el botón de abajo para restaurarla. Esto restaurará toda la instancia de AIO. Tenga en cuenta que se conservará la frase de contraseña actual de AIO y que la frase de contraseña anterior no se restaurará desde la copia de seguridad.</p>
                                        <p><strong>Importante:</strong> si la copia de seguridad que desea restaurar contenía algún <a target="_blank" href="https://github.com/nextcloud/all-in-one/tree/main/community-containers#community-containers">contenedor de la comunidad</a>, debe restaurar la misma copia una segunda vez después de este intento, para que los datos del contenedor de la comunidad también se restauren correctamente.</p>
                                        <form method="POST" action="api/docker/restore" target="overlay-log" id="restore_selection">
                                            <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                            <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                            <select id="selected_restore_time" name="selected_restore_time" form="restore_selection">
                                                {% for restore_time in backup_times %}
                                                    <option value="{{ restore_time }}">{{ restore_time }} UTC</option>
                                                {% endfor %}
                                            </select><br>
                                            <input type="checkbox" id="restore-exclude-previews" name="restore-exclude-previews"><label for="restore-exclude-previews">Excluir las vistas previas de la restauración, lo que la acelerará, pero provocará un escaneo de la carpeta de vistas previas la próxima vez que se inicie el servidor de aplicaciones</label><br>
                                            <input type="submit" value="Restaurar la copia de seguridad seleccionada" data-confirm='⚠️ Importante: si la copia de seguridad que desea restaurar contenía algún contenedor de la comunidad, debe restaurar la misma copia una segunda vez después de este intento, para que los datos del contenedor de la comunidad también se restauren correctamente.'/>
                                        </form>
                                    {% endif %}
                                {% elseif borg_backup_mode == 'restore' %}
                                    {% if backup_exit_code > 0 %}
                                        <p><span class="status error"></span> ¡Falló la última restauración! (<a href="log?id=nextcloud-aio-borgbackup" target="_blank">Registros</a>)</p>
                                        <p>¡La restauración falló inesperadamente! Ajuste la ruta y la contraseña de cifrado, pruébelas e intente restaurar de nuevo.</p>
                                    {% endif %}
                                {% endif %}
                            {% endif %}

                            {% if not hasBackupLocation or borg_backup_mode not in ['test', 'check', ''] or backup_exit_code > 0 %}
                                {% if borg_remote_repo and backup_exit_code > 0 %}
                                <p>
                                Puede que aún deba autorizar esta clave pública en su repositorio borg remoto:<br><strong>{{ borg_public_key }}</strong><br>
                                Para volver a intentarlo, envíe de nuevo su ubicación y repita la prueba.
                                </p>
                                {% endif %}

                                <p>
                                Ingrese a continuación la ubicación del archivo de la copia de seguridad en su servidor o una
                                <a target="_blank" href="https://borgbackup.readthedocs.io/en/stable/usage/general.html#repository-urls">URL de repositorio borg remoto</a>
                                si está almacenado de forma remota, y la contraseña de cifrado del archivo; luego envíe todos los valores:
                                </p>
                                <form method="POST" action="api/configuration" class="xhr">
                                    <label>Ubicación local de la copia de seguridad</label> <input type="text" id="borg_restore_host_location" name="borg_restore_host_location" value="{{borg_backup_host_location}}" placeholder="/mnt/backup"/><br>
                                    <label>Repositorio borg remoto</label> <input type="text" name="borg_restore_remote_repo" value="{{borg_remote_repo}}" placeholder="ssh://user@host:port/path/to/repo"/><br>
                                    <label>Frase de contraseña de Borg</label> <input type="text" id="borg_restore_password" name="borg_restore_password" value="{{borg_restore_password}}" placeholder="contraseña de cifrado"/><br>
                                    <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                    <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                    <input type="submit" value="Enviar la ubicación y la contraseña de cifrado" />
                                </form>
                                {{ include('includes/backup-dirs.twig') }}
                                <p>⚠️ Tenga en cuenta que el archivo de la copia de seguridad debe estar en una subcarpeta de la carpeta que ingrese aquí y que esa subcarpeta debe llamarse 'borg'; de lo contrario, el contenedor de copias de seguridad no podrá encontrar el archivo.</p>
                            {% endif %}
                        {% else %}
                            <p><strong>¡Todo listo!</strong> Haga clic en el botón de abajo para probar la ruta y la contraseña de cifrado:</p>
                            <form method="POST" action="api/docker/backup-test" target="overlay-log">
                                <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                <input type="submit" value="Probar la ruta y la contraseña de cifrado"/>
                            </form>
                        {% endif %}
                    {% endif %}
                    <h2>¿Cómo restablecer la instancia de AIO?</h2>
                    <p>Si algo sale mal, por ejemplo durante la instalación inicial, puede restablecer la instancia siguiendo <a target="_blank" href="https://github.com/nextcloud/all-in-one#how-to-properly-reset-the-instance">esta documentación</a>.</p>
                {% endif %}

                {% if was_start_button_clicked == true %}
                    {% if current_channel starts with 'latest' or current_channel starts with 'beta' or current_channel starts with 'develop' %}
                        <p>Está usando el canal <a target="_blank" href="https://github.com/nextcloud/all-in-one#how-to-switch-the-channel"><strong>{{ current_channel }}</strong></a>. (<a href="log?id=nextcloud-aio-mastercontainer" target="_blank">Registros</a>)</p>
                    {% else %}
                        <p>No se encontró ningún canal. Esto significa que AIO no puede actualizarse a sí mismo ni a sus componentes, y tampoco podrá informar sobre actualizaciones. Las actualizaciones deben hacerse externamente.</p>
                    {% endif %}
                {% endif %}

                {% if is_backup_container_running == true %}
                    <p><span class="status running"></span> El contenedor de copias de seguridad está en ejecución: {{ backupModeName }} (<a href="log?id=nextcloud-aio-borgbackup" target="_blank">Registros</a>)</p>
                    <p><a href="" class="button reload">Recargar ↻</a></p>
                {% endif %}

                {% if domain != "" %}
                    {% if isAnyRunning == true %}
                        {% if isApacheStarting != true %}
                            {% if hasBackupLocation %}
                                <details>
                                <summary>Haga clic aquí para mostrar las credenciales iniciales de APS Conecta Gestión</summary>
                            {% endif %}
                                    <p>Usuario inicial de APS Conecta Gestión: <strong>admin</strong></p>
                            {% if hasBackupLocation %}
                                {# nextcloud_password needs to be duplicated due to a bug in Firefox. See https://github.com/nextcloud/all-in-one/issues/638. #}
                                <p>Contraseña inicial de APS Conecta Gestión: <strong id="initial-nextcloud-password">{{ nextcloud_password }}</strong></p></details>
                            {% else %}
                                <p>Contraseña inicial de APS Conecta Gestión: <strong id="initial-nextcloud-password">{{ nextcloud_password }}</strong></p>
                            {% endif %}
                            <p><a href="https://{{ domain }}" class="button" target="_blank">Abrir APS Conecta Gestión ↗</a></p>
                            {% if not hasBackupLocation %}
                                <p>Si APS Conecta Gestión no se abre al hacer clic en el botón de arriba, vea <strong><a target="_blank" href="https://github.com/nextcloud/all-in-one/discussions/2105">esta documentación</a></strong></p>
                            {% endif %}
                        {% else %}
                            {% if isAnyRestarting == false %}
                                <p><span class="status running"></span> Los contenedores se están iniciando. Para ver más detalles, revise los registros de cada contenedor haciendo clic en <strong>Iniciando</strong>, junto a su nombre.</p>
                                <p><a href="" class="button reload">Recargar ↻</a></p>
                            {% else %}
                                <p>Parece que al menos un contenedor no pudo iniciarse correctamente y se está reiniciando.</p>
                                <p>Para romper este ciclo, puede detener los contenedores con el botón de abajo e investigar el problema en sus registros antes de iniciarlos de nuevo.</p>
                                <form method="POST" action="api/docker/stop" target="overlay-log">
                                    <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                    <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                    <input type="submit" value="Detener contenedores" />
                                </form>
                            {% endif %}
                        {% endif %}
                    {% endif %}

                    {% if isApacheStarting == false and is_backup_container_running == false %}
                        {{ include('includes/aio-config.twig') }}
                    {% endif %}

                    {% if was_start_button_clicked == true %}
                        <h2>Contenedores</h2>
                        <ul>
                            {# @var containers \AIO\Container\Container[] #}
                            {% for container in containers %}
                                {% if container.hideFromList != true %}
                                    {% include 'components/container-state.twig'  with {'c': container} only %}
                                {% endif %}
                            {% endfor %}
                        </ul>

                        {% if has_update_available == true %}
                            {% if is_mastercontainer_update_available == false %}
                                <p>⚠️ Hay actualizaciones de contenedores disponibles. Haga clic en <strong>Detener contenedores</strong> y luego en <strong>Iniciar y actualizar contenedores</strong> para actualizarlos. Le recomendamos crear antes una copia de seguridad.</p>
                            {% endif %}
                        {% else %}
                            {% if is_mastercontainer_update_available == false %}
                                <p>Sus contenedores están actualizados.</p>
                                {% if newMajorVersionString != '' and isAnyRunning == true and isApacheStarting != true %}
                                    <details>
                                    <summary>Nota sobre <strong>Nextcloud Hub {{ newMajorVersionString }}</strong></summary>
<p>Si aún no actualizó a Nextcloud Hub {{ newMajorVersionString }} y desea hacerlo ahora, haga clic en el botón de abajo. ⚠️ Advertencia: cree una copia de seguridad antes de hacer clic, ya que la actualización puede fallar y dejar su instancia inutilizable.</p>
                                        <form method="POST" action="api/docker/nextcloud-upgrade-to-latest-major" target="overlay-log">
                                            <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                            <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                            <input type="submit" value="Actualizar a Nextcloud Hub {{ newMajorVersionString }}" data-confirm="¿Actualizar a Nextcloud Hub {{ newMajorVersionString }}? Le recomendamos crear antes una copia de seguridad." />
                                        </form>
                                    </details>
                                {% endif %}
                            {% endif %}
                        {% endif %}
                    {% endif %}

                    {% if isAnyRunning == true %}
                        {% if isApacheStarting != true %}
                            {% if is_mastercontainer_update_available == true %}
                                <p>⚠️ Hay una actualización del mastercontainer disponible. Haga clic en el botón de abajo para detener sus contenedores y así actualizar el mastercontainer.</p>
                                {% if current_channel starts with 'latest' %}
                                    <p>Puede ver el registro de cambios <a target="_blank" href="https://github.com/nextcloud/all-in-one/releases/latest"><strong>aquí</strong></a></p>
                                {% elseif current_channel starts with 'beta' %}
                                    <p>Puede ver el registro de cambios <a target="_blank" href="https://github.com/nextcloud/all-in-one/releases"><strong>aquí</strong></a></p>
                                {% elseif current_channel starts with 'develop' %}
                                    <p>Puede ver todos los cambios <a target="_blank" href="https://github.com/nextcloud-releases/all-in-one/commits/main"><strong>aquí</strong></a></p>
                                {% endif %}
                            {% endif %}
                            <form method="POST" action="api/docker/stop" target="overlay-log">
                                <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                <input type="submit" value="Detener contenedores" />
                            </form>
                        {% endif %}
                    {% else %}
                        {% if isBackupOrRestoreRunning == true %}
                            <p>Hay una restauración o copia de seguridad en ejecución. No se pueden iniciar los contenedores hasta que termine.</p>
                        {% else %}
                            {% if was_start_button_clicked == false %}
                                {% if is_desec_domain == true %}
                                    {% include 'includes/desec-domain-notice.twig' %}
                                {% endif %}
                                <p>Al hacer clic en el botón de abajo se descargarán todos los contenedores de Docker y se iniciarán. Esto puede tardar mucho según su conexión a internet: como el tamaño total es de unos pocos GB, puede tomar unos 5 a 10 minutos o más. ¡Tenga paciencia!</p>
                            {% endif %}
                            {% if is_mastercontainer_update_available == true %}
                                <p>⚠️ Hay una actualización del mastercontainer disponible. Haga clic en el botón de abajo para actualizarlo.</p>
                                <form method="POST" action="api/docker/watchtower" target="overlay-log">
                                    <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                    <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                    <input type="submit" value="Actualizar el mastercontainer" />
                                </form>
                            {% else %}
                                {% if was_start_button_clicked == false %}
                                    <form method="POST" action="api/docker/start" target="overlay-log">
                                        <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                        <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                        <input id="base_path" type="hidden" name="base_path" value="">
                                        {% if bypass_container_update == true %}
                                            <input type="hidden" name="bypass_container_update" value="true">
                                        {% endif %}
                                        {% if newMajorVersionString != '' %}
                                            <input type="checkbox" id="install_latest_major" name="install_latest_major"><label for="install_latest_major">Instalar Nextcloud Hub {{ newMajorVersionString }} (si no lo marca, se instalará Nextcloud Hub {{ oldMajorVersionString }})</label><br>
                                        {% endif %}
                                        <input type="submit" value="Descargar e iniciar contenedores" />
                                    </form>
                                {% elseif has_update_available == false %}
                                    <form method="POST" action="api/docker/start" target="overlay-log">
                                        <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                        <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                        <input id="base_path" type="hidden" name="base_path" value="">
                                        {% if bypass_container_update == true %}
                                            <input type="hidden" name="bypass_container_update" value="true">
                                        {% endif %}
                                        <input type="submit" value="Iniciar contenedores" />
                                    </form>
                                {% else %}
                                    <form method="POST" action="api/docker/start" target="overlay-log">
                                        <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                        <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                        <input id="base_path" type="hidden" name="base_path" value="">
                                        {% if bypass_container_update == true %}
                                            <input type="hidden" name="bypass_container_update" value="true">
                                        {% endif %}
                                        <input class="button " type="submit" value="Iniciar y actualizar contenedores" data-confirm='¿Iniciar y actualizar contenedores? Le recomendamos crear antes una copia de seguridad.' />
                                    </form>
                                {% endif %}
                            {% endif %}
                        {% endif %}
                    {% endif %}

                    {% if was_start_button_clicked == true %}

                        {% if is_desec_domain %}
                            <h2>Credenciales de la cuenta de deSEC</h2>
                            {% if desec_password %}
                                {# AIO created this account, so it generated and stored the password.
                                   Show it so the user can log in at desec.io if they ever need to. #}
                                <p>Su dominio <strong>{{ domain }}</strong> se administra mediante <a target="_blank" href="https://desec.io">deSEC</a>. A continuación están las credenciales de su cuenta de deSEC. Puede usarlas para iniciar sesión en <a target="_blank" href="https://desec.io">desec.io</a> y administrar su dominio directamente.</p>
                                <p>Correo electrónico: <strong>{{ desec_email }}</strong></p>
                                <p><details class="inline-details"><summary>Mostrar la contraseña de deSEC</summary><strong>{{ desec_password }}</strong></details></p>
                                <p>Guarde estas credenciales en un lugar seguro.</p>
                            {% else %}
                                {# The user logged in with their own existing deSEC account; AIO never
                                   stored their password, so there is nothing to reveal. #}
                                <p>Su dominio <strong>{{ domain }}</strong> se administra mediante su cuenta existente de <a target="_blank" href="https://desec.io">deSEC</a> (<strong>{{ desec_email }}</strong>). Inicie sesión en <a target="_blank" href="https://desec.io">desec.io</a> con su propia contraseña para administrar su dominio directamente.</p>
                            {% endif %}
                        {% endif %}

                        {% if is_backup_section_enabled == false %}
                            <h2>Copias de seguridad y restauración</h2>
                            <p>La sección de copias de seguridad está desactivada mediante una variable de entorno.</p>
                        {% else %}
                            {% if is_backup_container_running == false and not hasBackupLocation and isApacheStarting != true %}
                                <h2>Copias de seguridad y restauración</h2>
                                <p>Ingrese a continuación la ruta del directorio del servidor donde se crearán las copias de seguridad y envíela. Lo mejor es elegir una ubicación en una unidad aparte y no en su unidad raíz.</p>
                                <p>
                                Para almacenar las copias de seguridad de forma remota, complete la
                                <a target="_blank" href="https://borgbackup.readthedocs.io/en/stable/usage/general.html#repository-urls">URL del repositorio borg remoto y envíela</a>.
                                Luego recibirá una clave pública SSH para autorizarla en el servidor remoto.
                                </p>
                                <form method="POST" action="api/configuration" class="xhr">
                                    <label>Ubicación local de la copia de seguridad</label> <input type="text" id="borg_backup_host_location" name="borg_backup_host_location" placeholder="/mnt/backup"/><br>
                                    <label>Repositorio borg remoto</label> <input type="text" name="borg_remote_repo" placeholder="ssh://user@host:port/path/to/repo"/><br>
                                    <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                    <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                    <input type="submit" value="Enviar la ubicación de la copia de seguridad" />
                                </form>
                                {{ include('includes/backup-dirs.twig') }}
                            {% endif %}
                        {% endif %}

                        {% if is_backup_section_enabled == true %}

                            {% if hasBackupLocation %}
                                {% if is_backup_container_running == false %}
                                    <h2>Copias de seguridad y restauración</h2>
                                    {% if backup_exit_code > 0 %}
                                        <p><span class="status error"></span> ¡Falló la última {{ backupModeName }}! (<a href="log?id=nextcloud-aio-borgbackup" target="_blank">Registros</a>)</p>
                                        {% if borg_backup_mode == "check" %}
                                            <p>La comprobación de la copia de seguridad no fue exitosa. Esto podría indicar un archivo dañado (revise los registros). Si es así, puede intentar repararlo siguiendo <a target="_blank" href="https://borgbackup.readthedocs.io/en/stable/faq.html#i-get-an-integrityerror-or-similar-what-now"><strong>esta documentación</strong></a></p>
                                            <details>
                                                <summary>Mostrar la opción de reparación</summary>
                                                <p>A continuación está la opción para reparar la integridad de su copia de seguridad. <strong>Tenga en cuenta:</strong> úsela solo después de haber leído la documentación anterior. (Ejecutará por usted el comando 'borg check --repair').</p>
                                                <form method="POST" action="api/docker/backup-check-repair" target="overlay-log">
                                                    <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                                    <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                                    <input type="submit" value="Comprobar y reparar la integridad de la copia de seguridad" data-confirm='¿Comprobar y reparar la integridad de la copia de seguridad? ¿Está seguro de que desea comprobar y reparar la integridad de la copia de seguridad? Esto solo debería hacerse después de leer la documentación mencionada.'/>
                                                </form>
                                            </details>
                                        {% endif %}
                                        {% if has_backup_run_once == false %}
                                            <p>La copia de seguridad inicial no fue exitosa.</p>

                                            {% if borg_remote_repo %}
                                            <p>
                                            Puede que aún deba autorizar esta clave pública en su repositorio borg remoto:<br><strong>{{ borg_public_key }}</strong><br>
                                            Para volver a intentarlo, haga clic en <strong>Crear copia de seguridad</strong>.
                                            </p>
                                            {% endif %}

                                            <p>Como la copia de seguridad inicial no fue exitosa, puede cambiar de nuevo la ruta de la copia. Después de enviar el nuevo valor, haga clic en <strong>Crear copia de seguridad</strong> para probarlo.</p>
                                            <form method="POST" action="api/configuration" class="xhr">
                                                <label>Ubicación local de la copia de seguridad</label> <input type="text" name="borg_backup_host_location" placeholder="/mnt/backup"/><br>
                                                <label>Repositorio borg remoto</label> <input type="text" name="borg_remote_repo" placeholder="ssh://user@host:port/path/to/repo"/><br>
                                                <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                                <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                                <input type="submit" value="Establecer de nuevo la ubicación de la copia de seguridad" />
                                            </form>
                                        {% endif %}
                                    {% elseif backup_exit_code == 0 %}
                                        {% if borg_backup_mode == "backup" %}
                                            <p><span class="status success"></span> ¡La última {{ backupModeName }} fue exitosa el {{ last_backup_time }} UTC! (<a href="log?id=nextcloud-aio-borgbackup" target="_blank">Registros</a>)</p>
                                        {% else %}
                                            <p><span class="status success"></span> ¡La última {{ backupModeName }} fue exitosa! (<a href="log?id=nextcloud-aio-borgbackup" target="_blank">Registros</a>)</p>
                                        {% endif %}
                                    {% endif %}
                                {% endif %}

                                {% if is_backup_container_running == false and isApacheStarting == false %}
                                    {% if has_backup_run_once == true %}
                                        <details>
                                        <summary>Haga clic aquí para mostrar todas las opciones de copia de seguridad (incluida una opción de actualizaciones automáticas)</summary>
                                    {% endif %}
                                    <h3>Información de la copia de seguridad</h3>
                                    {% if has_backup_run_once == true %}
                                        <p><details class="inline-details"><summary>Mostrar su contraseña de cifrado de las copias de seguridad</summary><strong id="borg-backup-password">{{ borgbackup_password }}</strong></details></p>
                                    {% else %}
                                        <p>Esta es su contraseña de cifrado de las copias de seguridad: <strong id="borg-backup-password">{{ borgbackup_password }}</strong></p>
                                    {% endif %}
                                    <p>Guarde esta contraseña en un lugar seguro. Si la pierde, no podrá restaurar desde la copia de seguridad.</p>
                                    <p>Se respaldarán todos los datos importantes de su instancia de APS Conecta Gestión, como la base de datos, sus archivos y los archivos de configuración del mastercontainer.</p>
                                    <p>La copia de seguridad usa una herramienta llamada <a target="_blank" href="https://github.com/borgbackup/borg#what-is-borgbackup"><strong>BorgBackup</strong></a>, una conocida herramienta de copias de seguridad para servidores que respalda sus archivos de forma eficiente y los cifra al vuelo.</p>
                                    <p>Con esta herramienta, las copias de seguridad son incrementales, diferenciales, comprimidas y cifradas: solo la primera tomará un tiempo. Las siguientes deberían ser rápidas, ya que solo consideran los cambios.</p>
                                    {% if borg_remote_repo != '' %}
                                        <p>
                                        Las copias de seguridad se crean de forma remota en:<br>
                                        <strong>{{ borg_remote_repo }}</strong>
                                        {% if has_backup_run_once == true %}
                                        <br/>Su clave pública SSH de borg es:<br><strong>{{ borg_public_key }}</strong>
                                        {% endif %}
                                        </p>
                                    {% else %}
                                        <p>Las copias de seguridad se crearán en el siguiente directorio del servidor: <strong>{{ borg_backup_host_location }}/borg</strong></p>
                                    {% endif %}
                                    <p>Tenga en cuenta que esta solución no respalda los archivos y carpetas montados en APS Conecta Gestión con la aplicación de almacenamiento externo, pero, una vez terminada la copia de seguridad inicial, puede agregar los volúmenes de Docker y rutas del servidor que desee respaldar.</p>
                                    <p>Para saber cuánto tiempo se conservan las copias de seguridad, vea <strong><a target="_blank" href="https://github.com/nextcloud/all-in-one#how-to-adjust-borgs-retention-policy">esta documentación</a></strong>.</p>
                                    <p>Las copias de seguridad diarias pueden activarse una vez terminada la copia inicial. Al activarlas, también podrá activar una opción para actualizar automáticamente todos los contenedores, APS Conecta Gestión y sus aplicaciones.</p>
                                    <p>Para más documentación y opciones de esta solución de copias de seguridad, vea <strong><a target="_blank" href="https://github.com/nextcloud/all-in-one#backup">esta sección</a></strong> y las siguientes.</p>

                                    {% if isApacheStarting != true %}
                                        <h3>Creación de la copia de seguridad</h3>
                                        <p>Al hacer clic en el botón de abajo se creará una copia de seguridad.</p>
                                        <form method="POST" action="api/docker/backup" target="overlay-log">
                                            <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                            <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                            <input type="submit" value="Crear copia de seguridad" data-confirm='¿Crear una copia de seguridad? ¿Está seguro de que desea crear una copia de seguridad? Esto detendrá todos los contenedores en ejecución y creará la copia.' />
                                        </form>

                                        {% if has_backup_run_once == true %}
                                            <h3>Visor de copias de seguridad</h3>
                                            <p>Existe un contenedor de la comunidad que permite acceder a sus copias de seguridad desde el navegador. Vea <a target="_blank" href="https://github.com/nextcloud/all-in-one/tree/main/community-containers/borgbackup-viewer"><strong>esta documentación</strong></a>.</p>

                                            <h3>Comprobación de la copia de seguridad</h3>
                                            <p>Haga clic en el botón de abajo para comprobar la integridad de la copia de seguridad. Esta opción verifica que su copia esté intacta. No debería ser necesaria en la mayoría de los casos.</p>
                                            <form method="POST" action="api/docker/backup-check" target="overlay-log">
                                                <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                                <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                                <input type="submit" value="Comprobar la integridad de la copia de seguridad" data-confirm='¿Comprobar la integridad de la copia de seguridad? ¿Está seguro de que desea comprobarla? Esto puede tardar mucho según el tamaño de su copia de seguridad.' />
                                            </form>

                                            <h3>Restauración de la copia de seguridad</h3>
                                            <p>Elija la copia de seguridad que desea restaurar y haga clic en el botón de abajo para restaurarla. Esto sobrescribirá todos sus archivos con la copia elegida, por lo que le recomendamos crear antes una copia de seguridad. Puede comprobar la integridad antes de restaurar sus archivos, aunque no debería ser necesario en la mayoría de los casos. Tenga en cuenta que esto no restaurará los directorios adicionales elegidos para las copias de seguridad. La restauración debería ser bastante rápida, ya que usa rsync, que solo transfiere los archivos modificados.</p>
                                            <form method="POST" action="api/docker/restore" target="overlay-log" id="restore_selection">
                                                <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                                <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                                <select id="selected_restore_time" name="selected_restore_time" form="restore_selection">
                                                    {% for restore_time in backup_times %}
                                                        <option value="{{ restore_time }}">{{ restore_time }} UTC</option>
                                                    {% endfor %}
                                                </select>
                                                <input type="submit" value="Restaurar la copia de seguridad seleccionada" data-confirm='¿Restaurar la copia de seguridad seleccionada? ¿Está seguro de que desea restaurarla? Esto detendrá todos los contenedores en ejecución y restaurará la copia seleccionada. Se recomienda crear antes una copia de seguridad. También puede comprobar su integridad.' />
                                            </form>

                                            <h3>Actualizar la lista de copias de seguridad</h3>
                                            <details>
                                                <summary>Haga clic aquí para mostrar esta opción</summary>
                                                <p>Si usa una herramienta externa de instantáneas para restaurar el servidor que ejecuta AIO, puede que la lista de copias de seguridad disponibles de arriba no esté actualizada. Haga clic en el botón de abajo para actualizarla.</p>
                                                <form method="POST" action="api/docker/backup-list" target="overlay-log">
                                                    <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                                    <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                                    <input type="submit" value="Actualizar la lista de copias de seguridad" />
                                                </form>
                                            </details>

                                            <h3>Copia de seguridad diaria y actualizaciones automáticas</h3>
                                            {% if daily_backup_time == "" %}
                                                <p>Para activar las copias de seguridad diarias, ingrese una hora a continuación y envíela. Se crearán a esa hora, en formato de 24 horas: por ejemplo, <strong>04:00</strong> crea las copias a las 4:00 UTC y <strong>16:00</strong>, a las 16:00 UTC. Durante la copia, los contenedores se detienen y se reinician al terminar.</p>
                                                <form method="POST" action="api/configuration" class="xhr">
                                                    <input type="text" name="daily_backup_time" placeholder="04:00"/>
                                                    <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                                    <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                                    <input type="submit" value="Enviar la hora y la configuración de la copia de seguridad diaria" /><br>
                                                    <input type="checkbox" id="automatic_updates" name="automatic_updates" checked="checked"><label for="automatic_updates">Actualizar automáticamente todos los contenedores, el mastercontainer y, los sábados, las aplicaciones de APS Conecta Gestión</label><br>
                                                    <input type="checkbox" id="success_notification" name="success_notification" checked="checked"><label for="success_notification">Enviar notificaciones de las copias de seguridad exitosas (las de las copias fallidas se envían siempre)</label>
                                                </form>
                                            {% else %}
                                                <p>Las copias de seguridad diarias se crearán a las <strong>{{ daily_backup_time }} UTC</strong>. Se enviará una notificación con el resultado de cada copia.</p>
                                                {% if automatic_updates == true %}
                                                    También se actualizarán automáticamente sus contenedores, el mastercontainer y, los sábados, las aplicaciones de APS Conecta Gestión.
                                                {% endif %}
                                                <p>Para cambiar la hora de la copia de seguridad, desactive primero las copias diarias, ingrese la nueva hora y vuelva a activarlas.</p>
                                                <form method="POST" action="api/configuration" class="xhr">
                                                    <input type="hidden" name="delete_daily_backup_time" value="yes"/>
                                                    <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                                    <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                                    <input type="submit" value="Desactivar o cambiar la copia de seguridad diaria" />
                                                </form>
                                            {% endif %}

                                            <h3>Respaldar otros directorios y volúmenes de Docker del servidor</h3>
                                            <p>A continuación puede ingresar directorios y volúmenes de Docker del servidor que se respaldarán en el mismo archivo de copia de seguridad de borg. Después de cualquier cambio, no olvide pulsar el botón de enviar.</p>
                                            <form method="POST" action="api/configuration" class="xhr">
                                                <textarea id="additional_backup_directories" name="additional_backup_directories" rows="4" cols="50" placeholder="/directorio/en/el/servidor&#10;mi_volumen_docker">{{ additional_backup_directories }}</textarea>
                                                <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                                <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                                <input type="submit" value="Enviar las ubicaciones adicionales" />
                                            </form>
                                            <p>Cada línea debe comenzar con una barra o con una letra o dígito. Solo se permiten <strong>a-z</strong>, <strong>A-Z</strong>, <strong>.</strong>, <strong>0-9</strong>, <strong>_</strong>, <strong>-</strong> y <strong>/</strong>. Si la entrada comienza con una letra o dígito, no admite barras. Dos entradas válidas son <strong>/directorio/en/el/servidor</strong> y <strong>mi_volumen_docker</strong>. ¡Asegúrese de que todos los directorios indicados existan o el contenedor de copias de seguridad no podrá iniciarse!</p>
                                            <p>Indique por separado cada almacenamiento que desee respaldar, ya que no se montan de forma recursiva. Por ejemplo, si indica <strong>/</strong> como directorio adicional, solo se respaldarán los archivos y carpetas de la partición raíz, y no los de la partición EFI ni de ninguna otra. Las cachés y algunos otros directorios quedan excluidos. Si desea respaldar la partición raíz, detenga todos los servicios antes de la copia para que pueda hacerse correctamente. Para automatizarlo, vea <a target="_blank" href="https://github.com/nextcloud/all-in-one#how-to-stopstartupdate-containers-or-trigger-the-daily-backup-from-a-script-externally">esta documentación</a></p>
                                            <p>Tenga en cuenta que los directorios y volúmenes elegidos no se restauran al restaurar su instancia; eso debe hacerse manualmente.</p>
                                            {% if additional_backup_directories != "" %}
                                                <p>Esta opción está configurada. Para desactivarla, vacíe el campo y envíe los cambios.</p>
                                            {% endif %}
                                        {% endif %}

                                        <h3>Restablecer la ubicación de la copia de seguridad</h3>
                                        <p>
                                        Si la ubicación configurada en el servidor para las copias de seguridad, <strong>{{ borg_backup_host_location }}</strong>
                                        {% if borg_remote_repo %}
                                            o el repositorio remoto <strong>{{ borg_remote_repo }}</strong>
                                        {% endif %}
                                        es incorrecta, o si desea restablecer la ubicación de la copia de seguridad por otro motivo, puede hacerlo con el botón de abajo.
                                        </p>
                                        <form method="POST" action="api/docker/backup-reset-location" class="xhr">
                                            <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                            <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                            <input type="submit" value="Restablecer la ubicación de la copia de seguridad" data-confirm='¿Está seguro de que desea restablecer la ubicación de la copia de seguridad?' />
                                        </form>
                                    {% endif %}
                                    {% if has_backup_run_once == true %}
                                        </details>
                                    {% endif %}
                                {% endif %}
                            {% endif %}
                        {% endif %}

                        {% if is_backup_container_running == false %}
                            {% if isApacheStarting == false %}
                                {% if isAnyRunning == true %}
                                    <h2>Limpieza del sistema Docker</h2>
                                    <details>
                                        <summary>Haga clic aquí para mostrar el botón que limpia el sistema Docker.</summary>
                                        <p>Con el botón de abajo puede ejecutar «docker system prune -a». Esto eliminará las imágenes, contenedores, redes, volúmenes y caché de compilación que no se usen. No eliminará datos de los contenedores en ejecución.</p>
                                        <form method="POST" action="api/docker/prune" target="overlay-log">
                                            <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                            <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                            <input type="submit" value="Limpiar el sistema Docker" data-confirm="¿Ejecutar docker system prune -a? Esto eliminará las imágenes, contenedores, redes, volúmenes y caché de compilación que no se usen. No eliminará datos de los contenedores en ejecución. ¿Desea continuar?" />
                                        </form>
                                    </details>
                                {% endif %}
                                <h2>Cambio de la frase de contraseña de AIO</h2>
                                <details>
                                    <summary>Haga clic aquí para cambiar su frase de contraseña de AIO</summary>
                                    <p>Puede cambiar su frase de contraseña de AIO a continuación:</p>
                                    <form method="POST" action="api/configuration" class="xhr">
                                        <input type="password" autocomplete="current-password" name="current-master-password" placeholder="Su frase de contraseña actual de AIO" id="current-master-password" data-input-show-password>
                                        <input type="password" autocomplete="new-password" name="new-master-password" placeholder="Su nueva frase de contraseña de AIO" id="new-master-password" data-input-show-password>
                                        <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                        <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                        <input type="submit" value="Enviar el cambio de frase de contraseña" />
                                    </form>
                                    <p>La nueva frase de contraseña debe tener al menos 24 caracteres. Los caracteres permitidos son los <a target="_blank" href="https://en.wikipedia.org/wiki/Latin_alphabet#/media/File:Abecedarium.png"><strong>caracteres latinos</strong></a> <strong>a-z</strong>, <strong>A-Z</strong>, <strong>0-9</strong> y los <strong>espacios</strong>.</p>
                                </details>
                            {% endif %}
                        {% endif %}
                    {% endif %}
                    {% if is_backup_container_running == false %}

                        {{ include('includes/optional-containers.twig') }}

                        <h2>Cambio de zona horaria</h2>
                        {% if isAnyRunning == true %}
                            {% if timezone != "" %}
                                <p>La zona horaria de APS Conecta Gestión está configurada actualmente en <strong>{{ timezone }}</strong>.</p>
                            {% endif %}
                            <p><strong>Tenga en cuenta:</strong> puede cambiar la zona horaria cuando sus contenedores estén detenidos.</p>
                        {% else %}
                            {% if timezone == "" %}
                                <p>Para que ciertas funciones de APS Conecta Gestión muestren la hora correcta, configure la zona horaria que usan principalmente sus usuarios. Tenga en cuenta que esta configuración no se aplica al mastercontainer ni a ninguna opción de copia de seguridad.</p>
                                <p>Puede configurar a continuación la zona horaria de APS Conecta Gestión (¡no olvide enviar el valor!):</p>
                                <form method="POST" action="api/configuration" class="xhr">
                                    <input type="text" id="timezone" name="timezone" placeholder="America/Santiago" />
                                    <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                    <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                    <input type="submit" value="Enviar la zona horaria" data-confirm='¿Está seguro de que es una zona horaria válida? Verifíquela en el artículo de Wikipedia, en la columna correcta. Si la zona horaria no es válida, el inicio fallará porque la base de datos no se inicializará correctamente, y quedará en un ciclo de inicio.' />
                                </form>
                                <p>Debe asegurarse de que la zona horaria que ingrese sea válida. Un ejemplo es <strong>America/Santiago</strong>. Puede obtener valores válidos en la columna 'TZ identifier' de esta lista: <a target="_blank" href="https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List"><strong>haga clic aquí</strong></a>. Si no ingresa nada, se usa <strong>Etc/UTC</strong>.</p>
                            {% else %}
                                <p>La zona horaria de APS Conecta Gestión está configurada actualmente en <strong>{{ timezone }}</strong>. Puede cambiarla con el botón de abajo.</p>
                                <form method="POST" action="api/configuration" class="xhr">
                                    <input type="hidden" name="delete_timezone" value="yes"/>
                                    <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                                    <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                                    <input type="submit" value="Restablecer la zona horaria" />
                                </form>
                            {% endif %}
                        {% endif %}
                        {{ include('includes/community-containers.twig') }}
                    {% endif %}
                {% endif %}
            {% endif %}

        {% if isApacheStarting == true or is_backup_container_running == true or isWatchtowerRunning == true or is_daily_backup_running == true %}
            <script type="text/javascript" src="automatic_reload.js?v2"></script>
        {% else %}
            <script type="text/javascript" src="before-unload.js"></script>
        {% endif %}

        <script type="text/javascript" src="base_path.js"></script>

        </main>
    </div>
{% endblock %}
