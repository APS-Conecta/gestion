{# @var c \App\Containers\Container #}
<li>
  <span>
    {% if c.GetStartingState().value == 'starting' %}
      <span class="status running"></span>
      {{ c.displayName }}
      (<a href="log?id={{ c.identifier }}" target="_blank">Iniciando</a>)
    {% elseif c.GetRunningState().value == 'running' %}
      <span class="status success"></span>
      {{ c.displayName }}
      (<a href="log?id={{ c.identifier }}" target="_blank">En ejecución</a>)
    {% else %}
      <span class="status error"></span>
      {{ c.displayName }}
      (<a href="log?id={{ c.identifier }}" target="_blank">Detenido</a>)
    {% endif %}
    {% if c.documentation != '' %}
      (<a target="_blank" href="{{ c.documentation }}">documentación</a>)
    {% endif %}
    {% if c.GetUpdateState().value == 'different' %}
      ⚠️&nbsp;Actualización&nbsp;disponible
    {% endif %}
  </span>
  {% if c.GetUiSecret() != '' %}
    <details>
      <summary>Mostrar la contraseña de {{ c.displayName }}</summary>
      <input type="text" value="{{ c.GetUiSecret() }}" readonly>
    </details>
  {% endif %}
</li>
