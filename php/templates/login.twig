{% extends "layout.twig" %}

{% block body %}
    <div class="login">
        <svg class="nextcloud-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 142 100" width="142" height="100">
            <use href="img/logo.svg#logo"></use>
            <use href="img/logo.svg#wordmark"></use>
            <text x="10" y="50" fill="var(--color-nextcloud-logo)" class="fallback-text">Logotipo de APS Conecta Gestión</text>
        </svg>
        <h1>Inicio de sesión de APS Conecta Gestión AIO</h1>
        {% if is_login_allowed == true %}
            {% if login_unblocked_notice %}
                <p>{{ login_unblocked_notice }}</p>
            {% endif %}
            <p>Inicie sesión con su frase de contraseña de APS Conecta Gestión AIO:</p>
            <form method="POST" action="api/auth/login" class="xhr">
                <input type="password" autocomplete="current-password" name="password" placeholder="Contraseña" id="master-password" data-input-show-password>
                <input type="hidden" name="{{csrf.keys.name}}" value="{{csrf.name}}">
                <input type="hidden" name="{{csrf.keys.value}}" value="{{csrf.value}}">
                <input type="submit" class="button" value="Iniciar sesión" />
            </form>
        {% else %}
            <p>El inicio de sesión directo está bloqueado porque la suite está en ejecución.<br>Utilice el <strong>enlace de inicio de sesión</strong> desde la administración de APS Conecta Gestión para desbloquearlo.<br><br>
            Si eso no es posible, puede desbloquear el inicio de sesión directo ejecutando<br><strong>sudo docker stop aps-conecta-apache</strong></p>
        {% endif %}
    </div>
    <script type="text/javascript" src="before-unload.js"></script>
{% endblock %}
