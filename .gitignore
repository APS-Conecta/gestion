# Secrets / environment (never commit)
.env
.env.*
!.env.example

# Local data & Docker volumes (synthetic dev data only, never committed)
/data/
*.sqlite3

# apps/ is bind-mounted to custom_apps, so app-STORE apps (groupfolders, office connectors) install
# INTO it — don't commit their code. Only our scaffolding is tracked; un-ignore a real custom app
# explicitly with `!/apps/<app-id>/` when we ship one (v1 ships none — AD-1).
/apps/*
!/apps/.gitkeep
!/apps/README.md

# BMad: commit project config (_bmad/config.toml, _bmad/custom/config.toml),
# ignore personal answers + the regenerable engine skills (run `bmad install`).
_bmad/config.user.toml
_bmad/custom/config.user.toml
.claude/skills/

# IDE / OS
*.code-workspace
.DS_Store
