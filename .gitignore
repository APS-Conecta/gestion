.DS_Store

# Stray bytecode from running the repo's own python (the gates, the resolver): never tracked
__pycache__/
*.py[co]

/php/data/*
/php/session/*
!/php/data/.gitkeep
!/php/session/.gitkeep
/php/vendor

# Per-install artifacts: the env file and its secrets, the generated site trees beside the DEIS
# register, and the site CSS phase 15 writes.
.env
.env.*
!.env.example
/sites/*/
/sites/*.txt
/themes/apsconecta/core/css/site.css
