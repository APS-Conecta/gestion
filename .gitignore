# Secrets / environment (never commit)
.env
.env.*
!.env.example

# Belt and braces: the generator was deleted 2026-07-29, but if anyone hand-writes a secrets
# sheet here it must never be committed. .githooks/pre-commit blocks it too.
/CREDENTIALS.local.md

# Local data & Docker volumes (synthetic dev data only, never committed)
/data/
*.sqlite3

# apps/ is bind-mounted to custom_apps, so app-STORE apps (groupfolders, office connectors) install
# INTO it — don't commit their code. Only our scaffolding is tracked; un-ignore a real custom app
# explicitly with `!/apps/<app-id>/` when we ship one (v1 ships none — AD-1).
/apps/*
!/apps/README.md

# Local agent tooling (regenerable, never committed)
.claude/skills/

# Python bytecode — themes/apsconecta/tools/ is a one-shot art generator, not a package
__pycache__/
*.pyc

# IDE / OS
*.code-workspace
.DS_Store

# `make install` writes the full provisioning log here.
.install.log
