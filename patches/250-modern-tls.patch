diff --git a/Containers/apache/start.sh b/Containers/apache/start.sh
index 9677132..be4e5a0 100644
--- a/Containers/apache/start.sh
+++ b/Containers/apache/start.sh
@@ -97,6 +97,13 @@ fi
 CADDYFILE="$(sed -e "s|# tls placeholder|$TLS_STANZA|" -e "s|# default_sni placeholder|$DEFAULT_SNI|" /tmp/Caddyfile)"
 echo "$CADDYFILE" > /tmp/Caddyfile
 
+# APS: modern TLS only, pinned in the ACME stanza. Only on 443: behind a reverse proxy the site is plain
+# http, and Caddy refuses TLS connection policies on an http server, so apache would not start at all.
+if [ "$APACHE_PORT" = '443' ]; then
+    CADDYFILE="$(sed 's|issuer acme {|protocols tls1.2 tls1.3\n\t\tissuer acme {|' /tmp/Caddyfile)"
+    echo "$CADDYFILE" > /tmp/Caddyfile
+fi
+
 # Fix the Caddyfile format
 caddy fmt --overwrite /tmp/Caddyfile
 
diff --git a/Containers/mastercontainer/acme.Caddyfile b/Containers/mastercontainer/acme.Caddyfile
index f6be701..865652d 100644
--- a/Containers/mastercontainer/acme.Caddyfile
+++ b/Containers/mastercontainer/acme.Caddyfile
@@ -44,6 +44,7 @@ https://:8443 {
 	file_server
 
 	tls {
+		protocols tls1.2 tls1.3
 		on_demand
 		issuer acme {
             profile shortlived
