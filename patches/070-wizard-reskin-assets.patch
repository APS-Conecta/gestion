diff --git a/php/public/img/logo.svg b/php/public/img/logo.svg
new file mode 100644
index 00000000..7bc0fc14
--- /dev/null
+++ b/php/public/img/logo.svg
@@ -0,0 +1,29 @@
+<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 142 100" width="142" height="100" role="img" aria-label="APS Conecta AIO">
+  <!-- The fork's wizard lockup (patch 070). Geometry contract: the big views (setup, login,
+       already-installed) render BOTH ids inside a 142x100 viewBox; the containers header
+       renders only id="logo" inside a 142x71 crop, so everything the header must show lives
+       above y=71. The mark is currentColor-driven like upstream's circles were: the
+       .nextcloud-logo rule colors it violet over the white login card, the .logo header rule
+       colors it white over the violet background, and the Ofiuco wave and star keep the
+       brand orange, which reads on both surfaces. The wordmark is live text over embedded
+       OFL subsets of the same fonts the page ships (the house lockup pattern, gestion
+       logo.svg) so this file never fetches anything and never depends on page fonts. -->
+  <style>
+    @font-face { font-family:"Fraunces"; font-style:normal; font-weight:600;
+      src:url("data:font/woff2;base64,") format("woff2"); }
+    @font-face { font-family:"Nunito Sans"; font-style:normal; font-weight:700;
+      src:url("data:font/woff2;base64,") format("woff2"); }
+  </style>
+  <g id="logo" transform="translate(39 2) scale(1.15)">
+    <path d="M32 12 L45 23 M32 12 L19 23 M45 23 L38 39 M19 23 L26 39 M38 39 L26 39 M38 39 L45 51 M26 39 L19 51" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"></path>
+    <path d="M11 33 Q23 27 32 33 T53 30" fill="none" stroke="#f28f36" stroke-width="2" stroke-linecap="round"></path>
+    <circle cx="45" cy="23" r="2.5" fill="currentColor"></circle><circle cx="19" cy="23" r="2.5" fill="currentColor"></circle>
+    <circle cx="38" cy="39" r="2.3" fill="currentColor"></circle><circle cx="26" cy="39" r="2.3" fill="currentColor"></circle>
+    <circle cx="45" cy="51" r="2.1" fill="currentColor"></circle><circle cx="19" cy="51" r="2.1" fill="currentColor"></circle>
+    <path d="M32 7.2 L33.25 10.75 L36.8 12 L33.25 13.25 L32 16.8 L30.75 13.25 L27.2 12 L30.75 10.75 Z" fill="#f28f36"></path>
+  </g>
+  <g id="wordmark">
+    <text x="71" y="84" text-anchor="middle" font-family="Fraunces" font-weight="600" font-size="21.0" fill="#5315a8">APS Conecta</text>
+    <text x="72.5" y="96.5" text-anchor="middle" font-family="Nunito Sans" font-weight="700" font-size="10.5" letter-spacing="3" fill="#485363">AIO</text>
+  </g>
+</svg>
