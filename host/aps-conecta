  rm -f "$act/plan-mala"
  # the preconditions, each its own refusal with its own remedy
  : > "$act/resolver.log"
  out="$( id() { echo 1000; }; act46 2>&1 )"; arc=$?
  check "actualizar: without root it refuses before anything else" \
    '[ "$arc" -eq 1 ] && case "$out" in *"✗ actualizar necesita permisos de administrador"*"sudo aps-conecta actualizar"*) ;; *) false;; esac \
      && [ ! -s "$act/resolver.log" ]'
  out="$( id() { echo 0; }; ACT_LOCK="$act/home/ninguno.json" act46 --revisar 2>&1 )"; arc=$?
  check "actualizar: no lock is a refusal naming the record and its writer" \
    '[ "$arc" -eq 1 ] && case "$out" in *"✗ no hay candado de aplicaciones"*"sudo aps-conecta provision"*) ;; *) false;; esac \
      && [ ! -s "$act/resolver.log" ]'
  out="$( id() { echo 0; }; touch "$act/suite-caida"; act46 --revisar 2>&1 )"; arc=$?; rm -f "$act/suite-caida"
  check "actualizar: a suite not running refuses naming the six" \
    '[ "$arc" -eq 1 ] && case "$out" in *"✗ la suite no está en marcha (0 de $AIO_EXPECTED contenedores)"*"aps-conecta preflight"*) ;; *) false;; esac'
  out="$( id() { echo 0; }; touch "$act/sin-respaldo"; act46 --revisar 2>&1 )"; arc=$?; rm -f "$act/sin-respaldo"
  check "actualizar: an unconfigured backup refuses — the run backs up first, so this is a precondition, never a surprise" \
    '[ "$arc" -eq 1 ] && case "$out" in *"✗ el respaldo de la instancia no está configurado"*"asistente-aio --respaldo"*) ;; *) false;; esac'

  # the whole run: the real legs against the shims — plan, backup, restart, fetch, the real
  # provisioning tree applying from the NEW lock, the scoped store update, the promote, the
  # revalidate sweep
  : > "$act/aio.log"; : > "$act/resolver.log"; : > "$act/docker.log"
  rm -f "$act/aio.libre" "$act/apache.n" "$act/salud.n"   # a fresh session: the wizard's block is back, the suite not yet ready
  out="$( id() { echo 0; }; act46 2>&1 )"; arc=$?
  check "actualizar: the whole run in order — plan, preconditions, backup, restart, fetch, apply from the new lock, scoped store update, store closed, promote, revalidate" \
    '[ "$arc" -eq 0 ] && printf "%s" "$out" | grep -qF "Plan de actualización — Nextcloud 34.0.4" \
