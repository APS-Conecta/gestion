  printf '#!/usr/bin/env bash\nexit 0\n' > "$tshim/ss"; chmod +x "$tshim/ss"
  printf '#!/usr/bin/env bash\nexit 0\n' > "$tshim/curl"; chmod +x "$tshim/curl"
  out="$(check_prov_ports)"
  check "prov-ports: the free chain prints its INFO" 'case "$out" in *"cadena del provisionador libre"*) ;; *) false;; esac'
  printf '#!/usr/bin/env bash\nif [ "$2" = "sport = :8081" ]; then echo "State"; echo "LISTEN 0 0 *:8081"; fi\nexit 0\n' > "$tshim/ss"; chmod +x "$tshim/ss"
  out="$(check_prov_ports)"
