if [ "${!#}" = "$CASE_DOCKER_ROOT" ]; then echo 5; else echo 999; fi
SH
  cat > "$preflight_case/bin/ss" <<'SH'
#!/usr/bin/env bash
if [ "${CASE_ORPHAN:-0}" = 1 ] && [ "$2" = 'sport = :8080' ]; then
  printf 'State Recv-Q\nLISTEN 0 0 *:8080\n'
fi
SH
  printf '#!/bin/sh\nexit 0\n' > "$preflight_case/bin/systemctl"
  printf '#!/bin/sh\necho x86_64\n' > "$preflight_case/bin/uname"
  printf '#!/bin/sh\nexit 1\n' > "$preflight_case/bin/stat"
  chmod +x "$preflight_case/bin/"*
  local case_path="$preflight_case/bin:$PATH"
  out="$(PATH="$case_path" CASE_ORPHAN=1 APS_HOME="$preflight_case/missing"; export PATH CASE_ORPHAN APS_HOME; FAIL=0; check_ports; echo "FAIL=$FAIL")"
  check "preflight: suite-owned ports never excuse an orphan without its installation folder" \
    'case "$out" in *"✗ "*"instalación"*"FAIL=1") ;; *) false;; esac'
  out="$(PATH="$case_path"; export PATH; FAIL=0; check_ram() { :; }; check_cpu() { :; }; check_disk() { :; }; check_ports() { :; }; check_network() { :; }; step_revisar; echo "FAIL=$FAIL")"
  check "preflight: missing FUSE refuses before preparing the host" \
    'case "$out" in *"✗ "*"/dev/fuse"*"FAIL=1") ;; *) false;; esac'
  out="$(PATH="$case_path" CASE_DOCKER_ROOT=/var/snap/docker/common/var-lib-docker; export PATH CASE_DOCKER_ROOT; FAIL=0; install_docker; echo "FAIL=$FAIL")"
  check "preflight: an installed Snap Docker is refused rather than accepted" \
    'case "$out" in *"✗ "*"Snap"*"FAIL=1") ;; *) false;; esac'
  out="$(PATH="$case_path" CASE_ROOT="$preflight_case" CASE_DOCKER_ROOT="$preflight_case/data"; export PATH CASE_ROOT CASE_DOCKER_ROOT; FAIL=0; check_disk; echo "FAIL=$FAIL")"
  check "preflight: disk space is measured on the active Docker data root" \
    'case "$out" in *"✗ Disco 5 GB libres"*"FAIL=1") ;; *) false;; esac && grep -qF -- "$preflight_case/data" "$preflight_case/df.calls"'

  ROOT="$ROOT_BAK"
  rm -rf "$tmp"
  echo
  echo "self-test: $n checks OK"
  [ "$FAILED" -eq 0 ] || { echo "self-test: $FAILED FAILED" >&2; exit 1; }
  return 0
}

# ── dispatch ──────────────────────────────────────────────────────────────────────────────

case "${1:-}" in
  --self-test|guard-existing-installation|--help|-h|""|estado|pasos|run-command) ;;
  *) proxy_load || exit 1 ;;
esac

case "${1:-}" in
  proxy-save)   proxy_save ;;
  install)      shift; cmd_install "$@" ;;
  preflight)    shift; cmd_preflight "$@" ;;
  guard-existing-installation) check_existing_installation ;;
  run-command)  run_command "${2:-}" ;;
  provision)    shift; cmd_provision "${1:-}" ;;
  asistente-aio) shift; cmd_aio_wizard "$@" ;;
  temporizadores) FAIL=0; install_timers; [ "$FAIL" -eq 0 ] || exit 1 ;;
  estado)       cmd_estado ;;
  pasos)        cmd_pasos ;;
  revalidate)   cmd_revalidate ;;
  actualizar)   shift; cmd_actualizar "$@" ;;
  red)          shift; cmd_red "$@" ;;
  datos)        shift; cmd_datos "$@" ;;
  --self-test)  selftest ;;
  ""|-h|--help) usage ;;
  *)            # a step answers by its registry id — the list is the only place a step is named
                if step="$(step_number "$1")"; then
                  if [ "$(step_field "$step" 3)" = servidor ]; then
                    step_run "$step" "aps-conecta $1" || exit 1
                  else
                    step_browser "$step"
                  fi
                else
                  usage; echo; echo "✗ subcomando desconocido: $1" >&2; exit 2
                fi ;;
esac
