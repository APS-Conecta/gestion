      *"config:app:get calendar"*) echo "4.7.15" ;;
      *"config:system:get appstoreenabled"*)
        [ ! -e "$act/store-state-read-failed" ] || exit 1
        [ ! -e "$act/store-state-empty" ] || exit 0
        echo "\${TIENDA:-0}" ;;
      *"occ app:enable territorio"*) if [ -e "$act/enable-failed" ]; then echo "synthetic enable failure"; exit 1; fi ;;
