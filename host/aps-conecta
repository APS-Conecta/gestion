  welcome_out="$(welcome)"
  check "welcome: name, version, the eight-step promise, the motto, the licence with the source, the credit" \
    'case "$welcome_out" in *"APS Conecta Gestión   Instalador v9.9.9"*"en 8 pasos: 4 en este servidor, 4 en el navegador"*"«La salud primaria que compartimos es la que mejora»"*"AGPL-3.0-or-later · github.com/APS-Conecta/gestion"*"Desarrollado por Dani Espinoza Charrier · APS Conecta"*) ;; *) false;; esac'
  check "welcome: the motto is phase 15's theming slogan (one string, two homes, pinned)" \
    'grep -F "\"$MOTTO\"" "$ROOT_BAK/provisioning/phases/15-branding.sh" | grep -q "theming_set slogan"'

