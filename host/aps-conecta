    'case "$out" in *"ocupado por otro servicio"*) ;; *) false;; esac'
  cat > "$tshim/curl" <<'CSHIM'
#!/usr/bin/env bash
printf '{"servicio": "Provisionador APS Conecta", "estado": "listo", "registro": "2026-07-23", "establecimientos": 2655}'
CSHIM
  chmod +x "$tshim/curl"
  out="$(check_prov_ports)"
  check "prov-ports: a running provisionador is recognized via GET / (the routed liveness probe)" \
    'case "$out" in *"un provisionador ya corre ahí"*"GET / responde"*) ;; *) false;; esac'

  # the hairpin probes: green pair and the #8433 red with R4's recorded recipe
  printf '#!/usr/bin/env bash\nif [ "$1" = ps ]; then echo nextcloud-aio-apache; exit 0; fi\nexit 0\n' > "$tshim/docker"; chmod +x "$tshim/docker"
  out="$(check_hairpin)"
