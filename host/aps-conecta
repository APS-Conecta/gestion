  printf '#!/usr/bin/env bash\nexit 1\n' > "$tshim/curl"; chmod +x "$tshim/curl"
  out="$(check_hairpin)"
  check "hairpin: the #8433 red carries R4's ufw recipe and the split-DNS legs, and never SKIP_DOMAIN_VALIDATION as advice" \
    'case "$out" in *"172.18.0.0/16"*"dnsmasq"*"daemon.json"*"NO use SKIP_DOMAIN_VALIDATION"*) ;; *) false;; esac'

  # ── respaldo: idempotent via the mastercontainer's own file ──
  : > "$tmp/mc-additional"
  cat > "$tshim/docker" <<'DSHIM'
