# ── the run-command generator ─────────────────────────────────────────────────────────────
# ONE source. preflight prints it, INSTALLER.md quotes it, the operator pastes it. The tag is
# the gestion release this checkout ships as (D12: suite tag = gestion release tag); override
# with APS_SUITE_TAG only for rehearsed installs (the migration window, slice 22's rehearsal).

suite_tag() {
  if [ -n "${APS_SUITE_TAG:-}" ]; then printf '%s' "$APS_SUITE_TAG"; return; fi
  git -C "$ROOT" describe --tags --abbrev=0 2>/dev/null && return
  echo ""
}

run_command() {  # prints the operator's docker run string (never executes it)
  local tag; tag="$(suite_tag)"
  [ -n "$tag" ] || die "no pude leer la etiqueta de versión (¿git tags?) — o exporte APS_SUITE_TAG"
  cat <<EOF
docker run --init --sig-proxy=false --name nextcloud-aio-mastercontainer \\
  --restart always \\
  --publish 8080:8080 \\
  --env APACHE_PORT=443 \\
  --env NEXTCLOUD_STARTUP_APPS="" \\
  --volume nextcloud_aio_mastercontainer:/mnt/docker-aio-config \\
  --volume /var/run/docker.sock:/var/run/docker.sock:ro \\
  ghcr.io/aps-conecta/all-in-one:$tag
EOF
}

# NEXTCLOUD_STARTUP_APPS is deliberately EMPTY, not absent: the apps and the theme are baked
# into the image (D4), so boot-time app:install attempts would be noise at every fresh start —
# and an empty value is also the verified way past the mastercontainer's [ -n ]-gated charset
# validator (start.sh:291-298). Both facts are the slice-5 amendment's own finding (the ratified
# forced amendment, ledgered in its History row).

# ── provision ─────────────────────────────────────────────────────────────────────────────

cmd_provision() {  # [--reponer]
  if [ "${1:-}" = "--reponer" ]; then reponer; return; fi
  # Interactive: the Provisionador's banner is the operator's only copy of URL + token, its
  # stdout is line-buffered (slice 14) and the URL now lands on the login screen (slice 17).
  # exec — one process, no wrapper to wedge between the operator and Ctrl+C.
  exec python3 "$(prov_path)"
}

banner_read() {  # FD — the REAL banner() shape (slice 14's locked bytes, unchanged by 17):
  #   ✓ Provisionador APS Conecta
  #     Registro DEIS: instantánea … (N establecimientos)
  #     Abra http://127.0.0.1:PORT — desde otro equipo de la red, …
  #     Token de acceso ( cópielo en la pantalla de inicio ):
  #       <64 hex>
  # The URL rides the «Abra» line; the token is the line AFTER the «Token de acceso» label.
  # Bounded: 30 s, no unbounded hang (B-015).
  local fd="$1" deadline=$((SECONDS + 30)) url="" tok="" ln seen_label=0
  while :; do
    # (plan-local fix, Step 5: read moves into the body — its timeout return must not fail
    #  the loop condition, or the first silent second ends the read and the 30 s deadline
    #  is dead code; silent seconds are tolerated, the deadline is the only exit)
    IFS= read -r -t 1 -u "$fd" ln || { [ "$SECONDS" -ge "$deadline" ] && return 1; continue; }
    if [ "$seen_label" -eq 1 ]; then
      tok="$(printf '%s' "$ln" | tr -d '[:space:]')"
      seen_label=0
      if [ -n "$url" ] && [ "${#tok}" -eq 64 ]; then
        printf '%s\n%s' "$url" "$tok"; return 0
      fi
    fi
    case "$ln" in
      *"Abra http://127.0.0.1:"*)
        url="http://127.0.0.1:${ln#*http://127.0.0.1:}"; url="${url%% *}" ;;
      *"Token de acceso"*) seen_label=1 ;;
    esac
    [ "$SECONDS" -ge "$deadline" ] && return 1
  done <&"$fd"
  return 1
}

site_codigo() {  # the site directory IS the DEIS codigo (slice 14: sites/<codigo>/site.sh)
  local f; f="$(site_file)"
  case "$f" in
    "") echo ""; return 1 ;;
    "MÁS DE UN SITIO") echo ""; return 1 ;;
    *) basename "$(dirname "$f")" ;;
  esac
}

reponer() {  # the weekly headless re-provision (the timer's whole job): start the
  # Provisionador, read its banner, POST modo=ejecutar, print the run + the gate verdict,
  # exit the gate's code — drift self-healing or a loud red, never a silent no-op.
  local codigo; codigo="$(site_codigo)" || true
  if [ -z "$codigo" ]; then
    die "no hay un único sitio en sites/ (una instalación sirve a un solo establecimiento) — elija el centro en el instalador web primero"
  fi
  local fifo provpid
  fifo="$(mktemp -u)"; mkfifo "$fifo"
  python3 "$(prov_path)" > "$fifo" 2>&1 & provpid=$!
  exec 3< "$fifo"
  local _b=() url tok
  readarray -t _b < <(banner_read 3)
  if [ "${#_b[@]}" -ne 2 ]; then
    exec 3>&-; kill "$provpid" 2>/dev/null; rm -f "$fifo"
    die "no leí el banner del provisionador (30 s — ¿arrancó python3?)"
  fi
  url="${_b[0]}"; tok="${_b[1]}"
  info "re-provisión semanal: modo=ejecutar para $codigo (token leído del banner — no se imprime)"
  local body code
  # read_json is JSON-only (provisionador.py:1477-1481 — a form-encoded body 400s), and
  # api_generar reads {"codigo", "modo"} from the decoded object — the locked contract
  body="$(curl -s -m 1800 -w '\n%{http_code}' \
    -H "Authorization: Bearer $tok" \
    -H 'Content-Type: application/json' \
    --data "$(printf '{"codigo": "%s", "modo": "ejecutar"}' "$codigo")" \
    "$url/api/generar" 2>/dev/null)" ; code="${body##*$'\n'}"
  exec 3>&- ; kill "$provpid" 2>/dev/null; rm -f "$fifo"
  # WHERE never WHAT: the token was used in the header; nothing here echoes it.
  if [ "$code" = "200" ]; then
    local vacia
    vacia="$(printf '%s' "$body" | head -n -1 | grep -oP '"divergencia_vacia":\s*\K(true|false)' || true)"
    printf '%s\n' "$(printf '%s' "$body" | head -n -1)"
    if [ "$vacia" = "true" ]; then
      ok "divergencia vacía — la re-provisión semanal no encontró deriva"
      exit 0
    fi
    bad "divergencia NO vacía — la deriva semanal se muestra arriba" \
      "revise el informe; «aps-conecta provision» abre el provisionador para corregir"
    exit 1
  fi
  bad "la ejecución falló (HTTP $code)" "el detalle llega arriba — cada fase nombra su propio error"
  exit 1
}

# ── respaldo ───────────────────────────────────────────────────────────────────────────────

cmd_respaldo() {  # wire /opt/aps-conecta into AIO's backup scope — idempotent, via the
  # mastercontainer's own data file: GetDataDirectory() is /mnt/docker-aio-config/data/
  # (php/src/Data/DataConst.php:6-13 — start.sh:406 mkdirs it every start), so the file is
  # /mnt/docker-aio-config/data/additional_backup_directories, one path per line
  # (DataConst.php:39-40; the wizard's backup form loads the same file, so the line survives
  # a later form save).
  local target=/opt/aps-conecta mc=nextcloud-aio-mastercontainer
  local datafile=/mnt/docker-aio-config/data/additional_backup_directories
  if ! docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "$mc"; then
    die "el mastercontainer ($mc) no está corriendo — el wiring va después del asistente"
  fi
  if docker exec "$mc" sh -c "grep -qxF '$target' '$datafile' 2>/dev/null"; then
    ok "$target ya está en el alcance de las copias de seguridad"
  else
    docker exec "$mc" sh -c "echo '$target' >> '$datafile'" \
      || die "no pude escribir el alcance en el mastercontainer"
    ok "$target agregado al alcance de las copias de seguridad"
  fi
  info "ojo: los directorios adicionales se RESPALDAN pero no se restauran junto con la instancia (comportamiento propio de AIO, documentado en el asistente) — /opt/aps-conecta se restaura a mano desde el archivo borg"
}

# ── revalidate ─────────────────────────────────────────────────────────────────────────────

cmd_revalidate() {  # post-update: run every read-only gate against the running instance
  # The FRD S8's post-update revalidation suite. WHEN the operator runs it: right after the
  # clinic's stack moves — a new suite tag on purpose (D12: a published tag's digests never
  # move, so an update IS a deliberate new-tag run) or a container reboot. The three gates are
  # the read-only half of this program's gate stack: smoke (the 14 core invariants),
  # office-smoke (the office wire: public-path healthcheck + --check + the 9.3.x pin), and
  # divergence --gate (live state vs the declared set — the handoff contract the executor and
  # the weekly timer already ride). All three are read-only by their locked contracts, so this
  # arm never writes — the --reponer timer owns convergence; revalidate only measures.
  # ALL THREE run, first-fail is not the shape: after an update, clinic IT needs the complete
  # picture (WHICH gates are red), not the first one (test.sh's aggregation lesson). The exit
  # code is the aggregate — 0 iff all three green — the same verdict shape --reponer exits, so
  # a red revalidate reads identically to a red weekly unit wherever operators look.
  local rc=0 out st name
  for name in smoke office-smoke divergence-gate; do
    case "$name" in
      smoke)           out="$(bash "$ROOT/scripts/smoke.sh" 2>&1)"; st=$? ;;
      office-smoke)    out="$(bash "$ROOT/scripts/office-smoke.sh" 2>&1)"; st=$? ;;
      divergence-gate) out="$(bash "$ROOT/scripts/divergence.sh" --gate 2>&1)"; st=$? ;;
    esac
    if [ "$st" -eq 0 ]; then
      printf '  ✓ %s — %s\n' "$name" "$(printf '%s\n' "$out" | tail -1)"
    else
      printf '  ✗ %s — el detalle completo:\n' "$name"
      printf '%s\n' "$out"
      rc=1
    fi
  done
  if [ "$rc" -eq 0 ]; then
    echo "REVALIDACIÓN: PASS — humo ✓, oficina ✓, divergencia vacía ✓ (la instancia sigue convergida)"
  else
    echo "REVALIDACIÓN: FAIL — lo de arriba quedó tras la actualización; «aps-conecta provision» re-converge el estado declarado, y el informe de divergencia nombra el resto" >&2
  fi
  return "$rc"
}

