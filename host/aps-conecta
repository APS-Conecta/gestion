  : > "$act/aio.log"; : > "$act/resolver.log"; cp "$act/lock.bytes" "$act/home/apps.lock.json"
  rm -f "$act/aio.libre"   # a fresh session: the wizard's block is back
  out="$( id() { echo 0; }; BORG_EXIT=1 act46 2>&1 )"; arc=$?
  check "actualizar: a failed backup stops the run before anything is fetched or applied — the borg code named, the remedy docker logs" \
    '[ "$arc" -eq 1 ] && printf "%s" "$out" | grep -qF "✗ el respaldo falló (contenedor de respaldo: código 1) — nada se aplicó, el candado no cambió" \
      && printf "%s" "$out" | grep -qF "docker logs aps-conecta-borgbackup" \
      && ! grep -q "^actualizar " "$act/resolver.log" && cmp -s "$act/home/apps.lock.json" "$act/lock.bytes" \
