               [[ "$2" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] \
                 || die "dominio no válido: $2 (solo letras, números, puntos y guiones)"
               PREFLIGHT_DOMAIN="$2" ;;
    *) die "opción desconocida: $1 — uso: aps-conecta preflight [--dominio <dominio>]" ;;
  esac
  echo "Revisión previa del instalador APS Conecta"
  # bash checks itself (this script IS bash); the rest are real prerequisites
  need_tool git; need_tool python3; need_tool curl; need_tool docker
  check_docker; check_compose; check_ports; check_dns; check_arch; check_prov_ports
  check_hairpin
  echo
  if [ "$FAIL" -gt 0 ]; then
