  check "install --sitio: a quoted SITE_DEIS, an empty SITE_DOMINIO or a planilla without its header refuses before step 1" \
    'case "$pre1" in *"SITE_DEIS=<código DEIS> (sin comillas)"*) ;; *) false;; esac && case "$pre2" in *"SITE_DOMINIO="*) ;; *) false;; esac && case "$pre3" in *"cabecera usuario;nombre;apellidos;correo;grupos;primer_admin"*) ;; *) false;; esac && case "$pre1$pre2$pre3" in *"Paso 1"*) false;; *) true;; esac'
  install_out="$(
    step_revisar()   { ok "revisar-stub"; echo "Pulling from somewhere" >&2; }
    step_preparar()  { ok "preparar-stub"; }
    step_descargar() { ok "descargar-stub"; }
    silent_centro()  { ok "centro-stub"; }
    silent_suite()   { ok "suite-stub"; }
    silent_equipos() { ok "equipos-stub"; }
    silent_ejecutar() { ok "ejecutar-stub"; }
    install_timers() { ok "temporizadores-stub"; }
    cmd_datos()      { ok "datos-stub"; }   # the tail's one real leg, stubbed like the D9 arms:
    #                                  without it the arm's verdict depends on whether a real
    #                                  aps-conecta-nextcloud answers on THIS box — hermeticity
    id() { echo "${ID_U:-0}"; }   # hash-proof: bash's command hash can reroute a PATH shim to the real uid (CI = 1001) — a function cannot be rerouted
    cmd_install --sitio "$tmp/dado.sh" --planilla "$tmp/dado.csv" </dev/null 2>&1
  )"; rcs=$?
  local credentials_command
