  out="$( id() { echo 0; }; BORG_STARTED=2020-01-01T00:00:00Z act46 2>&1 )"; arc=$?
  check "actualizar: a borg that did not start anew (StartedAt before the request) is no backup — no restart, no fetch, the lock unchanged (A-036)" \
    '[ "$arc" -eq 1 ] && printf "%s" "$out" | grep -qF "✗ el asistente no arrancó un respaldo nuevo — nada se aplicó, el candado no cambió" \
      && ! grep -q "api/docker/start" "$act/aio.log" && ! grep -q "^actualizar " "$act/resolver.log" \
      && cmp -s "$act/home/apps.lock.json" "$act/lock.bytes"'
  : > "$act/aio.log"; : > "$act/resolver.log"; rm -f "$act/aio.libre"; cp "$act/lock.bytes" "$act/home/apps.lock.json"
  out="$( id() { echo 0; }; BORG_RUNS=999 AIO_RESPALDO_POLLS=3 act46 2>&1 )"; arc=$?
  check "actualizar: a backup still running at the bound stops the run — the suite left stopped, borg's log and the wizard named, no restart (A-036)" \
    '[ "$arc" -eq 1 ] && printf "%s" "$out" | grep -qF "✗ el respaldo sigue en curso tras 90 minutos — la suite queda detenida; nada se aplicó, el candado no cambió" \
      && printf "%s" "$out" | grep -qF "docker logs -f aps-conecta-borgbackup" \
      && ! grep -q "api/docker/start" "$act/aio.log" && ! grep -q "^actualizar " "$act/resolver.log" \
