site_comuna_cut() {  # the site record's own CUT (v0.2.0's seam — deis.py emits it post-v0.2.0)
  local f; f="$(site_file)"
  case "$f" in "" | "MÁS DE UN SITIO") return 1 ;; esac
  grep -m1 '^SITE_COMUNA_CUT=' "$f" 2>/dev/null | sed 's/^SITE_COMUNA_CUT=//' || true
}

cmd_datos() {  # [CUT] — S9's data-package leg: the national masters, sha256-verified, cut to
  # THIS install's comuna, staged durably, with the AIO import translation printed. Thin on
  # purpose: scripts/comuna-package.sh (v0.2.0's slice-11 artifact) owns the fetch-verify
  # and the cut — this arm resolves the CUT, stages the output, and translates the import
  # form. It never imports: the import is a deliberate operator paste with the backup step
  # visible beside it (IMPORT_DESIGN's own rule: pg_dump beforehand, revert from the
  # browser, ADR-0009) — an install-time auto-import would bypass every one of those
  # disciplines.
  local cut="${1:-}"
  # Territorio is S12-gated: at v1.0 the app is not baked and the wizard's own card says
  # «pendiente de empaquetado». Nothing can receive the data — the honest skip, never a
  # silent fetch of ~93 MB of masters for an app that cannot import (the office-skip
  # precedent: visible, exit 0, no work done).
  if ! docker exec "$NC" sh -c 'test -d /var/www/html/custom_apps/territorio' >/dev/null 2>&1; then
    info "territorio: pendiente de empaquetado (la tarjeta del asistente lo dice) — este comando no descarga nada"
    info "cuando territorio esté disponible, re-ejecute «aps-conecta datos»: traerá y verificará los paquetes de su comuna"
    return 0
  fi
  if [ -z "$cut" ]; then
    cut="$(site_comuna_cut || true)"
    [ -n "$cut" ] || die "el registro del sitio no trae SITE_COMUNA_CUT — regenere el sitio con el provisionador (lo escribe desde v0.2.0)"
  fi
  local stage="$DATOS_HOME/$cut"
  mkdir -p "$stage" || die "no pude crear $stage"
  info "cortando los paquetes de la comuna $cut (maestros nacionales, sha256 verificado por comuna-package.sh — la primera vez descarga ~93 MB)"
  # WORK_DIR: the routed v0.2.0 amendment — without it comuna-package.sh's EXIT-trap kills
  # the cuts with the child, and its own closing line ("import them, then remove") promises
  # a persistence the trap denies (the design-time find, its own criteria row). Staged here,
  # the cuts survive for the docker cp the AIO form needs.
  if ! WORK_DIR="$stage" bash "$ROOT/scripts/comuna-package.sh" "$cut"; then
    die "comuna-package falló — arriba queda el canal que quebró (un maestro que se movió se re-registra por edición, nunca se corta a ciegas)"
  fi
  echo
  echo "los paquetes quedaron bajo $stage (impórtelos y luego elimínelos). Bajo AIO, cada comando «occ territorio:import …» que comuna-package.sh imprimió arriba se ejecuta así:"
  local f base
  while IFS= read -r f; do
    base="$(basename "$f")"
    echo "  1. docker cp '$f' $NC:/tmp/"
    echo "  2. docker exec -u www-data $NC php /var/www/html/occ territorio:import '/tmp/$base' …(los argumentos que comuna-package.sh imprimió)"
    echo "  3. docker exec $NC rm -f '/tmp/$base'"
  done < <(find "$stage" -type f -name '*.geojson' | sort)
  echo
  info "re-importar el MISMO archivo imprime «created: 0» — si crea filas, el esquema uid quebró (territorio IMPORT_DESIGN, regla 6): deténgase y corríjalo"
  info "antes del primer import tome su respaldo habitual — cada import queda revertible desde el navegador del administrador (ADR-0009 de territorio)"
}

