  chmod +x "$droot/scripts/comuna-package.sh"
  # ── arm 1: territorio absent (v1.0's own posture) → the pending skip, ZERO channel work
  printf '#!/usr/bin/env bash\nexit 1\n' > "$tshim/docker"; chmod +x "$tshim/docker"  # exec → test -d fails: no app
  : > "$dlog"
  local dout drc
  dout="$(ROOT="$droot" DATOS_HOME="$tmp/datos" cmd_datos 2>&1)"; drc=$?
  check "datos: territorio ausente → la postura pendiente, exit 0, y comuna-package JAMÁS corrió (nada se descarga)" \
    '[ "$drc" -eq 0 ] && [ ! -s "$dlog" ] \
     && case "$dout" in *"pendiente de empaquetado"*"no descarga nada"*) ;; *) false;; esac'
