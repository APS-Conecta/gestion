  check "usage (a5): generated Spanish, every step listed, no source header, no internal id, no English word" \
    '[ -n "$out" ] && ! printf "%s\n" "$out" | grep -qE "$a5_ids" && ! printf "%s\n" "$out" | grep -qiwE "$a5_en" && case "$out" in *"aps-conecta revisar"*"aps-conecta ejecutar"*) ;; *) false;; esac'
  mk_docker 1.56 ""
  out="$( (cmd_preflight) 2>&1)"
  check "preflight (a5): a whole run is Spanish, with no internal id and no English word" \
    '[ -n "$out" ] && ! printf "%s\n" "$out" | grep -qE "$a5_ids" && ! printf "%s\n" "$out" | grep -qiwE "$a5_en" && case "$out" in *"Revisión previa del instalador APS Conecta"*) ;; *) false;; esac'
  out="$( (die "prueba") 2>&1)"
  check "errors print the Spanish console's ✗ marker, with no English prefix" \
    '[ "$out" = "✗ prueba" ]'

  # ── respaldo: idempotent via the mastercontainer's own file ──
  : > "$tmp/mc-additional"
  cat > "$tshim/docker" <<'DSHIM'
#!/usr/bin/env bash
if [ "$1" = ps ]; then echo nextcloud-aio-mastercontainer; exit 0; fi
if [ "$1" = exec ]; then
  case "$5" in
    *data/additional_backup_directories*)
      case "$5" in
        *grep*) grep -qxF /opt/aps-conecta "$MC_ADDITIONAL" 2>/dev/null; exit $? ;;
        *echo*) echo /opt/aps-conecta >> "$MC_ADDITIONAL"; exit 0 ;;
      esac ;;
    *) exit 1 ;;   # a write to the WRONG path must fail loudly — the R1 find's guard
  esac
fi
exit 0
DSHIM
  chmod +x "$tshim/docker"
  export MC_ADDITIONAL="$tmp/mc-additional"
  out="$(cmd_respaldo 2>&1)"
  check "respaldo: first wiring adds the target; the no-restore caveat prints (the honest cost)" \
    'case "$out" in *"agregado al alcance"*"no se restauran"*) ;; *) false;; esac'
  out="$(cmd_respaldo 2>&1)"
  check "respaldo: second wiring is the idempotent no-op, caveat still printed" \
    'case "$out" in *"ya está en el alcance"*"no se restauran"*) ;; *) false;; esac'
  check "respaldo: the mastercontainer's file actually carries the line" \
    'grep -qxF /opt/aps-conecta "$tmp/mc-additional"'

  # ── --reponer end to end: a stub provisionador with the banner format + a canned verdict ──
  # the reponer arm needs the REAL curl (the POST must leave the process) — the hairpin
  # arms left their curl shim behind, and a shimmed curl silently turned every verdict into
  # an HTTP-000 red (this arm's own find: the shim world is per-arm, restore the real tool)
  rm -f "$tshim/curl"
  mkdir -p "$ROOT/scripts"
  cat > "$ROOT/scripts/provisionador.py" <<'EOF'
# stub: the real banner shape (slice 14: URL line, token line) then one canned POST answer
import sys
from http.server import BaseHTTPRequestHandler, HTTPServer
VACIA = "true"
# the stub's banner is byte-shaped like provisionador.py's own banner() — the parse must
# survive the REAL lines («Abra …» with the URL mid-line, the label line, the indented hex)
class H(BaseHTTPRequestHandler):
    def do_POST(self):
        # the stub enforces the LOCKED contract (read_json: JSON-only, codigo+modo) — a
        # form-encoded body must 400 here exactly as the real provisionador would, so the
        # self-test catches a wrapper that drifts off the JSON contract (R2's hollow-stub find)
        import json as J
        n = int(self.headers.get("Content-Length", 0))
        try:
            payload = J.loads(self.rfile.read(n).decode("utf-8"))
            assert isinstance(payload, dict) and payload.get("codigo") and payload.get("modo") == "ejecutar"
        except Exception:
            self.send_response(400)
            self.end_headers()
            self.wfile.write(b'{"error": "el cuerpo debe ser JSON codificado en UTF-8"}')
            return
        body = '{"salida": "fase 10: ok\\nfase 20: ok", "divergencia_vacia": ' + VACIA + '}'
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.end_headers()
        self.wfile.write(body.encode())
    def log_message(self, *a): pass
# port 0: the OS picks a free one — a hardcoded port collides with whatever the test host
# already serves (this VPS serves :8081; the stub's first draft died on bind and the POST hit
# a stranger — the self-test's own find)
srv = HTTPServer(("127.0.0.1", 0), H)
print("\u2713 Provisionador APS Conecta")
print("  Registro DEIS: instant\u00e1nea 2026-07-23 (2655 establecimientos)")
print("  Abra http://127.0.0.1:%d \u2014 desde otro equipo de la red, reemplace 127.0.0.1 por la IP de este servidor." % srv.server_port)
print("  Token de acceso ( c\u00f3pielo en la pantalla de inicio ):")
print("    0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
sys.stdout.flush()
srv.serve_forever()
EOF
  out="$(reponer 2>&1)"; rc=$?
  check "reponer: reads the stub banner, POSTs modo=ejecutar, exits the gate's code (0 on empty divergence)" \
    '[ "$rc" -eq 0 ] && case "$out" in *"re-provisión semanal"*"divergencia vacía"*) ;; *) false;; esac'
  check "reponer: the token is used, never printed (WHERE never WHAT)" \
    'case "$out" in *0123456789abcdef*) false;; *) true;; esac'

  # a red gate must exit 1 — prove-it-red for the timer's failure surface
  sed -i 's/VACIA = "true"/VACIA = "false"/' "$ROOT/scripts/provisionador.py"
  out="$(reponer 2>&1)"; rc=$?
  check "reponer: non-empty divergence exits 1 (the weekly drift red reaches systemd)" \
    '[ "$rc" -eq 1 ]'
  check "reponer: the red names the drift and the fix path" \
    'case "$out" in *"divergencia NO vacía"*"aps-conecta provision"*) ;; *) false;; esac'

  # an HTTP 500 (a failed phase) must exit 1 with the HTTP code — the executor's own contract
  sed -i 's/self.send_response(200)/self.send_response(500)/' "$ROOT/scripts/provisionador.py"
  sed -i 's/VACIA = "false"/VACIA = "true"/' "$ROOT/scripts/provisionador.py"
  out="$(reponer 2>&1)"; rc=$?
  check "reponer: a phase failure (HTTP 500) exits 1 naming the code" \
    '[ "$rc" -eq 1 ] && case "$out" in *"HTTP 500"*) ;; *) false;; esac'

  # the revalidate arm (slice 20): three stub gate scripts under a fixture root — the
  # aggregation + the exit contract, never first-fail. The command substitution scopes the
  # ROOT override (a bare ROOT=x prefix on a function call persists AFTER the call in bash —
  # the control-knob lesson's function-call variant).
  local rvd="$tmp/reval" rout rrc
  mkdir -p "$rvd/scripts"
  printf '#!/usr/bin/env bash\necho "PASS: smoke stub"\nexit 0\n'      > "$rvd/scripts/smoke.sh"
  printf '#!/usr/bin/env bash\necho "FAIL: office stub red"\nexit 1\n' > "$rvd/scripts/office-smoke.sh"
  printf '#!/usr/bin/env bash\necho "no notes"\nexit 0\n'             > "$rvd/scripts/divergence.sh"
  chmod +x "$rvd/scripts/"*.sh
  rout="$(ROOT="$rvd" cmd_revalidate 2>&1)"; rrc=$?
  check "revalidate reports every gate (a red office beside a green smoke + divergence)" \
    '[ "$rrc" -eq 1 ] && printf "%s" "$rout" | grep -q "office-smoke" && printf "%s" "$rout" | grep -q "smoke — PASS"'
  printf '#!/usr/bin/env bash\necho "PASS: office stub"\nexit 0\n' > "$rvd/scripts/office-smoke.sh"
  rout="$(ROOT="$rvd" cmd_revalidate 2>&1)"; rrc=$?
  check "revalidate aggregates green (exit 0 + the PASS line)" \
    '[ "$rrc" -eq 0 ] && printf "%s" "$rout" | grep -q "REVALIDACIÓN: PASS"'

  # the datos arm (slice 21): the territorio gate, the CUT resolution, the staged translation
  local droot="$tmp/datos-repo" dlog="$tmp/datos.log"
  mkdir -p "$droot/scripts"
  # a stub comuna-package.sh that HONORS WORK_DIR (the routed v0.2.0 amendment's shape) and
  # logs its argv — the self-test proves the WRAPPER's contract, comuna-package.sh's own gates
  # are v0.2.0's to prove (the stub stands in for the Phase-0 artifact, named for what it is)
  cat > "$droot/scripts/comuna-package.sh" <<EOF
#!/usr/bin/env bash
printf 'argv=%s WORK_DIR=%s\n' "\$*" "\$WORK_DIR" >> "$dlog"
mkdir -p "\$WORK_DIR"/tmp.x
printf '{"type": "FeatureCollection"}\n' > "\$WORK_DIR"/tmp.x/unidades-vecinales-13110.geojson
printf '{"type": "FeatureCollection"}\n' > "\$WORK_DIR"/tmp.x/deis-establecimientos-13110.geojson
echo "comuna-package stub: 37 unidades vecinales, 44 establecimientos — los comandos occ siguen"
exit 0
EOF
  chmod +x "$droot/scripts/comuna-package.sh"
  # ── arm 1: territorio absent (v1.0's own posture) → the pending skip, ZERO channel work
  printf '#!/usr/bin/env bash\nexit 1\n' > "$tshim/docker"; chmod +x "$tshim/docker"  # exec → test -d fails: no app
  : > "$dlog"
  local dout drc
  dout="$(ROOT="$droot" DATOS_HOME="$tmp/datos" cmd_datos 2>&1)"; drc=$?
  check "datos: territorio ausente → la postura pendiente, exit 0, y comuna-package JAMÁS corrió (nada se descarga)" \
    '[ "$drc" -eq 0 ] && [ ! -s "$dlog" ] \
     && case "$dout" in *"pendiente de empaquetado"*"no descarga nada"*) ;; *) false;; esac'
  # ── arm 2: territorio present → CUT resolution from the site record. The site rides
  # $droot — the ROOT cmd_datos actually runs under (a fixture split between two roots
  # was the de-risk's own catch: the CUT read $droot/sites and found nothing).
  printf '#!/usr/bin/env bash\nexit 0\n' > "$tshim/docker"; chmod +x "$tshim/docker"  # exec → test -d passes
  mkdir -p "$droot/sites/113314"
  printf 'SITE_DEIS=113314\nSITE_COMUNA_CUT=13110\n' > "$droot/sites/113314/site.sh"
  check "datos: el CUT del registro del sitio se lee (el seam de v0.2.0)" \
    '[ "$(ROOT="$droot" site_comuna_cut)" = 13110 ]'
  : > "$dlog"
  dout="$(ROOT="$droot" DATOS_HOME="$tmp/datos" cmd_datos 2>&1)"; drc=$?
  check "datos: el flujo completo corre por el stub — WORK_DIR apunta al staging, el CUT pasa" \
    '[ "$drc" -eq 0 ] && grep -q "argv=13110 WORK_DIR=$tmp/datos/13110" "$dlog" \
     && [ -f "$tmp/datos/13110/tmp.x/unidades-vecinales-13110.geojson" ]'
  check "datos: la traducción AIO se imprime por cada .geojson — cp, exec occ, rm — con las notas de idempotencia y respaldo" \
    'printf "%s" "$dout" | grep -qF "docker cp '"'"'$tmp/datos/13110/tmp.x/unidades-vecinales-13110.geojson'"'"' $NC:/tmp/" \
     && printf "%s" "$dout" | grep -qF "php /var/www/html/occ territorio:import '"'"'/tmp/unidades-vecinales-13110.geojson'"'"'" \
     && printf "%s" "$dout" | grep -q "created: 0" \
     && printf "%s" "$dout" | grep -q "revertible"'
  # ── arm 3: no site record → the refuse with its fix hint (never a silent default CUT)
  rm -rf "$droot/sites/113314"
  dout="$(ROOT="$droot" DATOS_HOME="$tmp/datos" cmd_datos 2>&1)"; drc=$?
  check "datos: sin registro de sitio se rehúsa con la corrección nombrada" \
    '[ "$drc" -ne 0 ] && case "$dout" in *"SITE_COMUNA_CUT"*"provisionador"*) ;; *) false;; esac'

  # ── the units parse (systemd-analyze verify, offline) ──
  if command -v systemd-analyze >/dev/null 2>&1; then
    u="$(systemd-analyze verify "$HOST_DIR/aps-conecta.service" "$HOST_DIR/aps-conecta.timer" 2>&1 || true)"
    # the executable-path complaint is this box's expected state (no symlink on a dev
    # box — INSTALLER.md owns the wiring); any OTHER output is a unit defect
    leftovers="$(printf '%s' "$u" | grep -v 'aps-conecta' || true)"
    check "units: systemd-analyze leaves only the unwired ExecStart path (INSTALLER.md owns the symlink; no syntax errors, no unknown directives)" \
      'case "$u" in *"Failed to parse"*|*"Unknown"*|*"Invalid"*) false;; *) true;; esac && [ -z "$leftovers" ]'
  fi

  ROOT="$ROOT_BAK"
  rm -rf "$tmp"
  echo
  echo "self-test: $n checks OK"
  [ "$FAILED" -eq 0 ] || { echo "self-test: $FAILED FAILED" >&2; exit 1; }
  return 0
}

# ── dispatch ──────────────────────────────────────────────────────────────────────────────

case "${1:-}" in
  install)      shift; cmd_install "$@" ;;
  preflight)    shift; cmd_preflight "$@" ;;
  run-command)  run_command ;;
  provision)    shift; cmd_provision "${1:-}" ;;
  revalidate)   cmd_revalidate ;;
  respaldo)     cmd_respaldo ;;
  tiles)        shift; exec bash "$HOST_DIR/tiles.sh" "$@" ;;
  datos)        shift; cmd_datos "${1:-}" ;;
  --self-test)  selftest ;;
  ""|-h|--help) uso ;;
  *)            # a step answers by its registry id — the list is the only place a step is named
                if paso="$(paso_n "$1")"; then
                  if [ "$(paso_campo "$paso" 3)" = servidor ]; then
                    paso_correr "$paso" "aps-conecta $1" || exit 1
                  else
                    paso_navegador "$paso"
                  fi
                else
                  uso; echo; echo "✗ subcomando desconocido: $1" >&2; exit 2
                fi ;;
esac
