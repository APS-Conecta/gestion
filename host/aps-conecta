#!/usr/bin/env bash
# aps-conecta — the host bundle CLI (FRD S7). Thin glue on purpose: every heavy thing already
# lives somewhere with its own gate — the Provisionador (scripts/provisionador.py, its own
# --self-test), the seed phases (provisioning/, seed-idempotent), the divergence gate
# (scripts/divergence.sh --gate). This script only: checks the host before install, prints the
# ONE docker run string, hands the operator to the Provisionador, re-provisions weekly, and
# wires the backup scope. English here, es-CL for the operator (the house register rule).
#
# Usage (the operator's Spanish usage is `aps-conecta` with no argument — generated from STEPS):
#   aps-conecta install              the interactive install: welcome, then the numbered server steps
#   aps-conecta <step>               one step of the registry (revisar … ejecutar), header and footer
#   aps-conecta preflight [--dominio D]   host checks + the run command (the FRD's pre-install gate)
#   aps-conecta run-command [IP]     just the docker run string (one source, never re-typed)
#   aps-conecta provision            start the Provisionador (interactive; Ctrl+C stops it)
#   aps-conecta provision --reponer  headless weekly re-provision (the systemd timer's job)
#   aps-conecta respaldo             wire /opt/aps-conecta into AIO's backup scope (idempotent)
#   aps-conecta asistente-aio --dominio D   drive the AIO wizard through its API (no browser)
#   aps-conecta revalidate          post-update gate sweep: smoke + office-smoke + divergence
#   aps-conecta tiles …            the basemap stack (install | refresh | check — host/tiles.sh)
#   aps-conecta datos [CUT]        the comuna data packages, cut + checksum-verified + staged
#   aps-conecta --self-test          the self-check (no docker needed — PATH shims)
#
# `install` installs what the server lacks — the tools, Docker, the bundle — and proves each piece;
# `preflight` only checks, failing closed with a fix hint (never a half-answer).
set -uo pipefail

HOST_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
ROOT="$(cd "$HOST_DIR/.." && pwd)"
# No PROV global: ROOT can be overridden (the self-test does exactly that), so every
# caller resolves scripts/provisionador.py from the CURRENT root.
prov_path() { printf '%s' "$ROOT/scripts/provisionador.py"; }
# The suite release this file installs when it runs on its own — the two-line bootstrap, before any
# clone exists. The release commit sets it beside CHANGELOG's dated entry and the self-test pins
# the two, so the file downloaded from tag vX clones exactly vX (CONTRIBUTING.md › Releases).
BUNDLE_TAG="v0.3.0"
APS_REPO_URL="${APS_REPO_URL:-https://github.com/APS-Conecta/gestion.git}"
APS_HOME="${APS_HOME:-/opt/aps-conecta}"   # the bundle lands in $APS_HOME/gestion
# An install by IP (R22): the suite's leaf (apache reads it: APS_TLS_DIR, patch 235) and the CA's
# certificate alone (Nextcloud and Talk trust it: NEXTCLOUD_TRUSTED_CACERTS_DIR), beside the installer's CA —
# the provisionador's CERT_DIR/suite and CERT_DIR/ca, pinned by its self-test
suite_tls_dir() { printf '%s' "$APS_HOME/certificados/suite"; }
suite_ca_dir() { printf '%s' "$APS_HOME/certificados/ca"; }
BIN_DIR="${BIN_DIR:-/usr/local/bin}"       # where the `aps-conecta` command is linked
in_checkout() { [ -f "$(prov_path)" ]; }    # false only for the downloaded file, on its own
in_checkout || APS_SUITE_TAG="${APS_SUITE_TAG:-$BUNDLE_TAG}"

# The docker API floor is not ours to invent: AIO's own tested requirement is v1.44
# (php/src/Docker/DockerActionManager.php:19); the mastercontainer itself enforces it at start
# (start.sh:125-145). Preflight only says it BEFORE the wizard does, with a fix hint.
API_FLOOR=144        # 1.44 as major*100+minor
WIZARD_PORTS="80 443 8080 8443"   # the wizard needs 8080; apache takes 443; 80/8443 are the
                                  # reverse-proxy companions upstream's install path expects
PROV_PORTS="8081 8082 8083"        # the Provisionador's fallback chain (slice 14) — INFO only

CONSOLE_FD=2   # die's stream: the silent install sends stderr to its log and keeps die on the console
die() { echo "✗ $*" >&"$CONSOLE_FD"; exit 1; }
ok()  { printf '✓ %s\n' "$*"; }
bad() { printf '✗ %s\n' "$1"; printf '  → %s\n' "$2"; FAIL=1; }
info(){ printf '· %s\n' "$*"; }
FAIL=0

# ── the step registry: ONE list for the console, the browser and the silent mode ──────────────
# One home per step (run plan, S1b): a server step is a subcommand of this file, a browser step
# lives in the web installer, and every front end walks this list. Fields: id|título|dónde|
# propósito|resultado. The order IS the install order and the id IS the subcommand — the approved
# Instalador UI (stage V, variant A) renders the same nine steps with the same words.
STEPS=(
  "revisar|Revisar el servidor|servidor|Memoria, disco, puertos y red.|Servidor apto."
  "preparar|Preparar el servidor|servidor|Docker, permisos y memoria.|Docker en marcha."
  "descargar|Descargar APS Conecta|servidor|Descarga y verificación de la suite.|Suite verificada."
  "mapa|Construir el mapa|servidor|Mapa de Chile local para Centro y Territorio (1,1 GB).|Mapa listo."
  "abrir|Abrir el instalador web|servidor|Enlace único para continuar en el navegador.|Enlace entregado."
  "centro|Elegir el centro|navegador|Establecimiento (2.655 de atención primaria) y ubicación.|Centro guardado."
  "suite|Iniciar la suite|navegador|Contenedores y aplicaciones, con el asistente prellenado.|Suite en marcha."
  "equipos|Cargar equipos y personas|navegador|Sectores, programas y planilla del personal.|Equipos y planilla validados."
  "ejecutar|Revisar y ejecutar|navegador|Revisión del plan y ejecución.|Instalación verificada."
)
# phase 15's theming:slogan — this file runs before the repo exists, so it carries the copy and
# the self-test pins the pair
MOTTO="La salud primaria que compartimos es la que mejora"
STEP_RESULT=""   # a step that ends in a state other than its registry result says so here
SILENT_SITE=""; SILENT_ROSTER=""; SILENT_LOG=""   # install --sitio/--planilla (a7): the files, the log

step_field() {  # N FIELD — field FIELD (1 id · 2 título · 3 dónde · 4 propósito · 5 resultado) of step N
  local IFS='|' f
  read -r -a f <<< "${STEPS[$(( $1 - 1 ))]}"
  printf '%s' "${f[$(( $2 - 1 ))]}"
}

step_number() {  # ID — the step's number; non-zero for an id the registry does not name
  local i
  for i in "${!STEPS[@]}"; do
    if [ "${STEPS[$i]%%|*}" = "$1" ]; then echo $(( i + 1 )); return 0; fi
  done
  return 1
}

step_header() {  # N — the step header, the approved console's shape
  printf '%s\n' "──────────────────────────────────────────────────────────────"
  printf 'Paso %s de %s · %s  %s\n' "$1" "${#STEPS[@]}" "$(step_field "$1" 2)" "$(step_where "$1")"
  printf 'Objetivo  %s\n' "$(step_field "$1" 4)"
  # a browser step has no command of its own; the silent install runs it here, inside «install»
  [ "$(step_field "$1" 3)" != servidor ] || printf 'Comando   aps-conecta %s\n' "$(step_field "$1" 1)"
}

step_where() { if [ -n "$SILENT_SITE" ]; then echo servidor; else step_field "$1" 3; fi; }  # silent: all here
step_footer() {  # N — the result (the step's own override, else the registry's) and the next step
  local m=$(( $1 + 1 ))
  printf 'Resultado %s\n' "${STEP_RESULT:-$(step_field "$1" 5)}"
  STEP_RESULT=""
  if [ "$m" -le "${#STEPS[@]}" ]; then
    printf 'Siguiente Paso %s · %s (%s)\n' "$m" "$(step_field "$m" 2)" "$(step_where "$m")"
  fi
  echo
}

step_run() {  # N RERUN — header, the step's body, footer; non-zero with a ✗ result on failure
  local id rc fn
  id="$(step_field "$1" 1)"; fn="step_$id"
  # the silent install runs the browser steps, «abrir» and «mapa» its own way (silent_*, a7)
  if [ -n "$SILENT_SITE" ] && declare -F "silent_$id" >/dev/null; then fn="silent_$id"; fi
  step_header "$1"
  FAIL=0
  "$fn"; rc=$?
  if [ "$rc" -ne 0 ] || [ "$FAIL" -ne 0 ]; then
    printf 'Resultado ✗ el paso %s no terminó — corrija lo marcado y vuelva a ejecutar «%s»%s\n\n' \
      "$1" "$2" "${SILENT_LOG:+ (registro: $SILENT_LOG)}"
    return 1
  fi
  step_footer "$1"
}

step_browser() {  # N — a browser step asked for from the console: where it runs, how to get there
  info "el paso $1 («$(step_field "$1" 2)») se hace en el navegador, en el instalador web que abre «aps-conecta abrir»"
}

cmd_pasos() {  # the registry as TSV — id · título · dónde · subcomando · propósito · resultado — the
  # web installer's only source for its rail and step numbers (a11: it keeps no list of its own)
  local n
  for n in $(seq 1 "${#STEPS[@]}"); do
    printf '%s\t%s\t%s\taps-conecta %s\t%s\t%s\n' "$(step_field "$n" 1)" "$(step_field "$n" 2)" \
      "$(step_field "$n" 3)" "$(step_field "$n" 1)" "$(step_field "$n" 4)" "$(step_field "$n" 5)"
  done
}

welcome() {  # the welcome — the approved console's opening, line for line
  local v n_server=0 n_browser=0 i
  v="$(suite_tag)"; [ -n "$v" ] || v="(versión sin etiqueta)"
  for i in "${!STEPS[@]}"; do
    case "${STEPS[$i]}" in *"|servidor|"*) n_server=$((n_server + 1)) ;; *) n_browser=$((n_browser + 1)) ;; esac
  done
  echo
  printf '  APS Conecta Gestión   Instalador %s\n\n' "$v"
  if [ -n "$SILENT_SITE" ]; then
    printf '  Instala la suite del establecimiento en %s pasos, sin preguntas ni navegador.\n\n' "${#STEPS[@]}"
  else
    printf '  Instala la suite del establecimiento en %s pasos: %s en este servidor, %s en el navegador.\n\n' \
      "${#STEPS[@]}" "$n_server" "$n_browser"
  fi
  printf '  «%s»\n\n' "$MOTTO"
  printf '  AGPL-3.0-or-later · github.com/APS-Conecta/gestion\n'
  printf '  Desarrollado por Dani Espinoza Charrier · APS Conecta\n\n'
}

# ── the silent install (a7): «install --sitio F --planilla F» walks the same nine steps, and these
# stand in for the browser ones — each the Provisionador's own step run with --paso, or the suite.
# The map comes last: it needs the site in .env and the suite's database (refresh-basemap.sh)
silent_precheck() {  # the two files read before anything runs — a typo must not cost an install;
  # CRLF tolerated, as the Provisionador reads them (a site edited on Windows)
  local text; text="$(tr -d '\r' < "$SILENT_SITE")"
  printf '%s\n' "$text" | grep -qE '^SITE_DEIS=[0-9]{4,6}$' \
    || die "el sitio no declara SITE_DEIS=<código DEIS> (sin comillas): $SILENT_SITE"
  [[ "$(printf '%s\n' "$text" | domain_of -)" =~ $DOMAIN_RE ]] \
    || die "el sitio no declara SITE_DOMINIO=\"<dominio del servidor>\" válido: $SILENT_SITE"
  printf '%s\n' "$text" | grep -q '^SITE_ROSTER=' || die "el sitio no trae la línea SITE_ROSTER=: $SILENT_SITE"
  head -1 "$SILENT_ROSTER" | sed 's/^\xef\xbb\xbf//' | tr -d '\r' \
    | grep -qx 'usuario;nombre;apellidos;correo;grupos;primer_admin' \
    || die "la planilla no empieza con la cabecera usuario;nombre;apellidos;correo;grupos;primer_admin: $SILENT_ROSTER"
}
silent_abrir() { STEP_RESULT="Sin instalador web: modo silencioso."; }
silent_mapa() { STEP_RESULT="Mapa: se construye al final, con la suite en marcha."; }
silent_centro() { python3 "$(prov_path)" --paso sitio --archivo "$SILENT_SITE"; }
silent_suite() {
  local domain; domain="$(site_domain || true)"
  if [ -z "$domain" ]; then
    bad "el sitio no declara SITE_DOMINIO" "agregue SITE_DOMINIO=\"<dominio del servidor>\" al sitio y vuelva a ejecutar"
    return 0
  fi
  start_suite "$domain" || return 0
  ( cmd_aio_wizard --dominio "$domain" )
}
silent_equipos() { python3 "$(prov_path)" --paso usuarios --codigo "$(site_codigo)" --planilla "$SILENT_ROSTER"; }
silent_ejecutar() { python3 "$(prov_path)" --paso generar --codigo "$(site_codigo)" --resumen; }
silent_map_last() {  # the basemap, once the suite runs; its own output goes to the log
  if [ "${APS_SKIP_MAP:-0}" = 1 ]; then
    info "mapa omitido en esta instalación: «sudo aps-conecta mapa» lo construye"; return 0
  fi
  info "construyendo el mapa de Chile (~1,1 GB; unos minutos)"
  if bash "$HOST_DIR/tiles.sh" install >&2; then
    ok "Mapa listo"
  else
    bad "el mapa no se construyó" "ejecute «sudo aps-conecta mapa» — el detalle está en el registro"
  fi
}

cmd_install() {  # the install: the welcome, then the steps in registry order. Interactive, the
  # server steps run here and the last opens the web installer for 6–9; silent (--sitio/--planilla),
  # all nine run here, the browser ones from the two files (silent_*), every tool's own output in the
  # log and only Spanish lines on the console. A failed step stops the run on its own ✗ lines; a
  # re-run walks the steps again and each finds its own work done. The prompt waits only on an
  # interactive install's terminal.
  while [ $# -gt 0 ]; do
    case "$1" in
      --sitio) [ -n "${2:-}" ] || die "falta el archivo: --sitio <site.sh>"; SILENT_SITE="$2"; shift 2 ;;
      --planilla) [ -n "${2:-}" ] || die "falta el archivo: --planilla <usuarios.csv>"; SILENT_ROSTER="$2"; shift 2 ;;
      *) die "opción desconocida: $1 — uso: sudo aps-conecta install [--sitio <site.sh> --planilla <usuarios.csv>]" ;;
    esac
  done
  local again="sudo aps-conecta install"
  if [ -n "$SILENT_SITE$SILENT_ROSTER" ]; then
    [ -n "$SILENT_SITE" ] && [ -n "$SILENT_ROSTER" ] \
      || die "--sitio y --planilla van juntos: sudo aps-conecta install --sitio <site.sh> --planilla <usuarios.csv>"
    local f
    for f in "$SILENT_SITE" "$SILENT_ROSTER"; do [ -r "$f" ] || die "no se puede leer $f"; done
    SILENT_SITE="$(realpath "$SILENT_SITE")"; SILENT_ROSTER="$(realpath "$SILENT_ROSTER")"
    silent_precheck
    again="$again$(printf ' --sitio %q --planilla %q' "$SILENT_SITE" "$SILENT_ROSTER")"
  fi
  is_root || die "la instalación necesita permisos de administrador: sudo bash aps-conecta install"
  if [ -n "$SILENT_SITE" ]; then
    SILENT_LOG="$APS_HOME/instalacion.log"
    { mkdir -p "$APS_HOME" && exec 3>&2 2>>"$SILENT_LOG"; } || die "no se pudo abrir el registro $SILENT_LOG"
    CONSOLE_FD=3
  fi
  welcome
  if [ -z "$SILENT_SITE" ] && [ -t 0 ]; then printf '  Enter para comenzar.'; IFS= read -r _; echo; fi
  local n
  for n in $(seq 1 "${#STEPS[@]}"); do
    [ -n "$SILENT_SITE" ] || [ "$(step_field "$n" 3)" = servidor ] || break
    step_run "$n" "$again" || exit 1
  done
  [ -n "$SILENT_SITE" ] || return 0
  FAIL=0; silent_map_last; install_timers
  if [ "$FAIL" -ne 0 ]; then
    echo "INSTALACIÓN: la suite quedó instalada; falta lo marcado con ✗ arriba — ejecute el comando que nombra (registro: $SILENT_LOG)"
    exit 1
  fi
  echo "INSTALACIÓN: ✓ — entregue a cada persona su fila: sudo cat /opt/aps-conecta/credentials.txt"
  echo "  y verifique la instancia: aps-conecta revalidate (registro: $SILENT_LOG)"
}

usage() {  # Spanish, generated from the registry — never a slice of this file's own header
  local n
  echo "APS Conecta Gestión — instalación y mantenimiento del servidor"
  echo
  echo "Instalación:"
  echo "  sudo aps-conecta install          instala la suite: bienvenida y pasos numerados"
  echo "  sudo aps-conecta install --sitio S --planilla P   la misma instalación, sin preguntas ni navegador"
  echo
  echo "Pasos sueltos, en el orden de la instalación:"
  for n in $(seq 1 "${#STEPS[@]}"); do
    printf '  aps-conecta %-21s %s · %s (%s)\n' \
      "$(step_field "$n" 1)" "$n" "$(step_field "$n" 2)" "$(step_field "$n" 3)"
  done
  echo
  echo "Mantenimiento:"
  echo "  aps-conecta pasos                 los pasos de la instalación, uno por fila (separados por tabulador)"
  echo "  aps-conecta preflight [--dominio D]   revisión completa del servidor (y del dominio D) y comando de arranque de la suite"
  echo "  aps-conecta run-command [IP]      solo el comando de arranque de la suite (por IP, con su certificado)"
  echo "  aps-conecta provision             abre el instalador web (lo mismo que el paso abrir)"
  echo "  aps-conecta provision --reponer   re-provisión semanal (la ejecuta el temporizador)"
  echo "  aps-conecta asistente-aio --dominio D [--talk] [--preparar]   configura la suite por la API del asistente (--preparar: sin iniciarla)"
  echo "  aps-conecta temporizadores        instala y activa la re-provisión semanal y el mapa mensual"
  echo "  aps-conecta estado                el último resultado de la re-provisión, con cada arreglo (sin sudo)"
  echo "  aps-conecta revalidate            revisa la instancia después de una actualización"
  echo "  aps-conecta respaldo              agrega /opt/aps-conecta a las copias de seguridad"
  echo "  aps-conecta tiles install|refresh|check   el mapa base y su servicio"
  echo "  aps-conecta datos [CUT]           los paquetes de datos de la comuna"
  echo "  aps-conecta --self-test           autoprueba de este programa (sin docker)"
}

# ── preflight arms ──────────────────────────────────────────────────────────────────────────

need_tool() {  # NAME — the prereq sweep; a missing tool is a red with its install hint
  if command -v "$1" >/dev/null 2>&1; then
    ok "$1 presente"
  else
    bad "$1 no está instalado" "instale $1 y vuelva a ejecutar aps-conecta preflight"
  fi
}

check_docker() {  # API floor measured, not assumed — docker version is the only source. A missing
  # docker is need_tool's red (preflight) or install_docker's (preparar), never a second one here
  command -v docker >/dev/null 2>&1 || return 0
  local api
  api="$(docker version --format '{{.Server.APIVersion}}' 2>/dev/null)" || api=""
  case "$api" in
    [0-9]*.[0-9]*) ;;
    *) if ! systemctl is-active --quiet docker 2>/dev/null; then
         bad "el servicio docker está detenido" "sudo systemctl start docker"
       else
         bad "el usuario ${SUDO_USER:-$(id -un)} no tiene permiso para usar docker" \
           "sudo usermod -aG docker ${SUDO_USER:-$(id -un)}, y vuelva a iniciar sesión"
       fi
       return ;;
  esac
  local major minor num
  major="${api%%.*}"; minor="${api#*.}"
  num=$((major * 100 + minor))
  if [ "$num" -ge "$API_FLOOR" ]; then
    ok "docker (API $api — el mínimo de AIO es 1.44)"
  else
    bad "docker API $api es menor que el mínimo 1.44 de AIO" \
      "actualice docker (los repos de Ubuntu suelen quedar atrás: use el repositorio oficial de Docker)"
  fi
}

check_compose() {
  if docker compose version >/dev/null 2>&1; then
    ok "compose v2 presente"
  else
    bad "docker compose v2 no está disponible" \
      "el plugin compose v2 viene con el docker oficial; «docker-compose» suelto no sirve"
  fi
}

port_free() {  # PORT — the rule-10 discipline (the slice-3 testbed's own idiom)
  ss -ltn "sport = :$1" 2>/dev/null | tail -n +2 | grep -q . && return 1
  return 0
}

check_ports() {  # the four wizard-facing ports; a busy one names its holder — unless a suite
  # container publishes it (a re-run of the install after the suite started reads its own as ✓)
  local p holder published
  published="$(docker ps --filter name=^aps-conecta- --filter name=^nextcloud-aio-mastercontainer$ --format '{{.Ports}}' 2>/dev/null || true)"
  for p in $WIZARD_PORTS; do
    if port_free "$p"; then
      ok "puerto $p libre"
    elif case "$published" in *":$p->"*) true ;; *) false ;; esac; then
      ok "puerto $p en uso por la suite (ya instalada)"
    else
      holder="$(ss -ltnp "sport = :$p" 2>/dev/null | grep -oP 'pid=\K[0-9]+' | head -1)"
      bad "puerto $p ocupado${holder:+ (pid $holder)}" \
        "detenga el servicio que usa el puerto $p o desinstálelo antes del asistente"
    fi
  done
}

site_file() {  # the single establishment's site.sh (D13) — empty if none, error text if many
  local f found=""
  for f in "$ROOT"/sites/*/site.sh; do
    [ -f "$f" ] || continue
    [ -n "$found" ] && { echo "MÁS DE UN SITIO"; return; }
    found="$f"
  done
  printf '%s' "$found"
}

site_domain() {  # SITE_DOMINIO from the site record (#75 hook) — empty when unset
  local f; f="$(site_file)"
  case "$f" in "" | "MÁS DE UN SITIO") return 1 ;; esac
  domain_of "$f"
}
domain_of() { grep -m1 '^SITE_DOMINIO=' "$1" 2>/dev/null | sed 's/^SITE_DOMINIO=//; s/^"//; s/"$//' || true; }
DOMAIN_RE='^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$'   # the wizard's rule, checked before anything runs too
# The install by IP (R22): a dotted IPv4 where the domain goes. No DNS, no ACME — the suite is served with
# the installer's own certificate, signed for that address, which must be one of this server's own
IPV4_RE='^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])[.]){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])$'
is_ipv4() { [[ "${1:-}" =~ $IPV4_RE ]]; }
host_ipv4s() {  # this server's own addresses — Docker's bridges are not reachable from the LAN
  ip -4 -o addr show scope global 2>/dev/null | awk '$2 !~ /^(docker|br-|veth)/ {sub(/\/.*/, "", $4); print $4}'
}
own_ipv4() {  # ADDR — one of this server's own, or the refusal naming them (MOTIVO: the web installer's line)
  local suyas; suyas="$(host_ipv4s | paste -sd' ' -)"
  [[ " $suyas " == *" $1 "* ]] && return 0
  MOTIVO="La dirección $1 no es de este servidor: use una de las suyas ($suyas)."
  bad "la dirección $1 no es de este servidor" "use una de las suyas: $suyas"
  return 1
}

PREFLIGHT_DOMAIN=""   # «preflight --dominio D»: the domain to probe before the site record names one (R6)

check_dns() {  # resolves the domain — «--dominio» first, else the SITE record's own; the wizard asks
  # for the same one
  local d; d="${PREFLIGHT_DOMAIN:-$(site_domain || true)}"
  if [ -z "$d" ]; then
    info "el dominio aún no está definido — pruébelo antes con «aps-conecta preflight --dominio <dominio>», o el asistente lo pide"
    return
  fi
  if is_ipv4 "$d"; then   # an address needs no DNS; it must be this server's (the certificate names it)
    if own_ipv4 "$d"; then ok "Dirección IP $d: es de este servidor (sin DNS; certificado propio del instalador)"; fi
    return
  fi
  if getent hosts "$d" >/dev/null 2>&1; then
    ok "DNS responde para $d"
  else
    bad "DNS no responde para $d" \
      "cree el registro A (o AAAA) del dominio apuntando a la IP pública de este servidor"
  fi
}

check_arch() {  # x86-64 is the clinic posture; arm64 publishes exist, so it passes with evidence
  case "$(uname -m)" in
    x86_64) ok "x86-64" ;;
    aarch64) ok "arm64 (las imágenes -arm64 de la suite existen — la mirada clínica es x86-64)" ;;
    *) bad "arquitectura $(uname -m) no soportada" "la suite publica x86-64 y arm64 únicamente" ;;
  esac
}

check_prov_ports() {  # INFO + the identity probe (R33): /api/salud answers the web installer's
  # identity JSON over HTTPS with no auth and no secrets — the one honest way to tell a running
  # installer from a stranger on the same port. Never a gate: a second installer refuses itself
  local p busy=0 body
  for p in $PROV_PORTS; do
    if ! port_free "$p"; then
      busy=1
      body="$(curl -sk -m 5 "https://127.0.0.1:$p/api/salud" 2>/dev/null || true)"
      if printf '%s' "$body" | grep -q '"servicio"'; then
        info "puerto $p: el instalador web ya está abierto — use su enlace o ciérrelo con Ctrl+C en su consola"
      else
        info "puerto $p ocupado por otro servicio — el instalador web elegirá un puerto libre de la cadena 8081→8083"
      fi
    fi
  done
  [ "$busy" -eq 0 ] && info "cadena del instalador web libre (8081→8083 — elige sola)"
  return 0
}

check_hairpin() {  # the D10 leg (upstream #8433): the HOST curls its own public domain — the exact
  # failing hop (hairpin NAT). Runs only when the stack is up; preflight on a fresh host says so.
  local d; d="${PREFLIGHT_DOMAIN:-$(site_domain || true)}"
  [ -z "$d" ] && return
  if ! docker ps --format '{{.Names}}' 2>/dev/null | grep -q '^aps-conecta-apache$'; then
    info "la suite aún no está instalada — después del asistente, «aps-conecta preflight${PREFLIGHT_DOMAIN:+ --dominio $d}» prueba $d desde aquí"
    return
  fi
  if curl -sk --max-time 10 "https://$d/status.php" >/dev/null 2>&1; then
    ok "https://$d/status.php responde desde el propio servidor (se alcanza por su dominio)"
  else
    bad "https://$d/status.php NO responde desde el propio servidor (el NAT no refleja el tráfico hacia su dominio)" \
      "permita el reflejo: «ufw route allow proto tcp from 172.18.0.0/16 to any port 443», o DNS local: dnsmasq con un registro A del dominio, o el dns del daemon.json de docker; NO use SKIP_DOMAIN_VALIDATION — no resuelve este tramo"
  fi
  if curl -sk --max-time 10 "https://$d/eurooffice/healthcheck" >/dev/null 2>&1; then
    ok "https://$d/eurooffice/healthcheck responde desde el propio servidor"
  else
    bad "el control de salud de la oficina NO responde desde el propio servidor" \
      "es el mismo tramo que status.php — el camino interno (nombres DNS de contenedor) es el respaldo documentado"
  fi
}

# ── the server steps' bodies (the registry's first five) ────────────────────────────────────
# Each body prints ✓/✗ lines through ok/bad and returns; step_run reads FAIL. Later laps
# replace bodies (L2 S2: «preparar» and «descargar» install instead of verify; L5: «mapa» before
# the centre; L3: «abrir» hands over a one-time link), never the list.
MIN_RAM_GIB="${MIN_RAM_GIB:-8}"       # the approved Instalador UI's floors (stage V); only a
MIN_DISK_GB="${MIN_DISK_GB:-40}"      # probe lowers them (Clean boot's runner has ~14 GB free)
MEMINFO="${MEMINFO:-/proc/meminfo}"   # the self-test points it at a fixture
ETC_DIR="${ETC_DIR:-/etc}"            # the self-test points it at a scratch tree: the arms that
                                      # install never write the real /etc
# apt with no debconf or needrestart prompt, waiting up to 5 min for the lock unattended-upgrades
# or cloud-init hold right after a fresh server boots (instead of failing on it)
APT=(env DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=a apt-get -qq -o DPkg::Lock::Timeout=300)

check_ram() {
  local kb gib
  kb="$(awk '/^MemTotal:/ {print $2}' "$MEMINFO" 2>/dev/null)"
  gib=$(( (${kb:-0} + 524288) / 1048576 ))   # rounded: an «8 GB» server reports ~7,7 GiB
  if [ "$gib" -ge "$MIN_RAM_GIB" ]; then
    ok "Memoria $gib GiB (mín. $MIN_RAM_GIB)"
  else
    bad "Memoria $gib GiB — el mínimo es $MIN_RAM_GIB GiB" "use un servidor con al menos $MIN_RAM_GIB GiB de memoria"
  fi
}

check_cpu() { ok "CPU $(nproc 2>/dev/null || echo '?') núcleos"; }

check_disk() {  # where the images and the volumes land: docker's root, or / before docker exists
  local dir=/var/lib/docker gb
  [ -d "$dir" ] || dir=/
  gb="$(df -B 1000000000 --output=avail "$dir" 2>/dev/null | tail -1 | tr -dc '0-9')"
  if [ "${gb:-0}" -ge "$MIN_DISK_GB" ]; then
    ok "Disco $gb GB libres (mín. $MIN_DISK_GB)"
  else
    bad "Disco ${gb:-0} GB libres — el mínimo es $MIN_DISK_GB GB" "libere espacio en $dir o use un disco más grande"
  fi
}

check_network() {  # outbound HTTPS and the clock — the image pulls and every certificate need both
  local h date_header remote_epoch now_epoch skew
  h="$(curl -sI -m 10 https://ghcr.io/v2/ 2>/dev/null | tr -d '\r')" || h=""
  if [ -z "$h" ]; then
    bad "sin acceso a internet (https://ghcr.io no responde)" "revise la red y el DNS de este servidor"
    return
  fi
  date_header="$(printf '%s\n' "$h" | sed -n 's/^[Dd]ate: //p' | head -1)"
  if [ -z "$date_header" ]; then
    ok "Internet (la hora no se pudo comparar: la respuesta no trajo fecha)"
    return
  fi
  remote_epoch="$(date -d "$date_header" +%s 2>/dev/null || echo 0)"; now_epoch="$(date +%s)"
  skew=$(( now_epoch > remote_epoch ? now_epoch - remote_epoch : remote_epoch - now_epoch ))
  if [ "$remote_epoch" -gt 0 ] && [ "$skew" -le 300 ]; then
    ok "Internet y hora"
  else
    bad "la hora de este servidor difiere más de 5 minutos de la de internet" \
      "active la sincronización de hora: sudo timedatectl set-ntp true"
  fi
}

is_root() { [ "$(id -u)" = 0 ]; }

install_packages() {  # the tools the install itself runs; apt installs only what is missing
  local t missing=()
  for t in git python3 curl; do command -v "$t" >/dev/null 2>&1 || missing+=("$t"); done
  if [ ${#missing[@]} -eq 0 ]; then ok "git, python3 y curl presentes"; return 0; fi
  if ! command -v apt-get >/dev/null 2>&1; then
    bad "faltan ${missing[*]} y este sistema no usa apt" "instale ${missing[*]} y vuelva a ejecutar el paso"
    return 0
  fi
  info "instalando ${missing[*]}"
  if "${APT[@]}" update >/dev/null && "${APT[@]}" install -y "${missing[@]}" >/dev/null; then
    ok "Instalado: ${missing[*]}"
  else
    bad "no se pudo instalar ${missing[*]}" "revise la red y apt (sudo apt-get update) y vuelva a ejecutar el paso"
  fi
}

install_docker() {  # Docker Engine + Compose v2 from Docker's own apt repository — the method its
  # docs give for production (the convenience script is not). Ubuntu and Debian only; a docker
  # already present is never replaced (check_docker then judges its API) — only started
  if command -v docker >/dev/null 2>&1; then
    systemctl is-active --quiet docker 2>/dev/null || systemctl start docker 2>/dev/null || true
    return 0
  fi
  local os distro suite
  os="$(. "$ETC_DIR/os-release" 2>/dev/null; printf '%s|%s' "${ID:-}" "${UBUNTU_CODENAME:-${VERSION_CODENAME:-}}")"
  distro="${os%%|*}"; suite="${os#*|}"
  case "$distro" in
    ubuntu|debian)
      if [ -z "$suite" ]; then
        bad "no se pudo leer la versión de $distro en $ETC_DIR/os-release" \
          "instale Docker Engine según https://docs.docker.com/engine/install/ y vuelva a ejecutar el paso"
        return 0
      fi ;;
    *) bad "Docker no está instalado y este sistema no es Ubuntu ni Debian" \
         "instale Docker Engine según https://docs.docker.com/engine/install/ y vuelva a ejecutar el paso"
       return 0 ;;
  esac
  info "instalando Docker desde su repositorio oficial (unos minutos)"
  # umask 022: apt reads the key and the source as the unprivileged _apt user — a hardened root
  # umask would leave them unreadable (NO_PUBKEY). ca-certificates first: a minimal image has no
  # CA bundle, and the key comes over HTTPS
  if "${APT[@]}" update >/dev/null && "${APT[@]}" install -y ca-certificates >/dev/null \
     && ( umask 022 && mkdir -p "$ETC_DIR/apt/keyrings" "$ETC_DIR/apt/sources.list.d" \
          && curl -fsSL "https://download.docker.com/linux/$distro/gpg" -o "$ETC_DIR/apt/keyrings/docker.asc" \
          && chmod a+r "$ETC_DIR/apt/keyrings/docker.asc" \
          && printf 'Types: deb\nURIs: https://download.docker.com/linux/%s\nSuites: %s\nComponents: stable\nArchitectures: %s\nSigned-By: /etc/apt/keyrings/docker.asc\n' \
               "$distro" "$suite" "$(dpkg --print-architecture)" > "$ETC_DIR/apt/sources.list.d/docker.sources" ) \
     && "${APT[@]}" update >/dev/null \
     && "${APT[@]}" install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin >/dev/null; then
    ok "Docker instalado desde su repositorio oficial"
  else
    bad "no se pudo instalar Docker" \
      "revise la red y vuelva a ejecutar el paso; guía: https://docs.docker.com/engine/install/"
  fi
}

ensure_docker_group() {  # the operator who ran sudo reaches docker without it, after a new login
  local u="${SUDO_USER:-}"
  if [ -z "$u" ] || [ "$u" = root ]; then ok "Administrador root (no necesita el grupo docker)"; return 0; fi
  if id -nG "$u" 2>/dev/null | tr ' ' '\n' | grep -qx docker; then ok "Usuario $u en el grupo docker"; return 0; fi
  if usermod -aG docker "$u"; then
    ok "Usuario $u agregado al grupo docker — cierre la sesión y vuelva a entrar para usar docker sin sudo"
  else
    bad "no se pudo agregar a $u al grupo docker" "sudo usermod -aG docker $u, y vuelva a iniciar sesión"
  fi
}

ensure_overcommit() {  # Redis, inside the suite, warns and can fail its saves without it — the
  # run's acceptance a3 requires vm.overcommit_memory = 1 (R30); its own sysctl.d file keeps it
  # across reboots, and `sysctl -p` applies that file alone (--system would reload every file)
  local f="$ETC_DIR/sysctl.d/90-aps-conecta.conf" before
  before="$(sysctl -n vm.overcommit_memory 2>/dev/null)"
  if [ "$before" = 1 ] && [ -f "$f" ]; then ok "Memoria del sistema ajustada (vm.overcommit_memory = 1)"; return 0; fi
  if ! ( umask 022 && mkdir -p "$ETC_DIR/sysctl.d" && printf 'vm.overcommit_memory = 1\n' > "$f" ); then
    bad "no se pudo escribir $f" "echo 'vm.overcommit_memory = 1' | sudo tee /etc/sysctl.d/90-aps-conecta.conf"
    return 0
  fi
  if sysctl -p "$f" >/dev/null 2>&1 && [ "$(sysctl -n vm.overcommit_memory 2>/dev/null)" = 1 ]; then
    ok "Memoria del sistema ajustada (vm.overcommit_memory ${before:-?} → 1, en $f)"
  else  # as root this fails only where /proc/sys/vm is read-only — an unprivileged container
    info "vm.overcommit_memory queda en $f para el próximo arranque; ahora no se pudo aplicar (en un contenedor, ajústelo en el anfitrión: sysctl -w vm.overcommit_memory=1)"
  fi
}

step_revisar() { check_ram; check_cpu; check_disk; check_ports; check_network; check_arch; }

step_preparar() {  # installs what is missing, then proves each piece with its own check: the tools,
  # Docker (from Docker's own apt repository), the operator's docker group, the overcommit
  if ! is_root; then
    bad "este paso instala programas y necesita permisos de administrador" "ejecute: sudo aps-conecta preparar"
    return 0
  fi
  install_packages; install_docker
  check_docker; check_compose; ensure_docker_group; ensure_overcommit
}

trust_bundle() {  # DIR — the bundle is root's; the admin reads it too (`git describe`, preflight).
  # git ≥ 2.35.2 refuses a repository another user owns unless it is listed as safe, and only the
  # system scope works on every git the targets ship (`-c safe.directory` is ignored before 2.38)
  local f="$ETC_DIR/gitconfig"
  git config --file "$f" --get-all safe.directory 2>/dev/null | grep -qxF "$1" && return 0
  git config --file "$f" --add safe.directory "$1" \
    || bad "no se pudo registrar $1 como repositorio seguro" "sudo git config --system --add safe.directory $1"
}

link_command() {  # $BIN_DIR/aps-conecta → this bundle's CLI. A missing or dangling link is (re)made;
  # one that points at another existing copy is left alone — the root systemd units run that path,
  # so a run from some other checkout never repoints them silently
  local dest="$ROOT/host/aps-conecta" current
  current="$(readlink -f "$BIN_DIR/aps-conecta" 2>/dev/null)"
  if [ "$current" = "$(readlink -f "$dest")" ]; then
    ok "Comando aps-conecta enlazado ($BIN_DIR/aps-conecta)"; return 0
  fi
  if [ -n "$current" ] && [ -e "$current" ]; then
    info "$BIN_DIR/aps-conecta ya apunta a $current — no se cambia; para usar esta copia: sudo ln -sf $dest $BIN_DIR/aps-conecta"
    return 0
  fi
  if ! is_root; then
    info "el comando aps-conecta se enlaza con permisos de administrador: sudo aps-conecta descargar"
    return 0
  fi
  if ln -sf "$dest" "$BIN_DIR/aps-conecta" 2>/dev/null; then
    ok "Comando aps-conecta enlazado ($BIN_DIR/aps-conecta → $dest)"
  else
    bad "no se pudo crear $BIN_DIR/aps-conecta" "sudo ln -sf $dest $BIN_DIR/aps-conecta"
  fi
}

step_descargar() {  # the bundle at its tag. On its own (the two-line bootstrap) this file clones the
  # suite into $APS_HOME/gestion, root-owned, and the install goes on from that clone — the same
  # tag, so the same code; in a checkout it verifies that checkout. Either way every vendored app
  # is checked against the sha256 its VENDOR pins (the seed's own check, provisioning/lib.sh), and
  # only a verified bundle is linked as the `aps-conecta` command
  local v vendor dir tars want got n=0 broken=0 dest found
  v="$(suite_tag)"
  if [ -z "$v" ]; then
    bad "no se pudo leer la versión de la suite en $ROOT" \
      "descargue la suite en una versión publicada (git clone --branch <versión>)"
    return 0
  fi
  if ! in_checkout; then
    if ! is_root; then
      bad "descargar la suite necesita permisos de administrador" "ejecute: sudo bash aps-conecta install"
      return 0
    fi
    dest="$APS_HOME/gestion"
    if [ -d "$dest/.git" ]; then
      found="$(git -C "$dest" describe --tags --exact-match 2>/dev/null)"
      if [ "$found" != "$v" ]; then
        bad "ya existe una instalación en $dest (versión ${found:-desconocida}), distinta de $v" \
          "no se modifica: continúe desde esa copia con «sudo bash $dest/host/aps-conecta install»"
        return 0
      fi
      ok "Suite $v ya descargada en $dest"
    elif [ -e "$dest" ]; then
      bad "$dest ya existe y no es una copia de la suite" \
        "muévalo (sudo mv $dest $dest.anterior) y vuelva a ejecutar: sudo bash aps-conecta install"
      return 0
    else
      info "descargando la suite $v en $dest"
      mkdir -p "$APS_HOME"
      if ! ( umask 022 && git -c advice.detachedHead=false clone -q --branch "$v" --depth 1 "$APS_REPO_URL" "$dest" ); then
        bad "no se pudo descargar la suite $v desde $APS_REPO_URL" \
          "revise la red y vuelva a ejecutar: sudo bash aps-conecta install"
        return 0
      fi
    fi
    trust_bundle "$dest"
    ROOT="$dest"; HOST_DIR="$dest/host"   # the remaining steps read every file from the bundle
  fi
  for vendor in "$ROOT"/provisioning/apps/*/VENDOR; do
    [ -f "$vendor" ] || continue
    dir="$(dirname "$vendor")"; n=$((n + 1))
    tars=("$dir"/*.tar.gz)
    want="$(sed -n 's/^sha256=//p' "$vendor")"
    got=""
    [ -f "${tars[0]}" ] && got="$(sha256sum "${tars[0]}" | cut -d' ' -f1)"
    if [ -z "$got" ] || [ "$got" != "$want" ]; then
      bad "$(basename "$dir"): el archivo no coincide con su suma de verificación" \
        "vuelva a descargar la suite; un archivo dañado nunca se instala"
      broken=$((broken + 1))
    fi
  done
  if [ "$n" -eq 0 ]; then
    bad "no se encontraron aplicaciones en $ROOT/provisioning/apps" "vuelva a descargar la suite completa"
    return 0
  fi
  ok "Suite $v ($(du -sh "$ROOT/provisioning/apps" 2>/dev/null | cut -f1))"
  if [ "$broken" -eq 0 ]; then
    ok "Sumas de verificación correctas (aplicaciones: $n)"
    link_command
  fi
  return 0
}

step_mapa() {  # the basemap needs the chosen centre today (L5 builds it before Centro): with no
  # site yet the step says so and the install goes on — «aps-conecta mapa» builds it later
  if [ -z "$(site_codigo || true)" ]; then
    info "el mapa se construye después de elegir el centro: ejecute «sudo aps-conecta mapa» al terminar el paso 6"
    STEP_RESULT="Mapa pendiente: se construye después de elegir el centro."
    return 0
  fi
  info "se construye el mapa de Chile (~1,1 GB por rangos HTTP; unos minutos — la instalación sigue al terminar)"
  bash "$HOST_DIR/tiles.sh" install
}

step_abrir() {  # the web installer walks steps 6–9 as a CHILD of this console (Ctrl+C still reaches
  # it): it exits 0 only after a green «Revisar y ejecutar», and the console then wires the timers
  # and closes the install with «Listo» — the silent install's own tail (a13, SEC-2)
  local rc domain last="${#STEPS[@]}"
  python3 "$(prov_path)"; rc=$?
  case "$rc" in
    0) ;;
    130|129|143) bad "el instalador web se cerró antes de terminar" "vuelva a abrirlo: sudo aps-conecta abrir"; return 0 ;;
    *) bad "el instalador web no abrió" "corrija lo indicado arriba y vuelva a ejecutar: sudo aps-conecta abrir"; return 0 ;;
  esac
  printf '%s\n' "──────────────────────────────────────────────────────────────"
  ok "Paso $last de $last · $(step_field "$last" 2): verificado"
  FAIL=0; install_timers
  echo
  domain="$(site_domain || true)"
  if [ -n "$domain" ]; then printf '  Listo. Acceso del personal: https://%s\n' "$domain"; else printf '  Listo.\n'; fi
  printf '  Instalador web cerrado; enlace inválido.\n'
  printf '  Credenciales: entregue a cada persona su fila — sudo cat %s/credentials.txt\n\n' "$APS_HOME"
  if [ "$FAIL" -ne 0 ]; then
    printf '  Falta lo marcado con ✗ arriba: ejecute el comando que nombra.\n'
    exit 1
  fi
  exit 0
}

# ── the run-command generator ─────────────────────────────────────────────────────────────
# ONE source. preflight prints it, INSTALLER.md quotes it, the operator pastes it. The tag is
# the gestion release this checkout ships as (D12: suite tag = gestion release tag); override
# with APS_SUITE_TAG only for rehearsed installs (the migration window, slice 22's rehearsal).

suite_tag() {
  if [ -n "${APS_SUITE_TAG:-}" ]; then printf '%s' "$APS_SUITE_TAG"; return; fi
  git -C "$ROOT" describe --tags --abbrev=0 2>/dev/null && return
  echo ""
}

run_command() {  # [ADDRESS] — prints the operator's docker run string (never executes it). An IPv4
  # is the install by IP (R22): two lines more — the suite's own certificate for apache, its CA for
  # Nextcloud and Talk. A domain's string is unchanged
  local tag tls=""; tag="$(suite_tag)"
  [ -n "$tag" ] || die "no pude leer la etiqueta de versión (¿git tags?) — o exporte APS_SUITE_TAG"
  if is_ipv4 "${1:-}"; then
    tls="  --env APS_TLS_DIR=$(suite_tls_dir) \\
  --env NEXTCLOUD_TRUSTED_CACERTS_DIR=$(suite_ca_dir) \\
"
  fi
  cat <<EOF
docker run --init --sig-proxy=false --name nextcloud-aio-mastercontainer \\
  --restart always \\
  --publish 8080:8080 \\
  --env APACHE_PORT=443 \\
${tls}  --env NEXTCLOUD_STARTUP_APPS="" \\
  --volume nextcloud_aio_mastercontainer:/mnt/docker-aio-config \\
  --volume /var/run/docker.sock:/var/run/docker.sock:ro \\
  ghcr.io/aps-conecta/all-in-one:$tag
EOF
}

# NEXTCLOUD_STARTUP_APPS is deliberately EMPTY, not absent: the apps and the theme are baked
# into the image (D4), so boot-time app:install attempts would be noise at every fresh start —
# and an empty value is also the verified way past the mastercontainer's [ -n ]-gated charset
# validator (start.sh:291-298). Both facts are the slice-5 amendment's own finding (the ratified
# forced amendment, ledgered in its History row).

TILES_ARCHIVE="${TILES_HOME:-/srv/aps-conecta}/tiles/chile.pmtiles"   # tiles.sh's ARCHIVE (an arm pins it)
install_timers() {  # the weekly re-provision and the monthly basemap (a9): the four units copied
  # from this bundle into systemd, reloaded and enabled — a re-run finds them in place, and an update
  # that changed a unit lands it. A fresh Persistent timer does not fire on enable: its first elapse
  # is computed from now (no stamp yet), so the install never starts a re-provision of its own
  local dir="$ETC_DIR/systemd/system" u changed=0 timers=aps-conecta.timer
  if ! is_root; then
    bad "los temporizadores necesitan permisos de administrador" "ejecute: sudo aps-conecta temporizadores"
    return 0
  fi
  # the units run /usr/local/bin/aps-conecta under ConditionFileIsExecutable: a missing or foreign
  # link SKIPS them without a word, so it is checked here, where it can still be said
  if [ "$(readlink -f "$BIN_DIR/aps-conecta" 2>/dev/null)" != "$(readlink -f "$HOST_DIR/aps-conecta")" ]; then
    bad "el comando aps-conecta no apunta a esta copia ($HOST_DIR)" "ejecute: sudo aps-conecta descargar"
    return 0
  fi
  mkdir -p "$dir" || { bad "no se pudo crear $dir" "revise los permisos de $ETC_DIR"; return 0; }
  for u in aps-conecta.service aps-conecta.timer aps-conecta-tiles.service aps-conecta-tiles.timer; do
    cmp -s "$HOST_DIR/$u" "$dir/$u" && continue
    install -m 0644 "$HOST_DIR/$u" "$dir/$u" || { bad "no se pudo instalar $u" "revise los permisos de $dir"; return 0; }
    changed=1
  done
  if [ "$changed" = 1 ] && ! systemctl daemon-reload >/dev/null; then
    bad "systemd no recargó las unidades" "revise: sudo systemctl daemon-reload"; return 0
  fi
  # the monthly refresh only refreshes: before a map exists it would fetch the 1,1 GB nobody built
  [ ! -f "$TILES_ARCHIVE" ] || timers="$timers aps-conecta-tiles.timer"
  # shellcheck disable=SC2086  # two fixed unit names, split on purpose
  if ! systemctl enable --now $timers >/dev/null; then
    bad "no se pudieron activar los temporizadores" "revise: systemctl status aps-conecta.timer"; return 0
  fi
  if [ -f "$TILES_ARCHIVE" ]; then
    ok "Temporizadores activos, en hora de Santiago: re-provisión semanal y mapa mensual"
  else
    ok "Temporizador activo, en hora de Santiago: re-provisión semanal"
    info "el mapa mensual se activa al construir el mapa: sudo aps-conecta mapa, luego sudo aps-conecta temporizadores"
  fi
}

start_suite() {  # [ADDRESS] — the mastercontainer, once — the very command «preflight» prints, run
  # detached. An IPv4 is the install by IP (R22): this server's own address, the suite's certificate
  # signed for it first, and a mastercontainer that already exists must carry it (read at its start)
  local domain="${1:-}" state tag cmd env_now
  if is_ipv4 "$domain"; then
    if ! [[ "$(suite_tls_dir)$(suite_ca_dir)" =~ ^[A-Za-z0-9._/-]+$ ]]; then   # both ride the eval below
      bad "la carpeta de la instalación no es válida («$APS_HOME»)" "use una ruta con letras, números, «.», «_», «-» y «/»"; return 1
    fi
    own_ipv4 "$domain" || return 1
    python3 "$(prov_path)" --paso certificado-suite --ip "$domain" --certificados "$APS_HOME/certificados" \
      || { bad "no se pudo preparar el certificado de la suite" "corrija lo indicado arriba y vuelva a ejecutar"; return 1; }
  fi
  state="$(docker ps -a --format '{{.Names}} {{.State}}' 2>/dev/null)"   # captured: pipefail-safe
  state="$(printf '%s\n' "$state" | sed -n 's/^nextcloud-aio-mastercontainer //p')"
  if [ -n "$state" ]; then   # both lines are read once, at the wizard's first start: never switched later
    env_now="$(docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' nextcloud-aio-mastercontainer 2>/dev/null)"
    if is_ipv4 "$domain"; then
      if ! grep -qxF "APS_TLS_DIR=$(suite_tls_dir)" <<<"$env_now" \
         || ! grep -qxF "NEXTCLOUD_TRUSTED_CACERTS_DIR=$(suite_ca_dir)" <<<"$env_now"; then
        bad "la suite ya se inició sin el certificado propio (para un dominio)" \
          "para instalarla por la dirección $domain, reinstálela: docs/INSTALLER.md §12"
        return 1
      fi
    elif [ -n "$domain" ] && grep -q '^APS_TLS_DIR=' <<<"$env_now"; then
      bad "la suite ya se inició por dirección IP, con el certificado propio" \
        "para instalarla con el dominio $domain, reinstálela: docs/INSTALLER.md §12"
      return 1
    fi
  fi
  case "$state" in
    running) ok "La suite ya está iniciada"; return 0 ;;
    "") ;;
    *) if docker start nextcloud-aio-mastercontainer >/dev/null; then ok "Suite reanudada"; return 0; fi
       bad "no se pudo reanudar la suite" "revise: docker logs nextcloud-aio-mastercontainer"; return 1 ;;
  esac
  tag="$(suite_tag)"   # checked before the eval: the tag and (by IP, above) the two directories are all it carries
  if ! [[ "$tag" =~ ^(v[0-9]+\.[0-9]+\.[0-9]+(-rc[0-9]+)?|ci-[0-9]{8}-[0-9]+)$ ]] \
     || ! cmd="$(run_command "$domain")" || [ -z "$cmd" ]; then
    bad "no se pudo leer la versión de la suite («$tag»)" "exporte APS_SUITE_TAG=vX.Y.Z y vuelva a ejecutar"
    return 1
  fi
  info "iniciando la suite: descarga la imagen del asistente (unos minutos)"
  if eval "$(sed '1s/^docker run /docker run -d /' <<<"$cmd")" >/dev/null; then
    ok "Suite iniciada: ghcr.io/aps-conecta/all-in-one:$tag"
  else
    bad "no se pudo iniciar la suite" "revise: docker logs nextcloud-aio-mastercontainer"; return 1
  fi
}

# ── provision ─────────────────────────────────────────────────────────────────────────────

# ── the AIO wizard, driven through its own API — no browser (silent mode, the CI testbed) ────
# The request sequence upstream's initial-setup Playwright spec drives, minus the browser: capture
# the one-time passphrase from the first GET /setup, log in, visit /containers, post the domain,
# the timezone and the options, start, then wait bounded. ONE copy (a6): scripts/aio-testbed.sh
# calls `aps-conecta asistente-aio`, and the silent install (L2 S4) calls these functions.
AIO_URL="${AIO_URL:-https://127.0.0.1:8080}"   # the wizard (self-signed TLS); the testbed sets its port
AIO_STATE="${AIO_STATE:-$APS_HOME/aio}"       # passphrase, session jar, admin password — 0600
AIO_POLL="${AIO_POLL:-5}"                   # seconds between polls; the self-test sets 0
AIO_SET="aps-conecta-apache aps-conecta-database aps-conecta-redis aps-conecta-notify-push aps-conecta-eurooffice"
AIO_CSRF=()                                     # the session's CSRF pair, as curl arguments

aio_curl() {  # ARGS… — the wizard with the session jar
  curl -sk -b "$AIO_STATE/cookies" -c "$AIO_STATE/cookies" "$@"
}

aio_count() {  # how many of the six suite containers run
  local c n=0 names
  names="$(docker ps --format '{{.Names}}' 2>/dev/null)"
  for c in "$NC" $AIO_SET; do printf '%s\n' "$names" | grep -qx "$c" && n=$((n + 1)); done
  echo "$n"
}

aio_passphrase() {  # the passphrase GET /setup shows once (the page stops rendering it once the
  # instance is configured): captured into a 0600 file the first time, reused on a re-run
  local f="$AIO_STATE/master.pw" html="" pw i
  if [ -s "$f" ]; then ok "Contraseña del asistente ya guardada ($f)"; return 0; fi
  for i in $(seq 60); do
    sleep "$AIO_POLL"   # first: the mastercontainer is still booting right after its docker run
    html="$(curl -sk --max-time 5 "$AIO_URL/setup" 2>/dev/null || true)"
    case "$html" in *'id="initial-password"'*) break ;; esac
  done
  pw="$(printf '%s' "$html" | sed -n 's/.*id="initial-password"[^>]*>\([^<]*\)<.*/\1/p' | head -1)"
  if [ -z "$pw" ]; then
    bad "el asistente no mostró su contraseña inicial en $AIO_URL/setup" \
      "revise que la suite esté arrancando: docker logs nextcloud-aio-mastercontainer"
    return 1
  fi
  ( umask 077 && printf '%s' "$pw" > "$f" )
  ok "Contraseña del asistente guardada en $f (solo administrador)"
}

aio_login() {  # the CSRF pair comes from GET /login with the session jar and serves every POST
  local html code
  html="$(aio_curl --max-time 10 "$AIO_URL/login" 2>/dev/null)"
  AIO_CSRF=(--data-urlencode "csrf_name=$(printf '%s' "$html" | sed -n 's/.*name="csrf_name" value="\([^"]*\)".*/\1/p' | head -1)"
            --data-urlencode "csrf_value=$(printf '%s' "$html" | sed -n 's/.*name="csrf_value" value="\([^"]*\)".*/\1/p' | head -1)")
  case "${AIO_CSRF[1]} ${AIO_CSRF[3]}" in
    "csrf_name= "*|*" csrf_value=") bad "el asistente no entregó su formulario de ingreso ($AIO_URL/login)" \
                                      "revise que la suite esté arrancando: docker logs nextcloud-aio-mastercontainer"
                                    return 1 ;;
  esac
  # password@FILE: curl reads the passphrase from its 0600 file — it never sits in argv, where ps shows it
  code="$(aio_curl -o /dev/null -w '%{http_code}' --max-time 20 --data-urlencode "password@$AIO_STATE/master.pw" \
    "${AIO_CSRF[@]}" "$AIO_URL/api/auth/login" 2>/dev/null)"
  if [ "$code" != 201 ]; then
    bad "el asistente rechazó el ingreso (HTTP ${code:-sin respuesta})" \
      "la contraseña guardada en $AIO_STATE/master.pw no es la de esta instancia"
    return 1
  fi
  ok "Ingreso al asistente"
}

aio_containers_page() {  # GET /containers is load-bearing, not eye candy: serving it creates the
  # nextcloud-aio network (ConnectMasterContainerToNetwork) — without it the first start dies
  if ! aio_curl --max-time 15 -o /dev/null "$AIO_URL/containers" 2>/dev/null; then
    bad "el asistente no abrió su página de contenedores ($AIO_URL/containers)" \
      "sin ella no se crea la red de la suite: revise docker logs nextcloud-aio-mastercontainer"
    return 1
  fi
}

aio_motivo() {  # FILE — the wizard's refusal (upstream's English) as one Spanish reason, the known ones named
  local m; m="$(head -c 400 "$1" 2>/dev/null)"
  case "$m" in
    *"not an IP-address"*) echo "use un nombre de dominio, no una dirección IP" ;;
    *"internal or reserved"*) echo "el dominio apunta a una dirección interna: omita la validación del dominio" ;;
    *"not reachable on Port 443"*|*"does not point to this server"*)
      echo "el servidor no se alcanza a sí mismo por ese dominio: omita la validación del dominio si no tiene acceso desde Internet" ;;
    *"DNS config is not set"*) echo "el dominio no tiene una dirección en el DNS" ;;
    *"valid domain"*|*"at least one dot"*|*"must not contain"*) echo "no es un nombre de dominio válido" ;;
    *"unallowed characters"*|*"must start with"*) echo "la carpeta del respaldo no es una ruta válida" ;;
    *"must not be a children"*) echo "la carpeta del respaldo no puede estar dentro de los datos de la suite" ;;
    *) echo "el asistente no aceptó el valor" ;;
  esac
}

aio_post() {  # PATH --data-urlencode K=V… — the wizard's configuration API answers 201 or refuses
  # with its reason: the console gets the code and the reason, the web installer one line (no path)
  local endpoint="$1" code campo motivo; shift
  code="$(aio_curl -o "$AIO_STATE/respuesta" -w '%{http_code}' --max-time 15 "${AIO_CSRF[@]}" "$@" \
    "$AIO_URL$endpoint" 2>/dev/null)"
  [ "$code" = 201 ] && return 0
  case "${2%%=*}" in
    domain) campo="la dirección" ;;
    timezone) campo="la zona horaria" ;;
    options-form) campo="las opciones" ;;
    *) campo="el respaldo" ;;
  esac
  motivo="$(aio_motivo "$AIO_STATE/respuesta")"
  printf 'El asistente rechazó %s: %s.\n' "$campo" "$motivo" > "$AIO_STATE/motivo"
  bad "el asistente rechazó «${2%%=*}» (HTTP ${code:-sin respuesta}): $motivo" \
    "corrija el valor y vuelva a intentarlo; el detalle está en la página del asistente ($AIO_URL)"
  return 1
}

aio_start() {  # POST /api/docker/start pulls, creates and starts the whole set INSIDE the request
  # (up to 30 min on a slow link): it runs in the background while the console counts containers
  local f="$AIO_STATE/inicio.code" pid n seen="" code
  info "iniciando la suite (descarga de imágenes: varios minutos)"
  # curl itself is the background job (not a subshell around it), so the trap's kill reaches it
  curl -sk -b "$AIO_STATE/cookies" -c "$AIO_STATE/cookies" -o /dev/null -w '%{http_code}' --max-time 1800 \
    "${AIO_CSRF[@]}" "$AIO_URL/api/docker/start" > "$f" 2>/dev/null &
  pid=$!
  trap 'kill "$pid" 2>/dev/null; exit 130' INT TERM
  while kill -0 "$pid" 2>/dev/null; do
    n="$(aio_count)"
    [ "$n" = "$seen" ] || { info "contenedores en marcha: $n de 6"; seen="$n"; }
    sleep "$AIO_POLL"
  done
  wait "$pid"
  trap - INT TERM
  code="$(cat "$f" 2>/dev/null)"
  case "$code" in
    200|201|302) ok "Suite iniciada" ;;
    *) bad "el asistente no pudo iniciar la suite (HTTP ${code:-sin respuesta})" \
         "revise la red y las imágenes: docker ps -a --filter name=^aps-conecta-"
       return 1 ;;
  esac
}

aio_wait() {  # bounded: the six containers up (20 min), Nextcloud installed (10 min), its
  # configuration no longer moving (2 min — probing a moving config is a race, #96)
  local i st prev cur
  for i in $(seq 240); do [ "$(aio_count)" = 6 ] && break; sleep "$AIO_POLL"; done
  if [ "$(aio_count)" != 6 ]; then
    bad "los contenedores no terminaron de arrancar en 20 minutos" "docker ps -a --filter name=^aps-conecta-"
    return 1
  fi
  for i in $(seq 120); do
    st="$(docker exec --user www-data "$NC" php /var/www/html/occ status --output=json 2>/dev/null || true)"
    case "$st" in *'"installed":true'*) break ;; esac
    sleep "$AIO_POLL"
  done
  case "$st" in
    *'"installed":true'*) ;;
    *) bad "Nextcloud no terminó de instalarse en 10 minutos" "docker logs $NC"; return 1 ;;
  esac
  prev="$(docker exec --user www-data "$NC" php /var/www/html/occ config:list --output=json 2>/dev/null | sha256sum)"
  for i in $(seq 24); do
    sleep "$AIO_POLL"
    cur="$(docker exec --user www-data "$NC" php /var/www/html/occ config:list --output=json 2>/dev/null | sha256sum)"
    if [ "$cur" = "$prev" ]; then ok "Suite en marcha: 6 contenedores, Nextcloud instalado"; return 0; fi
    prev="$cur"
  done
  bad "la configuración siguió cambiando 2 minutos después de instalar" "espere un momento y vuelva a ejecutar"
  return 1
}

aio_admin() {  # /containers shows the generated Nextcloud admin password once the set is up
  local pw
  if [ -s "$AIO_STATE/nextcloud.pw" ]; then
    ok "Contraseña del administrador de Nextcloud ya guardada ($AIO_STATE/nextcloud.pw)"; return 0
  fi
  pw="$(aio_curl --max-time 10 "$AIO_URL/containers" 2>/dev/null \
    | sed -n 's/.*id="initial-nextcloud-password"[^>]*>\([^<]*\)<.*/\1/p' | head -1)"
  if [ -n "$pw" ]; then
    ( umask 077 && printf '%s\n' "$pw" > "$AIO_STATE/nextcloud.pw" )
    ok "Contraseña del administrador de Nextcloud guardada en $AIO_STATE/nextcloud.pw"
  else
    info "el asistente no mostró la contraseña del administrador (la instalación crea sus propias cuentas)"
  fi
}

backup_hour_utc() {  # DAY — 04:00 in Santiago as the UTC hour the wizard takes: the mastercontainer
  # runs in UTC, so «04:00» posted as-is ran at 00:00 or 01:00 Santiago time (B-035). Fixed when step 7
  # runs; across a DST change the backup runs an hour off (INSTALLER §11). GNU date falls back to UTC
  # without a word when tzdata is missing, and Santiago is never UTC+0: an unchanged hour is that
  # fallback, refused
  local h
  h="$(TZ=UTC date -d "TZ=\"America/Santiago\" $1 04:00" +%H:%M)" || return 1
  [ "$h" != 04:00 ] || { echo "✗ falta la zona America/Santiago en el servidor (paquete tzdata): no se fija la hora del respaldo" >&2; return 1; }
  printf '%s\n' "$h"
}

cmd_aio_wizard() {  # --dominio D [--sin-validar-dominio] [--respaldo DIR] [--talk] [--grabacion] [--preparar]
  # --preparar: the web installer's step 7 — the mastercontainer started and the wizard filled, but NO
  # start: the operator presses «Iniciar» in the wizard (S1b: the wizard kept, pre-filled)
  local domain="" backup_dir="" options=() talk=0 grabacion=0 preparar=0 opciones=(--data-urlencode options-form=1) hora
  MOTIVO=""   # a refusal that names its own cause for the web installer (own_ipv4)
  while [ $# -gt 0 ]; do
    case "$1" in
      --dominio) domain="${2:-}"; shift 2 || shift ;;
      --sin-validar-dominio) options+=(--data-urlencode skip_domain_validation=1); shift ;;
      --respaldo) [ -n "${2:-}" ] \
                    || die "falta el directorio del respaldo: aps-conecta asistente-aio --dominio <dominio> --respaldo <directorio>"
                  backup_dir="$2"; shift 2 ;;
      --talk) talk=1; shift ;;
      --grabacion) talk=1; grabacion=1; shift ;;   # the recording runs inside Talk
      --preparar) preparar=1; shift ;;
      *) die "opción desconocida: $1 — uso: aps-conecta asistente-aio --dominio <dominio> [--sin-validar-dominio] [--respaldo <directorio>] [--talk] [--grabacion] [--preparar]" ;;
    esac
  done
  [[ "$domain" =~ $DOMAIN_RE ]] \
    || die "falta un dominio válido: aps-conecta asistente-aio --dominio <dominio>"
  # an address cannot pass the wizard's DNS validation: by IP it is skipped, always (patch 233 accepts it then)
  ! is_ipv4 "$domain" || options=(--data-urlencode skip_domain_validation=1)
  [ "$talk" = 0 ] || opciones+=(--data-urlencode talk=on)
  [ "$grabacion" = 0 ] || opciones+=(--data-urlencode talk-recording=on)
  ( umask 077 && mkdir -p "$AIO_STATE" ) || die "no se pudo crear $AIO_STATE"
  rm -f "$AIO_STATE/motivo"
  FAIL=0
  # the backup hour first: a host without tzdata stops here, before anything is started or posted
  if [ -n "$backup_dir" ] && ! hora="$(backup_hour_utc today)"; then
    printf 'Falta la zona America/Santiago en el servidor (paquete tzdata): no se fija la hora del respaldo.\n' > "$AIO_STATE/motivo"
    exit 1
  fi
  if [ "$preparar" = 1 ] && ! start_suite "$domain"; then
    printf '%s\n' "${MOTIVO:-El asistente no arrancó: el detalle, en la consola del servidor.}" > "$AIO_STATE/motivo"
    exit 1
  fi
  local names
  names="$(docker ps --format '{{.Names}}' 2>/dev/null)"   # captured first: under pipefail an early
  if printf '%s\n' "$names" | grep -qx aps-conecta-apache; then   # grep -q exit would SIGPIPE docker
    ok "La suite ya está en marcha — el asistente no se vuelve a configurar"
    [ "$preparar" = 0 ] || exit 0
  else
    # the web installer's record — the domain the wizard took and the Talk options it was given — is
    # written only once every post succeeded: a refusal halfway leaves none, and the page asks again
    rm -f "$AIO_STATE/dominio" "$AIO_STATE/opciones"
    aio_passphrase && aio_login && aio_containers_page \
      && aio_post /api/configuration --data-urlencode "domain=$domain" "${options[@]}" && ok "Dominio: $domain" \
      && aio_post /api/configuration --data-urlencode "timezone=America/Santiago" && ok "Zona horaria: America/Santiago" \
      && aio_post /api/configuration "${opciones[@]}" \
      && ok "Opciones: oficina incluida; Talk $([ "$talk" = 1 ] && echo activado || echo apagado); grabación $([ "$grabacion" = 1 ] && echo activada || echo apagada); pizarra e imágenes apagadas" \
      && { [ -z "$backup_dir" ] || { aio_post /api/configuration --data-urlencode "borg_backup_host_location=$backup_dir" \
             --data-urlencode "borg_remote_repo=" && aio_post /api/configuration --data-urlencode "daily_backup_time=$hora" \
             && aio_post /api/configuration --data-urlencode "additional_backup_directories=$APS_HOME" \
             && ok "Respaldo diario a las 04:00 hora de Santiago ($hora UTC), en $backup_dir, con $APS_HOME"; }; } \
      && ( umask 077 && printf '%s\n' "$domain" > "$AIO_STATE/dominio" \
           && printf 'talk=%s grabacion=%s\n' "$talk" "$grabacion" > "$AIO_STATE/opciones" ) \
      || exit 1
    if [ "$preparar" = 1 ]; then ok "Asistente listo: falta «Iniciar» en el asistente"; exit 0; fi
    aio_start || exit 1
  fi
  aio_wait || exit 1
  aio_admin
  [ "$FAIL" -eq 0 ] || exit 1
}

cmd_provision() {  # [--reponer] — without it, the step «abrir» itself (the same frame and body)
  if [ "${1:-}" = "--reponer" ]; then reponer; return; fi
  step_run "$(step_number abrir)" "sudo aps-conecta abrir" || exit 1
}


site_codigo() {  # the site directory IS the DEIS codigo (slice 14: sites/<codigo>/site.sh)
  local f; f="$(site_file)"
  case "$f" in
    "") echo ""; return 1 ;;
    "MÁS DE UN SITIO") echo ""; return 1 ;;
    *) basename "$(dirname "$f")" ;;
  esac
}

reponer() {  # the weekly headless re-provision (the timer's whole job): the Provisionador's own step,
  # run in-process — `provisionador.py --paso generar`, no server, no banner, no token. The phases
  # stream live and the gate's verdict is the exit code: drift self-healing or a loud red, never a
  # silent no-op
  local code; code="$(site_codigo)" || true
  if [ -z "$code" ]; then
    die "no hay un único sitio en sites/ (una instalación sirve a un solo establecimiento) — elija el centro en el instalador web primero"
  fi
  info "re-provisión semanal del establecimiento $code"
  local domain antes cert_rc=0; domain="$(site_domain || true)"
  if is_ipv4 "$domain"; then   # by IP (R22): the suite's leaf signed again before its end; apache reads it at start
    antes="$(sha256sum "$(suite_tls_dir)/tls.crt" 2>/dev/null)"
    python3 "$(prov_path)" --paso certificado-suite --ip "$domain" --certificados "$APS_HOME/certificados" || cert_rc=1
    if [ "$cert_rc" = 0 ] && [ "$(sha256sum "$(suite_tls_dir)/tls.crt" 2>/dev/null)" != "$antes" ]; then
      if docker restart aps-conecta-apache >/dev/null; then ok "Certificado de la suite renovado: apache reiniciado"
      else bad "apache sigue con el certificado anterior" "sudo docker restart aps-conecta-apache"; cert_rc=1; fi
    fi
  fi
  python3 "$(prov_path)" --paso generar --codigo "$code"
  local rc=$?
  [ "$rc" -eq 0 ] || notify_admins   # the admins hear the provision's verdict (estado.txt); a certificate
  [ "$rc" -ne 0 ] || rc="$cert_rc"   # that failed reds the unit on its own line
  exit "$rc"
}

notify_admins() {  # a10: the last verdict, one notification to every admin — the same object each week,
  # so it replaces the last one — at their next login. Best-effort: it never changes the run's exit code
  local f="$APS_HOME/estado.txt" head body
  [ -r "$f" ] || return 0
  head="$(head -1 "$f")"
  # whole lines within the long message's 4000 bytes — never half a UTF-8 character
  body="$(tail -n +2 "$f" | python3 -c 'import sys
t = sys.stdin.read(); b = t.encode()
print(t if len(b) <= 3600 else b[:3600].decode("utf-8", "ignore").rsplit("\n", 1)[0] + "\n  · … (más en: aps-conecta estado)")')"
  ( cd "$ROOT" && . scripts/env.sh >/dev/null 2>&1 || { echo "· no se pudo avisar: no se leyó la configuración" >&2; exit 0; }
    admins="$(occ group:list --output=json 2>/dev/null | python3 -c 'import json, sys
d = json.load(sys.stdin)
print(" ".join([] if isinstance(d, list) else d.get("admin", [])))' 2>/dev/null)"
    [ -n "$admins" ] || { echo "· no se pudo avisar: no se leyeron los administradores" >&2; exit 0; }
    for u in $admins; do
      occ notification:generate "$u" "APS Conecta — re-provisión semanal: ${head#* · }" \
        -l "$body
Detalle en el servidor: aps-conecta estado" --object-type aps-conecta --object-id estado >/dev/null 2>&1 \
        || echo "· no se pudo avisar a $u" >&2
    done ) || true
}

cmd_estado() {  # the last execution's verdict and each item with its fix — no sudo, no docker (a10)
  local f="$APS_HOME/estado.txt"
  if [ ! -r "$f" ]; then
    info "todavía no hay un resultado: lo deja la primera ejecución (la instalación, o sudo systemctl start aps-conecta.service)"
    return 0
  fi
  cat "$f"
  case "$(head -1 "$f")" in *" · ✓ "*) return 0 ;; *) return 1 ;; esac
}

# ── respaldo ───────────────────────────────────────────────────────────────────────────────

cmd_respaldo() {  # wire /opt/aps-conecta into AIO's backup scope — idempotent, via the
  # mastercontainer's own data file: GetDataDirectory() is /mnt/docker-aio-config/data/
  # (php/src/Data/DataConst.php:6-13 — start.sh:406 mkdirs it every start), so the file is
  # /mnt/docker-aio-config/data/additional_backup_directories, one path per line
  # (DataConst.php:39-40; the wizard's backup form loads the same file, so the line survives
  # a later form save).
  local target=/opt/aps-conecta mc=nextcloud-aio-mastercontainer
  local datafile=/mnt/docker-aio-config/data/additional_backup_directories
  if ! docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "$mc"; then
    die "el mastercontainer ($mc) no está corriendo — el wiring va después del asistente"
  fi
  if docker exec "$mc" sh -c "grep -qxF '$target' '$datafile' 2>/dev/null"; then
    ok "$target ya está en el alcance de las copias de seguridad"
  else
    docker exec "$mc" sh -c "echo '$target' >> '$datafile'" \
      || die "no pude escribir el alcance en el mastercontainer"
    ok "$target agregado al alcance de las copias de seguridad"
  fi
  info "ojo: los directorios adicionales se RESPALDAN pero no se restauran junto con la instancia (comportamiento propio de AIO, documentado en el asistente) — /opt/aps-conecta se restaura a mano desde el archivo borg"
}

# ── revalidate ─────────────────────────────────────────────────────────────────────────────

cmd_revalidate() {  # post-update: run every read-only gate against the running instance
  # The FRD S8's post-update revalidation suite. WHEN the operator runs it: right after the
  # clinic's stack moves — a new suite tag on purpose (D12: a published tag's digests never
  # move, so an update IS a deliberate new-tag run) or a container reboot. The three gates are
  # the read-only half of this program's gate stack: smoke (the 14 core invariants),
  # office-smoke (the office wire: public-path healthcheck + --check + the 9.3.x pin), and
  # divergence --gate (live state vs the declared set — the handoff contract the executor and
  # the weekly timer already ride). All three are read-only by their locked contracts, so this
  # arm never writes — the --reponer timer owns convergence; revalidate only measures.
  # ALL THREE run, first-fail is not the shape: after an update, clinic IT needs the complete
  # picture (WHICH gates are red), not the first one (test.sh's aggregation lesson). The exit
  # code is the aggregate — 0 iff all three green — the same verdict shape --reponer exits, so
  # a red revalidate reads identically to a red weekly unit wherever operators look.
  local rc=0 out st name
  for name in smoke office-smoke divergence-gate; do
    case "$name" in
      smoke)           out="$(bash "$ROOT/scripts/smoke.sh" 2>&1)"; st=$? ;;
      office-smoke)    out="$(bash "$ROOT/scripts/office-smoke.sh" 2>&1)"; st=$? ;;
      divergence-gate) out="$(bash "$ROOT/scripts/divergence.sh" --gate 2>&1)"; st=$? ;;
    esac
    if [ "$st" -eq 0 ]; then
      printf '  ✓ %s — %s\n' "$name" "$(printf '%s\n' "$out" | tail -1)"
    else
      printf '  ✗ %s — el detalle completo:\n' "$name"
      printf '%s\n' "$out"
      rc=1
    fi
  done
  if [ "$rc" -eq 0 ]; then
    echo "REVALIDACIÓN: PASS — humo ✓, oficina ✓, divergencia vacía ✓ (la instancia sigue convergida)"
  else
    echo "REVALIDACIÓN: FAIL — lo de arriba quedó tras la actualización; «aps-conecta provision» re-converge el estado declarado, y el informe de divergencia nombra el resto" >&2
  fi
  return "$rc"
}

# ── tiles + datos (slice 21, FRD S9) ─────────────────────────────────────────────────────
NC=aps-conecta-nextcloud           # the AIO posture: respaldo hardcodes the mastercontainer
                                      # the same way; NC_CONTAINER is the seed's knob, not ours
DATOS_HOME="${DATOS_HOME:-/srv/aps-conecta/datos}"   # beside the tiles home — regenerable
                                      # generated data, outside borg's scope by the same argument

site_comuna_cut() {  # the site record's own CUT (v0.2.0's seam — deis.py emits it post-v0.2.0)
  local f; f="$(site_file)"
  case "$f" in "" | "MÁS DE UN SITIO") return 1 ;; esac
  grep -m1 '^SITE_COMUNA_CUT=' "$f" 2>/dev/null | sed 's/^SITE_COMUNA_CUT=//' || true
}

cmd_datos() {  # [CUT] — S9's data-package leg: the national masters, sha256-verified, cut to
  # THIS install's comuna, staged durably, with the AIO import translation printed. Thin on
  # purpose: scripts/comuna-package.sh (v0.2.0's slice-11 artifact) owns the fetch-verify
  # and the cut — this arm resolves the CUT, stages the output, and translates the import
  # form. It never imports: the import is a deliberate operator paste with the backup step
  # visible beside it (IMPORT_DESIGN's own rule: pg_dump beforehand, revert from the
  # browser, ADR-0009) — an install-time auto-import would bypass every one of those
  # disciplines.
  local cut="${1:-}"
  # Territorio ships with the suite: phase 12 installs it (OWN_APPS), so it is absent only before the
  # first provisioning. Then nothing can receive the data — the honest skip, never a silent fetch of
  # ~93 MB of masters for an app that cannot import (the office-skip precedent: visible, exit 0, no
  # work done).
  if ! docker exec "$NC" sh -c 'test -d /var/www/html/custom_apps/territorio' >/dev/null 2>&1; then
    info "territorio no está instalado — este comando no descarga nada"
    info "territorio se instala con «Revisar y ejecutar»; después, re-ejecute «aps-conecta datos»: traerá y verificará los paquetes de su comuna"
    return 0
  fi
  if [ -z "$cut" ]; then
    cut="$(site_comuna_cut || true)"
    [ -n "$cut" ] || die "el registro del sitio no trae SITE_COMUNA_CUT — regenere el sitio con el provisionador (lo escribe desde v0.2.0)"
  fi
  local stage="$DATOS_HOME/$cut"
  mkdir -p "$stage" || die "no pude crear $stage"
  info "cortando los paquetes de la comuna $cut (maestros nacionales, sha256 verificado por comuna-package.sh — la primera vez descarga ~93 MB)"
  # WORK_DIR: the routed v0.2.0 amendment — without it comuna-package.sh's EXIT-trap kills
  # the cuts with the child, and its own closing line ("import them, then remove") promises
  # a persistence the trap denies (the design-time find, its own criteria row). Staged here,
  # the cuts survive for the docker cp the AIO form needs.
  if ! WORK_DIR="$stage" bash "$ROOT/scripts/comuna-package.sh" "$cut"; then
    die "comuna-package falló — arriba queda el canal que quebró (un maestro que se movió se re-registra por edición, nunca se corta a ciegas)"
  fi
  echo
  echo "los paquetes quedaron bajo $stage (impórtelos y luego elimínelos). Bajo AIO, cada comando «occ territorio:import …» que comuna-package.sh imprimió arriba se ejecuta así:"
  local f base
  while IFS= read -r f; do
    base="$(basename "$f")"
    echo "  1. docker cp '$f' $NC:/tmp/"
    echo "  2. docker exec -u www-data $NC php /var/www/html/occ territorio:import '/tmp/$base' …(los argumentos que comuna-package.sh imprimió)"
    echo "  3. docker exec $NC rm -f '/tmp/$base'"
  done < <(find "$stage" -type f -name '*.geojson' | sort)
  echo
  info "re-importar el MISMO archivo imprime «created: 0» — si crea filas, el esquema uid quebró (territorio IMPORT_DESIGN, regla 6): deténgase y corríjalo"
  info "antes del primer import tome su respaldo habitual — cada import queda revertible desde el navegador del administrador (ADR-0009 de territorio)"
}

