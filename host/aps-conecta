        [ ! -e "$act/retirement-read-failed" ] || exit 124
        [ ! -e "$act/retirement-native-failed" ] || exit 1
        if [ -e "$act/retirement-invalid" ]; then echo 'synthetic invalid inventory'; exit 0; fi
        if [ -e "$act/retirement-invalid-shape" ]; then echo '{"enabled":{},"disabled":["unexpected"]}'; exit 0; fi
