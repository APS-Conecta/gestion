  }

  out="$( id() { echo 0; }; act46 --revisar 2>&1 )"; arc=$?
  check "actualizar --revisar: the plan — current and candidate per app, the move, the stay, the unchosen optional, the store row; nothing else" \
    '[ "$arc" -eq 0 ] && printf "%s" "$out" | grep -qF "Plan de actualización — Nextcloud 34.0.4" \
      && printf "%s" "$out" | grep -E -q "^  territorio +v0\.79\.0 → v0\.80\.0$" \
      && printf "%s" "$out" | grep -E -q "^  suelo +v3\.5\.0 +\(sin cambios\)$" \
      && printf "%s" "$out" | grep -E -q "^  farmacia +no elegida \(su fila del candado se conserva\)$" \
      && printf "%s" "$out" | grep -E -q "^  calendar +4\.7\.15 → la tienda de aplicaciones$" \
