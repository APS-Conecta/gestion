paso_descargar() {  # the checkout this file runs from: its version and every vendored app against
  # the sha256 its VENDOR pins — the seed's own check (provisioning/lib.sh), before any stack exists
  local v vendor dir tars want got n=0 malos=0
  v="$(suite_tag)"
  if [ -z "$v" ]; then
    bad "no se pudo leer la versión de la suite en $ROOT" \
      "descargue la suite en una versión publicada (git clone --branch <versión>)"
    return 0
  fi
  for vendor in "$ROOT"/provisioning/apps/*/VENDOR; do
    [ -f "$vendor" ] || continue
    dir="$(dirname "$vendor")"; n=$((n + 1))
    tars=("$dir"/*.tar.gz)
    want="$(sed -n 's/^sha256=//p' "$vendor")"
    got=""
    [ -f "${tars[0]}" ] && got="$(sha256sum "${tars[0]}" | cut -d' ' -f1)"
    if [ -z "$got" ] || [ "$got" != "$want" ]; then
      bad "$(basename "$dir"): el archivo no coincide con su suma de verificación" \
        "vuelva a descargar la suite; un archivo dañado nunca se instala"
      malos=$((malos + 1))
    fi
  done
  if [ "$n" -eq 0 ]; then
    bad "no se encontraron aplicaciones en $ROOT/provisioning/apps" "vuelva a descargar la suite completa"
    return 0
  fi
  ok "Suite $v ($(du -sh "$ROOT/provisioning/apps" 2>/dev/null | cut -f1))"
  [ "$malos" -eq 0 ] && ok "Sumas de verificación correctas (aplicaciones: $n)"
  return 0
}

