    check "red --arreglar: the host's cached public answer is flushed before the prove" \
      'grep -q "^resolvectl flush-caches$" "$rlog"'
    : > "$rlog"
    red_run "$ETC_RED" --dominio clinica.example --arreglar
    check "red --arreglar: a re-run finds everything in place — nothing installed, restarted or re-allowed, and the «ya» lines say so" \
      '[ "$rc_red" -eq 0 ] && ! grep -qE "^(enable --now dnsmasq|restart dnsmasq|restart systemd-resolved|restart docker)$" "$rlog" \
       && ! grep -q -- "install -y" "$rlog" && ! grep -q "^ufw allow" "$rlog" \
       && case "$out_red" in *"✓ DNS local ya instalado"*"✓ El DNS del propio servidor ya enruta"*"✓ DNS de los contenedores ya usa este servidor (10.0.0.5 primero)"*) ;; *) false;; esac'
    printf '{\n  "dns": ["10.0.0.1"],\n  "log-level": "debug"\n}\n' > "$ETC_RED/docker/daemon.json"
    : > "$rlog"
    red_run "$ETC_RED" --dominio clinica.example --arreglar
    check "red --arreglar: an existing daemon.json is MERGED — this server first, the operator's resolver kept, sibling keys intact — and docker restarts for the change" \
      '[ "$rc_red" -eq 0 ] && grep -q "^restart docker$" "$rlog" \
       && [ "$(python3 -c "import json; d = json.load(open(\"$ETC_RED/docker/daemon.json\")); print(\" \".join(d[\"dns\"]), d[\"log-level\"])")" = "10.0.0.5 10.0.0.1 debug" ]'
    printf 'esto no es json\n' > "$ETC_RED/docker/daemon.json"; cp "$ETC_RED/docker/daemon.json" "$tmp/red-antes"
    : > "$rlog"
    red_run "$ETC_RED" --dominio clinica.example --arreglar
    check "red --arreglar: an unparseable daemon.json is refused untouched, with the hand fix — never overwritten" \
      '[ "$rc_red" -eq 1 ] && cmp -s "$ETC_RED/docker/daemon.json" "$tmp/red-antes" \
       && case "$out_red" in *"no se pudo leer como JSON — no se tocó"*"json.tool"*) ;; *) false;; esac && ! grep -q "^restart docker$" "$rlog"'
    rm -rf "$ETC_RED2"; mkdir -p "$ETC_RED2"; printf '10.0.0.5\n10.0.0.6\n' > "$tmp/red-lan"
    red_run "$ETC_RED2" --dominio clinica.example --arreglar
    check "red --arreglar: several addresses of this server — the first is pinned and named, never a silent choice" \
      '[ "$rc_red" -eq 0 ] && grep -qx "address=/clinica.example/10.0.0.5" "$ETC_RED2/dnsmasq.d/aps-conecta.conf" \
       && ! grep -q "10.0.0.6" "$ETC_RED2/dnsmasq.d/aps-conecta.conf" && case "$out_red" in *"responde 10.0.0.5"*) ;; *) false;; esac'
    printf '10.0.0.5\n' > "$tmp/red-lan"
    rm -rf "$ETC_RED2"; mkdir -p "$ETC_RED2"
    red_run "$ETC_RED2" "" 0 --dominio clinica.example --arreglar
    check "red --arreglar: a host without systemd-resolved fixes the containers' legs, refuses the host's own honestly, and never writes the drop-in" \
      '[ "$rc_red" -eq 1 ] && [ ! -e "$ETC_RED2/systemd/resolved.conf.d" ] && [ -f "$ETC_RED2/docker/daemon.json" ] \
       && ! grep -q "resolv-file" "$ETC_RED2/dnsmasq.d/aps-conecta.conf" \
       && case "$out_red" in *"✗ este servidor no usa systemd-resolved"*"✗ clinica.example aún no resuelve a 10.0.0.5"*) ;; *) false;; esac'
    rm -rf "$ETC_RED2"; mkdir -p "$ETC_RED2"; : > "$tmp/red-ps"; : > "$rlog"
    red_run "$ETC_RED2" "" 1 203.0.113.9 --dominio clinica.example
    check "red (report): a public answer — the reflection named, the fix command named, nothing touched, no sudo needed" \
      '[ "$rc_red" -eq 0 ] && case "$out_red" in *"clinica.example resuelve a 203.0.113.9"*"reflejo"*"--arreglar"*) ;; *) false;; esac \
       && [ ! -s "$rlog" ] && [ -z "$(ls -A "$ETC_RED2")" ]'
    red_run "$ETC_RED" 1000 --dominio clinica.example
    check "red (report): the fixed world reads fixed — nothing to correct, nothing touched" \
      '[ "$rc_red" -eq 0 ] && case "$out_red" in *"✓ clinica.example ya resuelve a este servidor (10.0.0.5) — no hay reflejo que corregir"*) ;; *) false;; esac'
    printf 'aps-conecta-apache\n' > "$tmp/red-ps"
    printf '#!/usr/bin/env bash\nexit 1\n' > "$tshim/curl"; chmod +x "$tshim/curl"
    out="$(PREFLIGHT_DOMAIN=clinica.example check_hairpin)"
    check "hairpin: the red now leads with the one command that fixes it — the alternatives and the SKIP warning kept" \
      'case "$out" in *"sudo aps-conecta red --dominio clinica.example --arreglar"*"dnsmasq"*"daemon.json"*"172.18.0.0/16"*"NO use SKIP_DOMAIN_VALIDATION"*) ;; *) false;; esac'
    printf '#!/usr/bin/env bash\nexit 0\n' > "$tshim/curl"; chmod +x "$tshim/curl"
    out="$(RED_PUBLIC=203.0.113.9 bash "$HOST_DIR/aps-conecta" red --dominio clinica.example 2>&1)"; rc=$?
    check "dispatch: red answers as the operator calls it (report mode, no sudo)" \
      '[ "$rc" -eq 0 ] && case "$out" in *"clinica.example resuelve a 203.0.113.9"*"reflejo"*) ;; *) false;; esac'
    out="$(usage)"
    check "usage: red is listed with its form" \
      'case "$out" in *"aps-conecta red --dominio D [--arreglar]"*) ;; *) false;; esac'
  fi
  rm -f "$tshim"/{systemctl,apt-get,resolvectl,ufw,getent,ip,docker,curl,id,dnsmasq}

  # ── the signed channel (D5/D7): the kept package re-verified offline. signify answers from
  # a shim (the real crypto — a real throwaway keypair signing and proving — is package-
  # release.sh's own locked self-test; here the arms prove the CLI's contract: the exact
  # argv, the cwd at the package, the remedies, the honest skips). sha256sum -c runs REAL
  # over the fixture bytes. The restricted PATH keeps a real signify (if the host has one)
  # out of the arms' way ──
  local ph="$tmp/paq-home" plog="$tmp/paq.log" minpaq="$tmp/min-paq"
  local out_paq rc_paq
  mkdir -p "$ph/paquete" "$minpaq" "$tmp/notag"
  for c in bash grep head cat cut sed sha256sum dirname basename du python3; do ln -sf "$(command -v "$c")" "$minpaq/$c"; done
  cat > "$tshim/signify" <<SHIM
#!/usr/bin/env bash
printf 'cwd=%s %s\n' "\$(pwd)" "\$*" >> "$plog"
[ "\$2" = -p ] && printf 'pub2=%s\n' "\$(sed -n 2p "\$3")" >> "$plog"
exit "\$(cat "$tmp/paq-sig.rc" 2>/dev/null || echo 0)"
SHIM
  chmod +x "$tshim/signify"   # planted once: answerable for the whole block (the locked lifecycle)
  # the fixture world: a kept package for v9.9.9 with a REAL sha in its SUMS, the signature
  # answered by the shim, and a bundle (ROOT) carrying VERSION + installer.pub
  mkdir -p "$tmp/paq-fx/dir"; printf 'contenido\n' > "$tmp/paq-fx/dir/archivo"
  tar -czf "$ph/paquete/apsconecta-v9.9.9.tar.gz" -C "$tmp/paq-fx" dir
  printf '%s  apsconecta-v9.9.9.tar.gz\n' "$(sha256sum "$ph/paquete/apsconecta-v9.9.9.tar.gz" | cut -d' ' -f1)" > "$ph/paquete/SHA256SUMS"
  printf 'firma-fixture\n' > "$ph/paquete/SHA256SUMS.minisig"
  printf 'v9.9.9\n' > "$ROOT/VERSION"
  printf 'untrusted comment: fixture\nRWQf6LgoAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\n' > "$ROOT/installer.pub"
  mv "$tshim/signify" "$tmp/sig-guard"   # ABSENT: the honest-skip arms
  out_paq="$(ROOT="$tmp/notag" check_paquete)"; rc_paq=$?
  check "paquete: no readable tag — the honest skip, never a red" \
    '[ "$rc_paq" -eq 0 ] && case "$out_paq" in *"· la versión de la suite aún no se lee en esta copia"*) ;; *) false;; esac'
  out_paq="$(PATH="$tshim:$minpaq" APS_HOME="$ph" check_paquete v9.8.7)"
  check "paquete: no kept package for the tag (rehearsal channel / freed disk) — the honest skip" \
    'case "$out_paq" in *"· no hay paquete guardado de la versión v9.8.7 (canal git de ensayo o disco liberado)"*) ;; *) false;; esac'
  out_paq="$(PATH="$tshim:$minpaq" APS_HOME="$ph" check_paquete)"
  check "paquete: signify not installed yet — the honest skip naming preparar and signify-openbsd (the installer's sha already anchored the bytes)" \
    'case "$out_paq" in *"· signify no está instalado"*"sudo aps-conecta preparar» instala signify-openbsd"*) ;; *) false;; esac'
  mv "$tmp/sig-guard" "$tshim/signify"   # PRESENT again: the reds, the green, the sweeps
  echo 0 > "$tmp/paq-sig.rc"; : > "$plog"
  mv "$ph/paquete/SHA256SUMS" "$tmp/sums.bak"
  out_paq="$( (PATH="$tshim:$minpaq"; APS_HOME="$ph"; FAIL=0; check_paquete; echo "FAIL=$FAIL") )"
  check "paquete: a package without its SUMS+signature reds naming the re-download command" \
    'case "$out_paq" in *"✗ el paquete guardado no trae su suma y su firma ($ph/paquete)"*"curl -fsSL https://github.com/APS-Conecta/instalador/releases/download/v9.9.9/apsconecta-v9.9.9-install.sh | sudo bash"*"FAIL=1"*) ;; *) false;; esac'
  mv "$tmp/sums.bak" "$ph/paquete/SHA256SUMS"
  mv "$ROOT/installer.pub" "$tmp/pub.bak"
  out_paq="$( (PATH="$tshim:$minpaq"; APS_HOME="$ph"; FAIL=0; check_paquete; echo "FAIL=$FAIL") )"
  check "paquete: a bundle without installer.pub reds naming the missing key" \
    'case "$out_paq" in *"✗ falta la clave pública del canal firmado ($ROOT/installer.pub)"*"sudo aps-conecta descargar"*"FAIL=1"*) ;; *) false;; esac'
  mv "$tmp/pub.bak" "$ROOT/installer.pub"
  printf '%s  apsconecta-v8.8.8.tar.gz\n' "$(sha256sum "$ph/paquete/apsconecta-v9.9.9.tar.gz" | cut -d' ' -f1)" > "$ph/paquete/SHA256SUMS"
  out_paq="$( (PATH="$tshim:$minpaq"; APS_HOME="$ph"; FAIL=0; check_paquete; echo "FAIL=$FAIL") )"
  check "paquete: a SUMS naming another tag reds — the tag binds through the signed bytes" \
    'case "$out_paq" in *"✗ SHA256SUMS no nombra el paquete de la versión v9.9.9 (apsconecta-v9.9.9.tar.gz)"*"FAIL=1"*) ;; *) false;; esac && ! grep -q "^cwd=" "$plog"'
  printf '%s  apsconecta-v9.9.9.tar.gz\n' "$(sha256sum "$ph/paquete/apsconecta-v9.9.9.tar.gz" | cut -d' ' -f1)" > "$ph/paquete/SHA256SUMS"
  echo 1 > "$tmp/paq-sig.rc"
  out_paq="$( (PATH="$tshim:$minpaq"; APS_HOME="$ph"; FAIL=0; check_paquete; echo "FAIL=$FAIL") )"
  check "paquete: a signature that does not verify reds with the re-download remedy" \
    'case "$out_paq" in *"✗ la firma del paquete no verifica contra la clave pública de la suite"*"re-descargue el instalador"*"FAIL=1"*) ;; *) false;; esac'
  echo 0 > "$tmp/paq-sig.rc"
  printf 'x' >> "$ph/paquete/apsconecta-v9.9.9.tar.gz"
  out_paq="$( (PATH="$tshim:$minpaq"; APS_HOME="$ph"; FAIL=0; check_paquete; echo "FAIL=$FAIL") )"
  check "paquete: bytes that drifted after the download red at the real sha256sum -c" \
    'case "$out_paq" in *"✗ el paquete guardado no coincide con su suma verificada"*"FAIL=1"*) ;; *) false;; esac'
  truncate -s -1 "$ph/paquete/apsconecta-v9.9.9.tar.gz"
  printf 'v8.8.8\n' > "$ROOT/VERSION"
  out_paq="$( (PATH="$tshim:$minpaq"; APS_HOME="$ph"; FAIL=0; check_paquete v9.9.9; echo "FAIL=$FAIL") )"
  check "paquete: a kept package of another tag than the installed suite reds naming the deliberate update" \
    'case "$out_paq" in *"✗ el paquete guardado es de la versión v9.9.9 y la suite instalada es v8.8.8"*"una actualización es deliberada"*"FAIL=1"*) ;; *) false;; esac'
  printf 'v9.9.9\n' > "$ROOT/VERSION"
  : > "$plog"
  out_paq="$( (PATH="$tshim:$minpaq"; APS_HOME="$ph"; FAIL=0; check_paquete; echo "FAIL=$FAIL") )"
  check "paquete: the green — the signature (exact argv, cwd at the package, the committed pubkey's own line) then the real sha, and the ok line says both" \
    '[ "$out_paq" = "✓ Paquete v9.9.9 verificado: la suma y la firma (signify) contra la clave pública de la suite
FAIL=0" ] \
     && grep -q "^cwd=$ph/paquete -V -p $ROOT/installer.pub -m SHA256SUMS -x SHA256SUMS.minisig$" "$plog" \
     && grep -q "^pub2=RWQf6LgoAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA$" "$plog"'
  out_paq="$( (PATH="$tshim:$minpaq" APS_HOME="$ph" cmd_preflight) 2>&1)"; rc_paq=$?
  check "preflight: the kept package's verification rides the sweep — green line present, reds elsewhere change nothing about it" \
    '[ "$rc_paq" -ne 0 ] && case "$out_paq" in *"✓ Paquete v9.9.9 verificado: la suma y la firma (signify) contra la clave pública de la suite"*) ;; *) false;; esac'
  out_paq="$( ( PATH="$tshim:$minpaq" APS_HOME="$ph" BIN_DIR="$tmp/paq-bin" \
                 FAIL=0 step_descargar; echo "FAIL=$FAIL" ) 2>&1 )"
  check "descargar: the kept package's verification rides the step's tail — after the bundle's own green line, the channel's sum and signature" \
    'case "$out_paq" in *"✓ Suite v9.9.9 (ninguna aplicación viene dentro del paquete)"*"✓ Paquete v9.9.9 verificado: la suma y la firma (signify) contra la clave pública de la suite"*"FAIL=0"*) ;; *) false;; esac'
  rm -f "$tshim/signify"   # the block-end cleanup (the locked lifecycle: answerable until here)

  # ── the units parse (systemd-analyze verify, offline) ──
  if command -v systemd-analyze >/dev/null 2>&1; then
    u="$(systemd-analyze verify "$HOST_DIR/aps-conecta.service" "$HOST_DIR/aps-conecta.timer" 2>&1 || true)"
    # the executable-path complaint is this box's expected state (no symlink on a dev
    # box — INSTALLER.md owns the wiring); any OTHER output is a unit defect
    leftovers="$(printf '%s' "$u" | grep -v 'aps-conecta' || true)"
    check "units: systemd-analyze leaves only the unwired ExecStart path (INSTALLER.md owns the symlink; no syntax errors, no unknown directives)" \
      'case "$u" in *"Failed to parse"*|*"Unknown"*|*"Invalid"*) false;; *) true;; esac && [ -z "$leftovers" ]'
  fi

  ROOT="$ROOT_BAK"
  rm -rf "$tmp"
  echo
  echo "self-test: $n checks OK"
  [ "$FAILED" -eq 0 ] || { echo "self-test: $FAILED FAILED" >&2; exit 1; }
  return 0
}

# ── dispatch ──────────────────────────────────────────────────────────────────────────────

case "${1:-}" in
  install)      shift; cmd_install "$@" ;;
  preflight)    shift; cmd_preflight "$@" ;;
  run-command)  run_command "${2:-}" ;;
  provision)    shift; cmd_provision "${1:-}" ;;
  asistente-aio) shift; cmd_aio_wizard "$@" ;;
  temporizadores) FAIL=0; install_timers; [ "$FAIL" -eq 0 ] || exit 1 ;;
  estado)       cmd_estado ;;
  pasos)        cmd_pasos ;;
  revalidate)   cmd_revalidate ;;
  red)          shift; cmd_red "$@" ;;
  respaldo)     cmd_respaldo ;;
  datos)        shift; cmd_datos "$@" ;;
  --self-test)  selftest ;;
  ""|-h|--help) usage ;;
  *)            # a step answers by its registry id — the list is the only place a step is named
                if step="$(step_number "$1")"; then
                  if [ "$(step_field "$step" 3)" = servidor ]; then
                    step_run "$step" "aps-conecta $1" || exit 1
                  else
                    step_browser "$step"
                  fi
                else
                  usage; echo; echo "✗ subcomando desconocido: $1" >&2; exit 2
                fi ;;
esac
