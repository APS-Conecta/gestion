EOF
  chmod +x "$tshim/docker"
  # CI's runner is uid 1001 and this box runs as root: both worlds must answer the arms, so
  # every arm fakes the id the install arms' way — a function, hash-proof — instead of hoping
  # the runner's own uid happens to be root.
  act46() {  # [--revisar] — cmd_actualizar with the arm's whole world; the caller's $( ) scopes it
    ROOT="$act/repo" APS_HOME="$act/home" APS_APPS_LOCK="${ACT_LOCK:-$act/home/apps.lock.json}" \
      AIO_STATE="$act/aio" AIO_URL="https://127.0.0.1:9999" AIO_POLL="0.05" ACT46="$act" \
