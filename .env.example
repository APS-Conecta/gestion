# APS Conecta Gestión — local dev environment.
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored — NEVER commit real secrets (NFR-2 / AD-3).
#
# NOTE: Docker Compose interpolates '$' in values. If a password contains '$',
#       double it as '$$' (e.g. p@ss$$w0rd), or choose a value without '$'.

# Host port Nextcloud is published on (loopback only) → http://localhost:${HTTP_PORT}
# Uncommon default to avoid collisions; change if it's taken on your machine.
HTTP_PORT=8180

# Nextcloud admin account (created automatically on first boot)
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me-in-your-env

# Space-separated trusted domains. `nextcloud` (the compose service name) is trusted so the
# office document server can reach Nextcloud over the compose network (Story 0.2 StorageUrl).
# QUOTED on purpose: provisioning/seed.sh sources this file with `.`, so an unquoted space would
# make the shell run `nextcloud` as a command and silently drop half the value. Compose
# strips the quotes, so both readers get the whole string.
NEXTCLOUD_TRUSTED_DOMAINS="localhost nextcloud"

# PostgreSQL (owned by the db service; not published to the host)
POSTGRES_DB=apsconecta
POSTGRES_USER=apsconecta
POSTGRES_PASSWORD=change-me-in-your-env

# ── Office suite (Story 0.2) — Euro-Office backend (AD-5) ──
# Host port the browser uses to reach the office server (loopback).
OFFICE_PORT=9980

# Where the BROWSER reaches the office server. Unset = http://localhost:${OFFICE_PORT}/, right for
# every posture this repo ships. Set it only when something proxies that port outward (#75 owns TLS).
#
# THE BROWSER, not this machine — and the distinction only bites once somebody opens the suite from
# a laptop instead of from the box. `localhost:9980` then means the LAPTOP's loopback, where nothing
# is listening, so the editor never loads. It surfaces as a **token / security** complaint rather
# than a connection error, because that is the first thing the editor reports when it cannot come
# up, which sends you looking at OFFICE_JWT_SECRET — where nothing is wrong. Check this value first:
# the two secrets matching (connector `jwt_secret` == documentserver `JWT_SECRET`) rules the token
# out in one command.
#
# Two rules when you do set it:
#   - It must be reachable FROM THE BROWSER. The other two URLs are container-to-container and stay
#     service names (`http://eurooffice/`, `http://nextcloud/`) — see 14-office.sh and AD-8.
#   - It must be **https** if Nextcloud is served over https, or the browser blocks the editor as
#     mixed content and the page stays blank with only a console entry to show for it.
#
# `make office-smoke` cannot catch either mistake: it runs ON this box, where `localhost:9980`
# resolves and answers 200. A green office gate says the server is healthy, never that a remote
# person can open a document. See B-019 in BUGS.md.
#OFFICE_PUBLIC_URL=http://office.example:9980/

# Shared JWT secret for Euro-Office (documentserver JWT_SECRET ↔ eurooffice connector jwt_secret).
# MUST be ≥32 chars. Generate: openssl rand -hex 32
OFFICE_JWT_SECRET=change-me-to-a-32-plus-char-hex-secret


# ── Provisioning fixtures (Story 0.6) — synthetic dev data only ──
# Password for the synthetic sample users seeded by `make seed` (phase 50-users). Dev-only;
# these are throwaway fixture accounts on a local instance — never real credentials.
FIXTURE_USER_PASSWORD=change-me-fixture-pass

# Which clinic under sites/ this stack provisions. Write it first with scripts/deis.py.
#SITE=mi-cesfam
TILES_PORT=8084
# Where staff browsers reach the basemap archive. Loopback default works for a developer only.
TILES_PUBLIC_URL=

# The Nextcloud container occ/exec target (provisioning/scripts env.sh seam). The default in
# env.sh is the AIO container name; a compose stack — like this one, whose compose.yaml pins
# `apsconecta-gestion-nextcloud-1` — must set it or every env-wrapped occ/divergence call is
# blind while the stack is healthy (B-025, found on the box that had forgotten it).
NC_CONTAINER=apsconecta-gestion-nextcloud-1
