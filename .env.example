# APS Conecta Gestión — local dev environment.
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored — NEVER commit real secrets (NFR-2 / AD-3).

# Host port Nextcloud is published on → http://localhost:${HTTP_PORT}
HTTP_PORT=8080

# Nextcloud admin account (created automatically on first boot)
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me-in-your-env

# Space-separated trusted domains
NEXTCLOUD_TRUSTED_DOMAINS=localhost

# PostgreSQL (owned by the db service; not published to the host)
POSTGRES_DB=apsconecta
POSTGRES_USER=apsconecta
POSTGRES_PASSWORD=change-me-in-your-env
