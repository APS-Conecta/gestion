#
# APS Conecta Gestión — the env template. scripts/env-init.sh copies it to .env and generates the
# four secrets; scripts/env.sh's require_real_secrets refuses any `change-me` value this file ships.
# .env is gitignored — NEVER commit real secrets.
#
# NOTE: scripts/env.sh undoes a '$$' escape. If a password contains '$', double it as '$$', or
#       choose a value without '$' (env-init.sh generates hex).

# Host port Nextcloud is published on (loopback only) → http://localhost:${HTTP_PORT}
HTTP_PORT=8180

# Nextcloud admin account
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me-in-your-env

# Space-separated trusted domains. QUOTED on purpose: provisioning/seed.sh sources this file through
# scripts/env.sh, so an unquoted space would run the second word as a command and drop half the value.
NEXTCLOUD_TRUSTED_DOMAINS="localhost nextcloud"

# PostgreSQL
POSTGRES_DB=apsconecta
POSTGRES_USER=apsconecta
POSTGRES_PASSWORD=change-me-in-your-env

# ── Office suite — Euro-Office ──
# Host port the browser uses to reach the office server (loopback).
OFFICE_PORT=9980

# Where the BROWSER reaches the office server. Set it only when something proxies that port outward.
# It must be reachable from the browser, not only from this machine, and it must be https when
# Nextcloud is served over https (otherwise the browser blocks the editor as mixed content).
# A browser that cannot reach it reports a token/security error, not a connection error: check
# this value before OFFICE_JWT_SECRET.
#OFFICE_PUBLIC_URL=http://office.example:9980/

# Shared JWT secret for Euro-Office (documentserver JWT_SECRET ↔ eurooffice connector jwt_secret).
# MUST be ≥32 chars. Generate: openssl rand -hex 32
OFFICE_JWT_SECRET=change-me-to-a-32-plus-char-hex-secret

# ── Provisioning fixtures — synthetic data only ──
# Password for the synthetic sample users seeded by phase 50-users. Never a real credential.
FIXTURE_USER_PASSWORD=change-me-fixture-pass

# Which establishment under sites/ this install provisions. Write it first with scripts/deis.py.
#SITE=mi-cesfam
